{
	"VSCode Extensions": {
		"scope": "jsonc",
		"isFileTemplate": true,
		"include": "**/.vscode/extensions.json",
		"description": ".vscode/extensions.json: recommended extensions",
		"body": [
			"{",
			"  \"recommendations\": [",
			"    \"antfu.iconify\",",
			"    \"anthropic.claude-code\",",
			"    \"bradlc.vscode-tailwindcss\",",
			"    \"christian-kohler.path-intellisense\",",
			"    \"ckolkman.vscode-postgres\",",
			"    \"dbaeumer.vscode-eslint\",",
			"    \"editorconfig.editorconfig\",",
			"    \"esbenp.prettier-vscode\",",
			"    \"formulahendry.auto-rename-tag\",",
			"    \"github.vscode-github-actions\",",
			"    \"svelte.svelte-vscode\",",
			"    \"tamasfe.even-better-toml\",",
			"    \"usernamehw.errorlens\",",
			"  ],",
			"}",
			""
		],
		"prefix": "vscode::extensions.json"
	},
	"VSCode Launch": {
		"scope": "jsonc",
		"isFileTemplate": true,
		"include": "**/.vscode/launch.json",
		"description": ".vscode/launch.json: debug configurations",
		"body": [
			"{",
			"  // Use IntelliSense to learn about possible attributes.",
			"  // Hover to view descriptions of existing attributes.",
			"  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387",
			"  \"version\": \"0.2.0\",",
			"  \"configurations\": [",
			"    {",
			"      \"name\": \"SvelteKit: Server (vite dev)\",",
			"      \"type\": \"node-terminal\",",
			"      \"request\": \"launch\",",
			"      \"command\": \"pnpm exec vite dev --logLevel info\",",
			"      \"cwd\": \"\\${workspaceFolder}\",",
			"      \"serverReadyAction\": {",
			"        \"pattern\": \"Local:\\\\s+(https?://\\\\S+)\",",
			"        \"uriFormat\": \"%s\",",
			"        \"action\": \"debugWithChrome\",",
			"        \"webRoot\": \"\\${workspaceFolder}\",",
			"      },",
			"    },",
			"    {",
			"      \"name\": \"SvelteKit: SSR Debug (Node)\",",
			"      \"type\": \"node\",",
			"      \"request\": \"launch\",",
			"      \"runtimeExecutable\": \"pnpm\",",
			"      \"runtimeArgs\": [\"exec\", \"vite\", \"dev\", \"--logLevel\", \"info\"],",
			"      \"cwd\": \"\\${workspaceFolder}\",",
			"      \"console\": \"integratedTerminal\",",
			"      \"autoAttachChildProcesses\": true,",
			"      \"skipFiles\": [\"<node_internals>/**\", \"**/node_modules/**\"],",
			"      \"sourceMaps\": true,",
			"      \"resolveSourceMapLocations\": [",
			"        \"\\${workspaceFolder}/**\",",
			"        \"!**/node_modules/**\",",
			"      ],",
			"      \"serverReadyAction\": {",
			"        \"pattern\": \"Local:\\\\s+(https?://\\\\S+)\",",
			"        \"uriFormat\": \"%s\",",
			"        \"action\": \"debugWithChrome\",",
			"        \"webRoot\": \"\\${workspaceFolder}\",",
			"      },",
			"    },",
			"    {",
			"      \"name\": \"SvelteKit: Browser Only (Chrome attach)\",",
			"      \"type\": \"chrome\",",
			"      \"request\": \"launch\",",
			"      \"url\": \"http://localhost:5173\",",
			"      \"webRoot\": \"\\${workspaceFolder}\",",
			"      \"sourceMaps\": true,",
			"      \"sourceMapPathOverrides\": {",
			"        \"/@fs/*\": \"*\",",
			"      },",
			"    },",
			"  ],",
			"}",
			""
		],
		"prefix": "vscode::launch.json"
	},
	"VSCode Settings": {
		"scope": "jsonc",
		"isFileTemplate": true,
		"include": "**/.vscode/settings.json",
		"description": ".vscode/settings.json: workspace settings",
		"body": [
			"// Place your settings in this file to overwrite default and user settings.",
			"{",
			"  // Exclude files from the explorer view",
			"  \"files.exclude\": {",
			"    \"**/.DS_Store\": true,",
			"    \"**/.git\": true,",
			"    \"**/*.js.map\": true,",
			"    \"node_modules\": true,",
			"    \"pnpm-lock.yaml\": true,",
			"    \".eslintcache\": true,",
			"    \".svelte-kit\": true,",
			"    \"build\": true,",
			"    \".output\": true,",
			"    \".cloudflare\": true,",
			"    \".wrangler\": true,",
			"    \"src/cf-worker.d.ts\": true,",
			"  },",
			"",
			"  // Enable file nesting in the explorer",
			"  \"explorer.fileNesting.enabled\": true,",
			"  \"explorer.fileNesting.expand\": false,",
			"  \"explorer.fileNesting.patterns\": {",
			"    \".gitignore\": \"*ignore\",",
			"    \".env\": \".env.*\",",
			"    \"package.json\": \".node-*, pnpm*, .*.json, *rc, *.config.js, *.config.ts, *config.json\",",
			"    \"README.md\": \"LICENSE, CONTRIBUTING*, SECURITY*, CODE_OF_CONDUCT*, CHANGELOG*\",",
			"  },",
			"",
			"  // Tailwind CSS settings",
			"  \"files.associations\": {",
			"    \"*.css\": \"tailwindcss\",",
			"  },",
			"  \"tailwindCSS.experimental.classRegex\": [[\"clsx\\\\(([^)]*)\\\\)\", \"'([^']*)'\"]],",
			"",
			"  // Editor settings",
			"  \"editor.codeActionsOnSave\": {",
			"    \"source.fixAll.eslint\": \"explicit\",",
			"    \"source.organizeImports\": \"explicit\",",
			"  },",
			"  \"editor.quickSuggestions\": {",
			"    \"strings\": \"on\",",
			"  },",
			"  \"editor.defaultFormatter\": \"esbenp.prettier-vscode\",",
			"  \"editor.foldingStrategy\": \"indentation\",",
			"  \"editor.formatOnSave\": true,",
			"  \"editor.formatOnPaste\": false,",
			"",
			"  // JavaScript & TypeScript settings",
			"  \"js/ts.tsdk.path\": \"./node_modules/typescript/lib\",",
			"  \"js/ts.updateImportsOnFileMove.enabled\": \"always\",",
			"  \"js/ts.preferences.preferTypeOnlyAutoImports\": true,",
			"  \"js/ts.preferences.importModuleSpecifier\": \"non-relative\",",
			"  \"js/ts.suggest.autoImports\": true,",
			"  \"js/ts.preferences.includePackageJsonAutoImports\": \"on\",",
			"  \"js/ts.inlayHints.parameterNames.enabled\": \"all\",",
			"",
			"  // Svelte settings",
			"  \"svelte.enable-ts-plugin\": true,",
			"  \"svelte.plugin.svelte.runesLegacyModeCodeLens.enable\": false,",
			"  \"[svelte]\": {",
			"    \"editor.defaultFormatter\": \"svelte.svelte-vscode\",",
			"  },",
			"",
			"  // ESLint settings",
			"  \"eslint.validate\": [\"javascript\", \"typescript\", \"svelte\"],",
			"}",
			""
		],
		"prefix": "vscode::settings.json"
	},
	"VSCode Tasks": {
		"scope": "jsonc",
		"isFileTemplate": true,
		"include": "**/.vscode/tasks.json",
		"description": ".vscode/tasks.json: workspace tasks",
		"body": [
			"{",
			"  // See https://go.microsoft.com/fwlink/?LinkId=733558",
			"  // for the documentation about the tasks.json format",
			"  \"version\": \"2.0.0\",",
			"  \"tasks\": [",
			"    {",
			"      \"label\": \"build\",",
			"      \"type\": \"shell\",",
			"      \"command\": \"pnpm\",",
			"      \"args\": [\"build\"],",
			"      \"group\": {",
			"        \"kind\": \"build\",",
			"        \"isDefault\": true,",
			"      },",
			"      \"presentation\": { \"panel\": \"dedicated\", \"clear\": true },",
			"      \"problemMatcher\": [],",
			"    },",
			"    {",
			"      \"label\": \"dev\",",
			"      \"type\": \"shell\",",
			"      \"command\": \"pnpm\",",
			"      \"args\": [\"dev\"],",
			"      \"isBackground\": true,",
			"      \"presentation\": { \"panel\": \"dedicated\", \"reveal\": \"always\" },",
			"      \"problemMatcher\": {",
			"        \"owner\": \"vite\",",
			"        \"fileLocation\": [\"relative\", \"\\${workspaceFolder}\"],",
			"        \"pattern\": {",
			"          \"regexp\": \"^(.+?):(\\\\d+):(\\\\d+):\\\\s+(error|warning)\\\\s+(.*)\\$\",",
			"          \"file\": 1,",
			"          \"line\": 2,",
			"          \"column\": 3,",
			"          \"severity\": 4,",
			"          \"message\": 5,",
			"        },",
			"        \"background\": {",
			"          \"activeOnStart\": true,",
			"          \"beginsPattern\": \".*VITE.*\",",
			"          \"endsPattern\": \"(Local|Network):.*\",",
			"        },",
			"      },",
			"    },",
			"    {",
			"      \"label\": \"check\",",
			"      \"type\": \"shell\",",
			"      \"command\": \"pnpm\",",
			"      \"args\": [\"check\"],",
			"      \"group\": { \"kind\": \"test\", \"isDefault\": true },",
			"      \"presentation\": { \"panel\": \"dedicated\" },",
			"      \"problemMatcher\": [\"\\$tsc\"],",
			"    },",
			"    {",
			"      \"label\": \"lint\",",
			"      \"type\": \"shell\",",
			"      \"command\": \"pnpm\",",
			"      \"args\": [\"lint\"],",
			"      \"presentation\": { \"panel\": \"dedicated\" },",
			"      \"problemMatcher\": [\"\\$eslint-stylish\"],",
			"    },",
			"  ],",
			"}",
			""
		],
		"prefix": "vscode::tasks.json"
	}
}

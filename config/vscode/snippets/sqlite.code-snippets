	"SQLite Seed": {
		"scope": "typescript",
		"prefix": "sqlite::seed",
		"include": "**/lib/server/db/seed.ts",
		"isFileTemplate": true,
		"description": "Seed script at src/lib/server/db/seed.ts (SQLite, local D1): fills empty tables in ./schema with values guessed from column names and types, foreign keys pointing at existing rows; runs after every push (D1: migrate) via postdb:push; `pnpm db:seed [--reset] [--count 50]`",
		"body": [
			"import { existsSync, readdirSync } from 'node:fs';",
			"import { DatabaseSync } from 'node:sqlite';",
			"import { parseArgs } from 'node:util';",
			"import { getTableColumns, getTableName, is } from 'drizzle-orm';",
			"import type { Column } from 'drizzle-orm';",
			"import { getTableConfig, SQLiteTable } from 'drizzle-orm/sqlite-core';",
			"import { drizzle } from 'drizzle-orm/sqlite-proxy';",
			"import { reset, seed } from 'drizzle-seed';",
			"import { z } from 'zod';",
			"import * as schema from './schema';",
			"",
			"// TODO: run `pnpm add -D drizzle-seed tsx` if missing",
			"// TODO: run `pnpm pkg set 'scripts[\"db:seed\"]=tsx --env-file-if-exists=.env $RELATIVE_FILEPATH' 'scripts[\"postdb:push\"]=pnpm db:seed'` to seed after every push; D1 has no push: use postdb:migrate",
			"",
			"// The local SQLite file: DATABASE_URL (local.db, file:local.db) or, in D1 projects, wrangler's local D1",
			"const d1 = '.wrangler/state/v3/d1/miniflare-D1DatabaseObject';",
			"const d1Files = existsSync(d1)",
			"\t? readdirSync(d1).filter((name) => name.endsWith('.sqlite') && name !== 'metadata.sqlite')",
			"\t: [];",
			"const file =",
			"\tprocess.env.DATABASE_URL?.replace(/^file:/, '') ??",
			"\t(d1Files.length === 1 ? `\\${d1}/\\${d1Files[0]}` : '');",
			"// Seeding is for local data only; skipping keeps push and migrate from failing elsewhere",
			"if (!file || /^\\w+:/.test(file) || !existsSync(file)) {",
			"\tconsole.warn('Skipped seeding: no local SQLite database (DATABASE_URL or one local D1)');",
			"\tprocess.exit();",
			"}",
			"",
			"// `pnpm db:seed` fills empty tables only; `--reset` refills every table, `--count 50` sets rows per table",
			"const { values: args } = parseArgs({",
			"\toptions: { reset: { type: 'boolean' }, count: { type: 'string', default: '10' } }",
			"});",
			"const count = z.coerce.number().int().positive().parse(args.count);",
			"// better-auth fills these itself, so they stay empty",
			"const skip = new Set(['session', 'account', 'verification']);",
			"const sqlite = new DatabaseSync(file);",
			"// node:sqlite through drizzle's proxy driver, so there is no driver to install",
			"const db = drizzle(async (query, params, method) => {",
			"\tconst statement = sqlite.prepare(query);",
			"\tif (method === 'run') return { rows: [statement.run(...params)] };",
			"\tconst rows = statement.all(...params).map((row) => Object.values(row));",
			"\treturn { rows: method === 'get' ? rows[0] : rows };",
			"});",
			"",
			"if (args.reset) await reset(db, schema);",
			"const empty: [string, SQLiteTable][] = [];",
			"for (const [name, table] of Object.entries(schema))",
			"\tif (is(table, SQLiteTable) && !skip.has(name) && (await db.\\$count(table)) === 0)",
			"\t\tempty.push([name, table]);",
			"",
			"// Foreign keys into tables that keep their rows pick from those rows; a unique one caps the row count.",
			"// A unique one into a table seeded too makes a one-to-one: one child row per parent row",
			"const existing = new Map<Column, (string | number)[]>();",
			"const counts = new Map<string, number>();",
			"const oneToOne = new Map<string, string[]>();",
			"for (const [name, table] of empty)",
			"\tfor (const fk of getTableConfig(table).foreignKeys) {",
			"\t\tconst { columns, foreignColumns, foreignTable } = fk.reference();",
			"\t\tconst parent = empty.find(([, t]) => t === foreignTable)?.[0];",
			"\t\tif (parent && columns[0].isUnique && parent !== name)",
			"\t\t\toneToOne.set(parent, [...(oneToOne.get(parent) ?? []), name]);",
			"\t\tif (parent) continue;",
			"\t\tconst rows = await db.select({ value: foreignColumns[0] }).from(foreignTable);",
			"\t\tconst ids = rows.flatMap(({ value }) =>",
			"\t\t\ttypeof value === 'string' || typeof value === 'number' ? [value] : []",
			"\t\t);",
			"\t\texisting.set(columns[0], ids);",
			"\t\tif (columns[0].isUnique) counts.set(name, Math.min(counts.get(name) ?? count, ids.length));",
			"\t}",

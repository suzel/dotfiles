    "description": "Seed script at src/lib/server/db/seed.ts (Postgres): fills empty tables in ./schema with values guessed from column names and types, foreign keys pointing at existing rows; runs after every push via postdb:push; `pnpm db:seed [--reset] [--count 50]`",
    "body": [
      "import { parseArgs } from 'node:util';",
      "import { getTableColumns, getTableName, is } from 'drizzle-orm';",
      "import type { Column } from 'drizzle-orm';",
      "import { getTableConfig, PgTable } from 'drizzle-orm/pg-core';",
      "import { drizzle } from 'drizzle-orm/postgres-js';",
      "import { reset, seed } from 'drizzle-seed';",
      "import { z } from 'zod';",
      "import * as schema from './schema';",
      "",
      "// TODO: run `pnpm add -D drizzle-seed tsx` if missing",
      "// TODO: run `pnpm pkg set 'scripts[\"db:seed\"]=tsx --env-file-if-exists=.env $RELATIVE_FILEPATH' 'scripts[\"postdb:push\"]=pnpm db:seed'` to seed after every push",
      "",
      "const url = process.env.DATABASE_URL ?? '';",
      "// Seeding is for local data only; skipping keeps push from failing against other databases",
      "if (!/@(localhost|127\\.0\\.0\\.1)[:/]/.test(url)) {",
      "\tconsole.warn('Skipped seeding: DATABASE_URL is not a local database');",
      "\tprocess.exit();",
      "}",
      "",
      "// `pnpm db:seed` fills empty tables only; `--reset` refills every table, `--count 50` sets rows per table",
      "const { values: args } = parseArgs({",
      "\toptions: { reset: { type: 'boolean' }, count: { type: 'string', default: '10' } }",
      "});",
      "const count = z.coerce.number().int().positive().parse(args.count);",
      "// better-auth fills these itself, so they stay empty",
      "const skip = new Set(['session', 'account', 'verification']);",
      "const db = drizzle(url);",
      "",
      "if (args.reset) await reset(db, schema);",
      "const empty: [string, PgTable][] = [];",
      "for (const [name, table] of Object.entries(schema))",
      "\tif (is(table, PgTable) && !skip.has(name) && (await db.\\$count(table)) === 0)",
      "\t\tempty.push([name, table]);",
      "",
      "// Foreign keys into tables that keep their rows pick from those rows; a unique one caps the row count.",
      "// A unique one into a table seeded too makes a one-to-one: one child row per parent row",
      "const existing = new Map<Column, (string | number)[]>();",
      "const counts = new Map<string, number>();",
      "const oneToOne = new Map<string, string[]>();",
      "for (const [name, table] of empty)",
      "\tfor (const fk of getTableConfig(table).foreignKeys) {",
      "\t\tconst { columns, foreignColumns, foreignTable } = fk.reference();",
      "\t\tconst parent = empty.find(([, t]) => t === foreignTable)?.[0];",
      "\t\tif (parent && columns[0].isUnique && parent !== name)",
      "\t\t\toneToOne.set(parent, [...(oneToOne.get(parent) ?? []), name]);",
      "\t\tif (parent) continue;",
      "\t\tconst rows = await db.select({ value: foreignColumns[0] }).from(foreignTable);",
      "\t\tconst ids = rows.flatMap(({ value }) =>",
      "\t\t\ttypeof value === 'string' || typeof value === 'number' ? [value] : []",
      "\t\t);",
      "\t\texisting.set(columns[0], ids);",
      "\t\tif (columns[0].isUnique) counts.set(name, Math.min(counts.get(name) ?? count, ids.length));",
      "\t}",
      "",
      "const seeding = seed(db, Object.fromEntries(empty), { count });",
      "type Funcs = Parameters<Parameters<typeof seeding.refine>[0]>[0];",
      "type Generator = ReturnType<Funcs[keyof Funcs]>;",
      "type Schema = typeof schema;",
      "type Table = { [K in keyof Schema]: Schema[K] extends PgTable ? K : never }[keyof Schema];",
      "// drizzle-seed's own type turns into {} when the schema also exports zod schemas",
      "type Refinements = {",
      "\t[T in Table]?: {",
      "\t\tcount?: number;",
      "\t\tcolumns?: { [C in keyof Schema[T]['_']['columns']]?: Generator };",
      "\t\twith?: { [Child in Table]?: number | { weight: number; count: number | number[] }[] };",
      "\t};",
      "};",
      "",
      "if (empty.length) {",
      "\tawait seeding.refine((f) =>",
      "\t\twithGuesses(f, {",
      "\t\t\t// Optional, per seeded table: { count, columns: { column: f.generator() }, with: { child: n } }",
      "\t\t\t$0",
      "\t\t})",
      "\t);",
      "\tconst seeded = empty.map(",
      "\t\tasync ([, table]) => `\\${getTableName(table)} (\\${await db.\\$count(table)})`",
      "\t);",
      "\tconsole.log(`Seeded \\${(await Promise.all(seeded)).join(', ')}`);",
      "} else console.log('No empty tables to seed');",
      "await db.\\$client.end();",
      "",
      "// Guessed generators for each empty table; overrides win, other columns keep drizzle-seed's defaults",
      "function withGuesses(f: Funcs, overrides: Refinements) {",
      "\tconst names = new Set(empty.map(([name]) => name));",
      "\tconst entries = empty.map(([name, table]) => {",
      "\t\tconst own = Object.hasOwn(overrides, name) ? overrides[name as Table] : undefined;",
      "\t\t// with only works when the child table is seeded too",
      "\t\tconst children = [",
      "\t\t\t...(oneToOne.get(name) ?? []).map((child) => [child, 1] as const),",
      "\t\t\t...Object.entries(own?.with ?? {}).filter(([child]) => names.has(child))",
      "\t\t];",
      "\t\treturn [",
      "\t\t\tname,",
      "\t\t\t{",
      "\t\t\t\tcount: own?.count ?? counts.get(name),",
      "\t\t\t\tcolumns: { ...guesses(f, table), ...own?.columns },",
      "\t\t\t\twith: children.length ? Object.fromEntries(children) : undefined",
      "\t\t\t}",
      "\t\t] as const;",
      "\t});",
      "\treturn Object.fromEntries(entries);",
      "}",
      "",
      "// A generator for each column guess knows; foreign keys into kept tables use their rows",
      "function guesses(f: Funcs, table: PgTable) {",
      "\tconst foreignKeys = getTableConfig(table).foreignKeys.flatMap((fk) => fk.reference().columns);",
      "\tconst entries = Object.entries(getTableColumns(table)).flatMap(",
      "\t\t([key, column]): [string, Generator][] => {",
      "\t\t\tconst values = existing.get(column);",
      "\t\t\tif (values) return [[key, f.valuesFromArray({ values })]];",
      "\t\t\tconst generator = foreignKeys.includes(column) ? undefined : guess(f, key, column);",
      "\t\t\treturn generator ? [[key, generator]] : [];",
      "\t\t}",
      "\t);",
      "\treturn Object.fromEntries(entries);",
      "}",
      "",
      "// Values by column name (authorEmail, price, avatarUrl...); skips keys, unique and array columns",
      "function guess(f: Funcs, key: string, column: Column): Generator | undefined {",
      "\tconst type = column.getSQLType();",
      "\tconst words = key.replace(/[A-Z]/g, ' \\$&').replace(/_/g, ' ').toLowerCase();",
      "\tif (column.primary || column.isUnique || type.endsWith(']')) return;",
      "\tif (column.enumValues?.length) return f.valuesFromArray({ values: column.enumValues });",
      "\tif (column.dataType === 'json') return f.json();",
      "\tif (key === 'deletedAt') return f.default({ defaultValue: null });",
      "\tif (/\\b(birth|birthday|dob)\\b/.test(words) && (type === 'date' || column.dataType === 'date'))",
      "\t\treturn f.date({ minDate: '1950-01-01', maxDate: '2005-12-31' });",
      "",
      "\tif (column.dataType === 'string' && /^(text|varchar|char)/.test(type)) {",
      "\t\tconst length = Number(/\\((\\d+)\\)/.exec(type)?.[1] ?? Infinity);",
      "\t\tconst images = Array.from({ length: 50 }, (_, i) => `https://picsum.photos/seed/\\${i}/640/480`);",
      "\t\t// [name pattern, longest value, generator]: skipped when the column is shorter",
      "\t\tconst rules: [RegExp, number, () => Generator][] = [",
      "\t\t\t[/\\bemail\\b/, 53, () => f.email()],",
      "\t\t\t[/\\b(phone|mobile|gsm)\\b/, 19, () => f.phoneNumber({ template: '+90 (5##) ### ## ##' })],",
      "\t\t\t[/\\bfirst name\\b/, 15, () => f.firstName()],",
      "\t\t\t[/\\b(last name|surname)\\b/, 15, () => f.lastName()],",
      "\t\t\t[/^((full|display|author|owner) )?name\\$/, 31, () => f.fullName()],",
      "\t\t\t[/\\b(company|brand)\\b/, 52, () => f.companyName()],",
      "\t\t\t[/\\b(job|occupation)\\b/, 35, () => f.jobTitle()],",
      "\t\t\t[/\\bcity\\b/, 49, () => f.city()],",
      "\t\t\t[/\\bcountry\\b/, 30, () => f.country()],",
      "\t\t\t[/\\b(address|street)\\b/, 30, () => f.streetAddress()],",
      "\t\t\t[/\\b(zip|postcode|postal code)\\b/, 10, () => f.postcode()],",
      "\t\t\t[",
      "\t\t\t\t/\\b(image|avatar|photo|logo|cover|thumbnail)\\b/,",
      "\t\t\t\t42,",
      "\t\t\t\t() => f.valuesFromArray({ values: images })",
      "\t\t\t],",
      "\t\t\t[/\\b(title|subject|headline)\\b/, 190, () => f.loremIpsum()],",
      "\t\t\t[",
      "\t\t\t\t/\\b(description|content|body|bio|summary|excerpt|note|comment|message)\\b/,",
      "\t\t\t\t572,",
      "\t\t\t\t() => f.loremIpsum({ sentencesCount: 3 })",
      "\t\t\t]",
      "\t\t];",
      "\t\treturn rules.find(([pattern, longest]) => pattern.test(words) && length >= longest)?.[2]();",
      "\t}",
      "\tif (/^(smallint|integer|bigint)\\$/.test(type) && ['number', 'bigint'].includes(column.dataType)) {",
      "\t\tconst [min, max] = /\\bage\\b/.test(words)",
      "\t\t\t? [18, 80]",
      "\t\t\t: /\\byear\\b/.test(words)",
      "\t\t\t\t? [1990, 2026]",
      "\t\t\t\t: /\\b(rating|stars)\\b/.test(words)",
      "\t\t\t\t\t? [1, 5]",
      "\t\t\t\t\t: [0, 1000];",
      "\t\treturn f.int({ minValue: min, maxValue: max });",
      "\t}",
      "\tif (/^(numeric|decimal|real|double precision)/.test(type)) {",
      "\t\tconst [, precision, scale] = (/\\((\\d+), *(\\d+)\\)/.exec(type) ?? []).map(Number);",
      "\t\tconst limit = precision ? 10 ** (precision - scale) - 10 ** -scale : Infinity;",
      "\t\tconst [min, max, step] = /\\b(lat|latitude)\\b/.test(words)",
      "\t\t\t? [-90, 90, 1e6]",
      "\t\t\t: /\\b(lng|lon|longitude)\\b/.test(words)",
      "\t\t\t\t? [-180, 180, 1e6]",
      "\t\t\t\t: /\\b(rating|score)\\b/.test(words)",
      "\t\t\t\t\t? [1, 5, 10]",
      "\t\t\t\t\t: [1, 1000, 100];",
      "\t\treturn f.number({",
      "\t\t\tminValue: Math.max(min, -limit),",
      "\t\t\tmaxValue: Math.min(max, limit),",
      "\t\t\tprecision: step",
      "\t\t});",
      "\t}",
      "}",
      "",
    ],

  "DB soft delete": {
    "scope": "typescript",
    "prefix": ["db::softdelete", "softdelete"],
    "include": ["*.remote.ts", "*.server.ts", "+server.ts", "**/lib/server/**"],
    "exclude": "**/lib/server/db/schema/**",
    "description": "Soft delete by id (sets deletedAt)",
    "body": [
      "// TODO: add isNull(${1:table}.deletedAt) to every select, count, update and delete, or deleted rows can still be listed, patched and deleted again",
      "// TODO: add deletedAt: true to ${1}InsertSchema and ${1}UpdateSchema .omit() so clients can't set it",
      "await db.update($1).set({ deletedAt: new Date() }).where(eq($1.id, ${2:id}));$0",
    ],
  },
  "Column owner": {
    "scope": "typescript",
    "prefix": ["col::owner", "owner"],
    "include": "**/lib/server/db/**",
    "description": "userId column referencing the better-auth user (row owner)",
    "body": [
      "userId: text('user_id')",
      "\t.notNull()",
      "\t.references(() => ${1:user}.id, { onDelete: 'cascade' }),$0",
    ],
  },
  "Drizzle Remote Owned CRUD": {
    "scope": "typescript",
    "prefix": "drizzle::remote-owned",
    "include": "*.remote.ts",
    "exclude": ["**/src/**/server/**", "auth.remote.ts", "admin.remote.ts"],
    "isFileTemplate": true,
    "description": "CRUD remote functions for per-user rows (only the user's own)",
    "body": [
      "import { error } from '@sveltejs/kit';",
      "import { command, form, getRequestEvent, query } from '\\$app/server';",
      "import { and, desc, eq } from 'drizzle-orm';",
      "import { z } from 'zod';",
      "import { db } from '#lib/server/db/index.ts';",
      "import { ${1:${TM_FILENAME_BASE/([^.]*).*/$1/}}, ${1}InsertSchema, ${1}UpdateSchema } from '#lib/server/db/schema/${1}.ts';",
      "",
      "// TODO: the table needs a userId column (col::owner)",
      "",
      "function requireUser() {",
      "\tconst { user } = getRequestEvent().locals;",
      "\tif (!user) error(401, 'Unauthorized');",
      "\treturn user;",
      "}",
      "",
      "// someone else's row behaves like a missing one",
      "const mine = (id: number, userId: string) => and(eq($1.id, id), eq($1.userId, userId));",
      "",
      "export const get${TM_FILENAME_BASE/([^.]*).*/${1:/pascalcase}/}s = query(async () => {",
      "\tconst user = requireUser();",
      "\treturn db.select().from($1).where(eq($1.userId, user.id)).orderBy(desc($1.createdAt));",
      "});",
      "",
      "export const get${TM_FILENAME_BASE/([^.]*).*/${1:/pascalcase}/} = query(z.number(), async (id) => {",
      "\tconst user = requireUser();",
      "\tconst [row] = await db.select().from($1).where(mine(id, user.id));",
      "\tif (!row) error(404, 'Not found');",
      "\treturn row;",
      "});",
      "",
      "export const create${TM_FILENAME_BASE/([^.]*).*/${1:/pascalcase}/} = form(${1}InsertSchema.omit({ userId: true }), async (data) => {",
      "\tconst user = requireUser();",
      "\tawait db.insert($1).values({ ...data, userId: user.id });",
      "\tvoid get${TM_FILENAME_BASE/([^.]*).*/${1:/pascalcase}/}s().refresh();",
      "});",
      "",
      "export const update${TM_FILENAME_BASE/([^.]*).*/${1:/pascalcase}/} = form(${1}UpdateSchema.omit({ userId: true }), async ({ id, ...data }) => {",
      "\tconst user = requireUser();",
      "\tawait db.update($1).set(data).where(mine(id, user.id));",
      "\tvoid get${TM_FILENAME_BASE/([^.]*).*/${1:/pascalcase}/}s().refresh();",
      "\tvoid get${TM_FILENAME_BASE/([^.]*).*/${1:/pascalcase}/}(id).refresh();",
      "});",
      "",
      "export const delete${TM_FILENAME_BASE/([^.]*).*/${1:/pascalcase}/} = command(z.number(), async (id) => {",
      "\tconst user = requireUser();",
      "\tawait db.delete($1).where(mine(id, user.id));",
      "\tvoid get${TM_FILENAME_BASE/([^.]*).*/${1:/pascalcase}/}s().refresh();",
      "});",
      "",
    ],
  },
  "Drizzle RLS": {
    "scope": "typescript",
    "prefix": "drizzle::rls",
    "include": "**/lib/server/db/rls.ts",
    "isFileTemplate": true,
    "description": "withUser(): runs queries in a transaction as app_user, so RLS policies (drizzle::policy-owned) apply",
    "body": [
      "import { sql } from 'drizzle-orm';",
      "import { db } from './index';",
      "",
      "// TODO: create the app_user role once: `pnpm db:generate --custom --name=rls`, fill it with the role and its table grants, then `pnpm db:migrate`",
      "// TODO: Neon HTTP has no db.transaction: switch to postgres-js or the neon-serverless Pool",
      "",
      "type Tx = Parameters<Parameters<typeof db.transaction>[0]>[0];",
      "",
      "// the app connects as the table owner, which RLS skips: fn's queries run as app_user instead",
      "export function withUser<T>(userId: string, fn: (tx: Tx) => Promise<T>): Promise<T> {",
      "\treturn db.transaction(async (tx) => {",
      "\t\t// true: the value ends with the transaction, so pooled connections don't keep it",
      "\t\tawait tx.execute(sql`select set_config('app.user_id', \\${userId}, true)`);",
      "\t\tawait tx.execute(sql`set local role app_user`);",
      "\t\treturn fn(tx);",
      "\t});",
      "}",
      "",
    ],
  },
  "Drizzle Policy Owned": {
    "scope": "typescript",
    "prefix": ["drizzle::policy-owned", "policy"],
    "include": "**/lib/server/db/**",
    "description": "RLS policy callback for pgTable's third argument: rows whose userId is the withUser user",
    "body": [
      "(t) => [",
      "\t// TODO: only queries inside withUser (drizzle::rls) are checked; plain db. queries see every row",
      "\t// (select …) runs once per query instead of once per row",
      "\tpgPolicy('${1:owner}', {",
      "\t\tfor: 'all',",
      "\t\tto: 'app_user',",
      "\t\tusing: sql`\\${t.${2:userId}} = (select current_setting('app.user_id', true))`,",
      "\t\twithCheck: sql`\\${t.$2} = (select current_setting('app.user_id', true))`",
      "\t})",
      "]$0",
    ],
  },
}

  "Rust Axum Main": {
    "scope": "rust",
    "prefix": "rust::axum-main",
    "isFileTemplate": true,
    "include": "main.rs",
    "description": "main.rs: axum server on Postgres with migrations and graceful shutdown; mods: rust::axum-error, rust::axum-routes",
    "body": [
      "// TODO: cargo add axum anyhow dotenvy tracing",
      "// TODO: cargo add tokio -F macros,rt-multi-thread,signal",
      "// TODO: cargo add tracing-subscriber -F env-filter",
      "// TODO: cargo add sqlx -F runtime-tokio,tls-rustls,postgres",
      "// TODO: set DATABASE_URL, ADDR and RUST_LOG in .env",
      "// TODO: mkdir migrations, add build.rs (rust::build.rs)",
      "mod error;",
      "mod routes;",
      "",
      "use std::env;",
      "",
      "use anyhow::Context;",
      "use sqlx::PgPool;",
      "use tokio::net::TcpListener;",
      "use tokio::signal::unix::{SignalKind, signal};",
      "use tracing_subscriber::EnvFilter;",
      "",
      "#[tokio::main]",
      "async fn main() -> anyhow::Result<()> {",
      "\tif let Err(e) = dotenvy::dotenv()",
      "\t\t&& !e.not_found()",
      "\t{",
      "\t\treturn Err(e).context(\"loading .env\");",
      "\t}",
      "\ttracing_subscriber::fmt()",
      "\t\t.with_env_filter(EnvFilter::from_default_env())",
      "\t\t.init();",
      "",
      "\tlet url = env::var(\"DATABASE_URL\").context(\"reading DATABASE_URL\")?;",
      "\tlet db = PgPool::connect(&url)",
      "\t\t.await",
      "\t\t.context(\"connecting to the database\")?;",
      "\tsqlx::migrate!()",
      "\t\t.run(&db)",
      "\t\t.await",
      "\t\t.context(\"running migrations\")?;",
      "",
      "\tlet addr = env::var(\"ADDR\").context(\"reading ADDR\")?;",
      "\tlet listener = TcpListener::bind(&addr)",
      "\t\t.await",
      "\t\t.with_context(|| format!(\"binding {addr}\"))?;",
      "\t// Ctrl+C sends SIGINT, docker stop SIGTERM",
      "\tlet mut int = signal(SignalKind::interrupt()).context(\"handling SIGINT\")?;",
      "\tlet mut term = signal(SignalKind::terminate()).context(\"handling SIGTERM\")?;",
      "",
      "\ttracing::info!(\"listening on {addr}\");",
      "\taxum::serve(listener, routes::router(db))",
      "\t\t.with_graceful_shutdown(async move {",
      "\t\t\ttokio::select! {",
      "\t\t\t\t_ = int.recv() => {}",
      "\t\t\t\t_ = term.recv() => {}",
      "\t\t\t}",
      "\t\t})",
      "\t\t.await",
      "\t\t.context(\"serving\")",
      "}",
      ""
    ]
  },
  "Rust Axum Error": {
    "scope": "rust",
    "prefix": "rust::axum-error",
    "isFileTemplate": true,
    "include": "error.rs",
    "description": "error.rs: axum AppError answering with a JSON error body",
    "body": [
      "// TODO: cargo add axum serde_json thiserror sqlx tracing",
      "use axum::Json;",
      "use axum::http::StatusCode;",
      "use axum::response::{IntoResponse, Response};",
      "use serde_json::json;",
      "",
      "#[derive(Debug, thiserror::Error)]",
      "pub enum AppError {",
      "\t#[error(\"Not found\")]",
      "\tNotFound,",
      "\t// The message never exposes the cause: it only goes to the log",
      "\t#[error(\"Internal server error\")]",
      "\tDatabase(#[from] sqlx::Error),",
      "\t$0",
      "}",
      "",
      "impl IntoResponse for AppError {",
      "\tfn into_response(self) -> Response {",
      "\t\tlet (status, code) = match &self {",
      "\t\t\tSelf::NotFound => (StatusCode::NOT_FOUND, \"not_found\"),",
      "\t\t\tSelf::Database(e) => {",
      "\t\t\t\ttracing::error!(\"database: {e}\");",
      "\t\t\t\t(StatusCode::INTERNAL_SERVER_ERROR, \"internal_error\")",
      "\t\t\t}",
      "\t\t};",
      "\t\tlet message = self.to_string();",
      "\t\tlet error = json!({ \"code\": code, \"message\": message, \"details\": [] });",
      "\t\t(status, Json(json!({ \"error\": error }))).into_response()",
      "\t}",
      "}",
      ""
    ]
  },
  "Rust Axum Routes": {
    "scope": "rust",
    "prefix": "rust::axum-routes",
    "isFileTemplate": true,
    "include": "routes.rs",
    "description": "routes.rs: axum router with /health, timeout, compression and trace layers, and a test; AppError: rust::axum-error",
    "body": [
      "// TODO: cargo add tower-http -F compression-full,timeout,trace",
      "// TODO: cargo add --dev tower -F util",
      "use std::time::Duration;",
      "",
      "use axum::Router;",
      "use axum::extract::State;",
      "use axum::http::StatusCode;",
      "use axum::routing::get;",
      "use sqlx::PgPool;",
      "use tower_http::compression::CompressionLayer;",
      "use tower_http::timeout::TimeoutLayer;",
      "use tower_http::trace::TraceLayer;",
      "",
      "use crate::error::AppError;",
      "",
      "pub fn router(db: PgPool) -> Router {",
      "\tlet timeout = Duration::from_secs(10);",
      "\tRouter::new()",
      "\t\t.route(\"/health\", get(health))$0",
      "\t\t.fallback(|| async { AppError::NotFound })",
      "\t\t.layer(TimeoutLayer::with_status_code(",
      "\t\t\tStatusCode::REQUEST_TIMEOUT,",
      "\t\t\ttimeout,",
      "\t\t))",
      "\t\t.layer(CompressionLayer::new())",
      "\t\t.layer(TraceLayer::new_for_http())",
      "\t\t.with_state(db)",
      "}",
      "",
      "async fn health(State(db): State<PgPool>) -> Result<StatusCode, AppError> {",
      "\tsqlx::query(\"SELECT 1\").execute(&db).await?;",
      "\tOk(StatusCode::NO_CONTENT)",
      "}",
      "",
      "#[cfg(test)]",
      "mod tests {",
      "\tuse axum::body::{Body, to_bytes};",
      "\tuse axum::http::Request;",
      "\tuse tower::ServiceExt;",
      "",
      "\tuse super::*;",
      "",
      "\t#[tokio::test]",
      "\tasync fn unknown_path_is_not_found() {",
      "\t\tlet db = PgPool::connect_lazy(\"postgres://localhost/test\").unwrap();",
      "\t\tlet req = Request::get(\"/unknown\").body(Body::empty()).unwrap();",
      "\t\tlet res = router(db).oneshot(req).await.unwrap();",
      "\t\tassert_eq!(res.status(), StatusCode::NOT_FOUND);",
      "\t\tlet body = to_bytes(res.into_body(), usize::MAX).await.unwrap();",
      "\t\tlet json: serde_json::Value = serde_json::from_slice(&body).unwrap();",
      "\t\tassert_eq!(json[\"error\"][\"code\"], \"not_found\");",
      "\t}",
      "}",
      ""
    ]
  },

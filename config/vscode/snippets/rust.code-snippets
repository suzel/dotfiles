{
  "Rust Cargo.toml": {
    "scope": "toml",
    "isFileTemplate": true,
    "include": "Cargo.toml",
    "description": "Cargo.toml: package on edition 2024 with a clippy lint for undocumented unsafe",
    "body": [
      "[package]",
      "name = \"${1:${WORKSPACE_NAME/([A-Z])|([^A-Za-z0-9_-])/${1:/downcase}${2:+-}/g}}\"",
      "version = \"0.1.0\"",
      "edition = \"2024\"",
      "",
      "[dependencies]",
      "$0",
      "",
      "[lints.clippy]",
      "undocumented_unsafe_blocks = \"warn\"",
      "",
    ],
    "prefix": "rust::Cargo.toml",
  },
  "Rust Main": {
    "scope": "rust",
    "description": "fn main returning anyhow::Result for a binary",
    "body": [
      "// TODO: cargo add anyhow",
      "use anyhow::Result;",
      "",
      "fn main() -> Result<()> {",
      "\t$0",
      "\tOk(())",
      "}",
    ],
    "prefix": "rust::main",
  },
  "Rust Error": {
    "scope": "rust",
    "description": "thiserror Error enum with a crate Result alias for a library",
    "body": [
      "// TODO: cargo add thiserror",
      "#[derive(Debug, thiserror::Error)]",
      "pub enum Error {",
      "\t#[error(\"${2:failed to read file}\")]",
      "\t${1:Io}(#[from] ${3:std::io::Error}),",
      "\t$0",
      "}",
      "",
      "pub type Result<T, E = Error> = std::result::Result<T, E>;",
    ],
    "prefix": "rust::error",
  },
  "Rust Test": {
    "scope": "rust",
    "description": "#[cfg(test)] tests module with one test function",
    "body": [
      "#[cfg(test)]",
      "mod tests {",
      "\tuse super::*;",
      "",
      "\t#[test]",
      "\tfn ${1:it_works}() {",
      "\t\t$0",
      "\t}",
      "}",
    ],
    "prefix": "rust::test",
  },
}

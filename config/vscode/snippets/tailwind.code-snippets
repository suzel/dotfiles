{
  "Design Token": {
    "scope": "tailwindcss",
    "prefix": "tw::layout.css",
    "isFileTemplate": true,
    "include": "layout.css",
    "description": "layout.css: Tailwind import, plugins and design tokens",
    "body": [
      "@import 'tailwindcss';",
      "@plugin '@tailwindcss/forms';",
      "@plugin '@tailwindcss/typography';",
      "",
      "/* Design tokens — source of truth: .claude/DESIGN.md */",
      "@theme {",
      "  --color-primary: #ff3e00;",
      "  --color-primary-hover: #e63600;",
      "  --color-ink: #0a0a0a;",
      "  --color-muted: #525252;",
      "  --color-border: #e5e5e5;",
      "  --color-surface: #ffffff;",
      "  --color-background: #fafafa;",
      "  --color-success: #16a34a;",
      "  --color-warning: #d97706;",
      "  --color-danger: #dc2626;",
      "  --font-h1: 'Inter';",
      "  --font-h2: 'Inter';",
      "  --font-body-md: 'Inter';",
      "  --font-body-sm: 'Inter';",
      "  --font-label-caps: 'Inter';",
      "  --font-mono: 'JetBrains Mono';",
      "  --text-h1: 36px;",
      "  --text-h2: 24px;",
      "  --text-body-md: 16px;",
      "  --text-body-sm: 14px;",
      "  --text-label-caps: 12px;",
      "  --text-mono: 14px;",
      "  --tracking-h1: -0.02em;",
      "  --tracking-h2: -0.01em;",
      "  --tracking-label-caps: 0.08em;",
      "  --font-weight-h1: 700;",
      "  --font-weight-h2: 600;",
      "  --font-weight-body-md: 400;",
      "  --font-weight-body-sm: 400;",
      "  --font-weight-label-caps: 500;",
      "  --font-weight-mono: 400;",
      "  --radius-sm: 4px;",
      "  --radius-md: 8px;",
      "  --radius-lg: 12px;",
      "  --radius-full: 9999px;",
      "}",
      "",
      "html {",
      "  color-scheme: light;",
      "}",
      "",
    ],
  },
  "Tailwind Header": {
    "scope": "svelte",
    "prefix": "tw::header",
    "include": "Header.svelte",
    "isFileTemplate": true,
    "description": "Site header (src/lib/components/Header.svelte): sticky, name + nav links + CTA button, popover menu on mobile, current page and its subpages marked",
    "body": [
      "<script lang=\"ts\">",
      "\timport { resolve } from '\\$app/paths';",
      "\timport { page } from '\\$app/state';",
      "",
      "\t// TODO: needs tw::theme in src/routes/layout.css (brand color)",
      "\t// TODO: src/routes/+layout.svelte: <div class=\"flex min-h-dvh flex-col\"><Header /><main class=\"mx-auto w-full max-w-5xl flex-1 px-4 py-8\">{@render children()}</main><Footer /></div>",
      "",
      "\t// pathnames without the leading slash: resolve() takes them inside route groups too",
      "\tconst links = [",
      "\t\t{ href: 'about', label: 'About' },",
      "\t\t{ href: 'contact', label: 'Contact' }",
      "\t] as const;",
      "",
      "\t// subpages count too: /about/team marks About",
      "\tconst isCurrent = (href: string) =>",
      "\t\tpage.url.pathname === `/\\${href}` || page.url.pathname.startsWith(`/\\${href}/`);",
      "</script>",
      "",
      "{#snippet navLink(link: (typeof links)[number])}",
      "\t<a",
      "\t\thref={resolve(link.href)}",
      "\t\taria-current={isCurrent(link.href) ? 'page' : undefined}",
      "\t\tonclick={(e) => e.currentTarget.closest<HTMLElement>('[popover]')?.hidePopover()}",
      "\t\tclass=\"text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white aria-[current=page]:font-semibold aria-[current=page]:text-gray-900 dark:aria-[current=page]:text-white\"",
      "\t>",
      "\t\t{link.label}",
      "\t</a>",
      "{/snippet}",
      "",
      "<header class=\"sticky top-0 z-40 border-b border-gray-200 dark:border-gray-800 bg-white/80 dark:bg-gray-900/80 backdrop-blur\">",
      "\t<nav aria-label=\"Main\" class=\"mx-auto flex max-w-5xl items-center gap-x-4 px-4 py-3 sm:gap-x-6\">",
      "\t\t<a href={resolve('/')} class=\"mr-auto text-lg font-bold\">${1:Site}</a>",
      "\t\t<div class=\"hidden gap-x-6 sm:flex\">",
      "\t\t\t{#each links as link (link.href)}",
      "\t\t\t\t{@render navLink(link)}",
      "\t\t\t{/each}",
      "\t\t</div>",
      "\t\t<a",
      "\t\t\thref={resolve('${2:signup}')}",
      "\t\t\tclass=\"rounded-lg bg-brand-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-brand-500\"",
      "\t\t>",
      "\t\t\t${3:Get started}",
      "\t\t</a>",
      "\t\t<button",
      "\t\t\ttype=\"button\"",
      "\t\t\tpopovertarget=\"main-menu\"",
      "\t\t\tclass=\"rounded-lg p-2 text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 sm:hidden\"",
      "\t\t>",
      "\t\t\t<span class=\"sr-only\">Menu</span>",
      "\t\t\t<svg",
      "\t\t\t\tclass=\"size-6\"",
      "\t\t\t\tfill=\"none\"",
      "\t\t\t\tviewBox=\"0 0 24 24\"",
      "\t\t\t\tstroke=\"currentColor\"",
      "\t\t\t\tstroke-width=\"1.5\"",
      "\t\t\t\tstroke-linecap=\"round\"",
      "\t\t\t\tstroke-linejoin=\"round\"",
      "\t\t\t\taria-hidden=\"true\"",
      "\t\t\t>",
      "\t\t\t\t<path d=\"M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5\" />",
      "\t\t\t</svg>",
      "\t\t</button>",
      "\t\t<div",
      "\t\t\tid=\"main-menu\"",
      "\t\t\tpopover",
      "\t\t\tclass=\"inset-x-4 top-18 bottom-auto w-auto flex-col gap-4 rounded-xl bg-white dark:bg-gray-900 p-4 shadow-lg ring-1 ring-gray-900/5 dark:ring-white/10 backdrop:bg-gray-900/20 open:flex sm:hidden\"",
      "\t\t>",
      "\t\t\t{#each links as link (link.href)}",
      "\t\t\t\t{@render navLink(link)}",

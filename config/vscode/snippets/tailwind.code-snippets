  "Tailwind Pagination": {
    "scope": "svelte",
    "prefix": "tw::pagination",
    "include": "Pagination.svelte",
    "isFileTemplate": true,
    "description": "Pagination component (src/lib/components/Pagination.svelte): ?page= links, prev/next, current page marked",
    "body": [
      "<script lang=\"ts\">",
      "\timport { page } from '\\$app/state';",
      "",
      "\t// TODO: list query: .limit(perPage).offset((page - 1) * perPage), total with db.\\$count(table) (db::count)",
      "\t// TODO: needs tw::theme in src/routes/layout.css (brand color)",
      "",
      "\tinterface Props {",
      "\t\ttotal: number;",
      "\t\tperPage?: number;",
      "\t}",
      "",
      "\tlet { total, perPage = ${1:20} }: Props = \\$props();",
      "",
      "\tconst last = \\$derived(Math.max(1, Math.ceil(total / perPage)));",
      "\tconst current = \\$derived(",
      "\t\tMath.min(last, Math.max(1, Math.trunc(Number(page.url.searchParams.get('page'))) || 1))",
      "\t);",
      "\t// first, last and current ±1; gaps become …",
      "\tconst pages = \\$derived(",
      "\t\tArray.from({ length: last }, (_, i) => i + 1).filter(",
      "\t\t\t(n) => n === 1 || n === last || Math.abs(n - current) <= 1",
      "\t\t)",
      "\t);",
      "",
      "\t// keeps the other query params (?q=)",
      "\tfunction href(n: number) {",
      "\t\tconst params = [...page.url.searchParams].filter(([key]) => key !== 'page');",
      "\t\treturn `?\\${new URLSearchParams([...params, ['page', String(n)]])}`;",
      "\t}",
      "</script>",
      "",
      "{#if last > 1}",
      "\t<nav aria-label=\"Pagination\" class=\"mt-6 flex items-center justify-center gap-1 text-sm font-medium\">",
      "\t\t{#if current > 1}",
      "\t\t\t<a",
      "\t\t\t\thref={href(current - 1)}",
      "\t\t\t\trel=\"prev\"",
      "\t\t\t\tclass=\"rounded-lg px-3 py-2 text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 hover:text-gray-900 dark:hover:text-white\"",
      "\t\t\t>",
      "\t\t\t\t<span aria-hidden=\"true\">←</span> <span class=\"max-sm:sr-only\">Previous</span>",
      "\t\t\t</a>",
      "\t\t{/if}",
      "\t\t{#each pages as n, i (n)}",
      "\t\t\t{#if n - (pages[i - 1] ?? n) > 1}",
      "\t\t\t\t<span class=\"px-1 text-gray-400 dark:text-gray-500\">…</span>",
      "\t\t\t{/if}",
      "\t\t\t<a",
      "\t\t\t\thref={href(n)}",
      "\t\t\t\taria-current={n === current ? 'page' : undefined}",
      "\t\t\t\tclass=\"min-w-9 rounded-lg px-3 py-2 text-center text-gray-600 dark:text-gray-400 tabular-nums hover:bg-gray-100 dark:hover:bg-gray-800 hover:text-gray-900 dark:hover:text-white aria-[current=page]:bg-brand-600 aria-[current=page]:text-white\"",
      "\t\t\t>",
      "\t\t\t\t<span class=\"sr-only\">Page</span>",
      "\t\t\t\t{n}",
      "\t\t\t</a>",
      "\t\t{/each}",
      "\t\t{#if current < last}",
      "\t\t\t<a",
      "\t\t\t\thref={href(current + 1)}",
      "\t\t\t\trel=\"next\"",
      "\t\t\t\tclass=\"rounded-lg px-3 py-2 text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 hover:text-gray-900 dark:hover:text-white\"",
      "\t\t\t>",
      "\t\t\t\t<span class=\"max-sm:sr-only\">Next</span> <span aria-hidden=\"true\">→</span>",
      "\t\t\t</a>",
      "\t\t{/if}",
      "\t</nav>",
      "{/if}",
      "",
    ],
  },

    "description": "Carousel component (src/lib/components/Carousel.svelte): Embla v9 slides from items, prev/next buttons, dots",
    "body": [
      "<script lang=\"ts\" generics=\"T\">",
      "\timport type { Snippet } from 'svelte';",
      "\timport type { EmblaCarouselType, EmblaOptionsType } from 'embla-carousel';",
      "\timport useEmblaCarousel from 'embla-carousel-svelte';",
      "",
      "\t// TODO: pnpm add embla-carousel-svelte@next embla-carousel@next",
      "\t// TODO: needs tw::theme in src/routes/layout.css (brand color)",
      "\t// TODO: usage: <Carousel items={photos} label=\"Photos\">{#snippet slide(photo)}<img src={photo.src} alt={photo.alt} />{/snippet}</Carousel>",
      "",
      "\tinterface Props {",
      "\t\titems: T[];",
      "\t\tlabel: string;",
      "\t\toptions?: EmblaOptionsType;",
      "\t\tslide: Snippet<[T, number]>;",
      "\t}",
      "",
      "\tlet { items, label, options = { loop: ${1|false,true|} }, slide }: Props = \\$props();",
      "",
      "\tlet emblaApi = \\$state<EmblaCarouselType>();",
      "\tlet snaps = \\$state<number[]>([]);",
      "\tlet selected = \\$state(0);",
      "\tlet canGoToPrev = \\$state(false);",
      "\tlet canGoToNext = \\$state(false);",
      "",
      "\tfunction sync(api: EmblaCarouselType) {",
      "\t\tsnaps = api.snapList();",
      "\t\tselected = api.selectedSnap();",
      "\t\tcanGoToPrev = api.canGoToPrev();",
      "\t\tcanGoToNext = api.canGoToNext();",
      "\t}",
      "",
      "\tfunction onInit(event: CustomEvent<EmblaCarouselType>) {",
      "\t\temblaApi = event.detail;",
      "\t\tsync(emblaApi);",
      "\t\temblaApi.on('select', sync).on('reinit', sync);",
      "\t}",
      "</script>",
      "",
      "<section aria-roledescription=\"carousel\" aria-label={label}>",
      "\t<div class=\"overflow-hidden\" use:useEmblaCarousel={{ options }} onemblainit={onInit}>",
      "\t\t<div class=\"-ml-4 flex touch-pan-y touch-pinch-zoom\">",
      "\t\t\t{#each items as item, i (i)}",
      "\t\t\t\t<div",
      "\t\t\t\t\trole=\"group\"",
      "\t\t\t\t\taria-roledescription=\"slide\"",
      "\t\t\t\t\taria-label=\"{i + 1} of {items.length}\"",
      "\t\t\t\t\tclass=\"min-w-0 shrink-0 grow-0 ${2|basis-full,basis-full sm:basis-1/2 lg:basis-1/3|} pl-4\"",
      "\t\t\t\t>",
      "\t\t\t\t\t{@render slide(item, i)}",
      "\t\t\t\t</div>",
      "\t\t\t{/each}",
      "\t\t</div>",
      "\t</div>",
      "",
      "\t<div class=\"mt-4 flex items-center justify-between gap-4\">",
      "\t\t<button",
      "\t\t\ttype=\"button\"",
      "\t\t\taria-label=\"Previous slide\"",
      "\t\t\tdisabled={!canGoToPrev}",
      "\t\t\tonclick={() => emblaApi?.goToPrev()}",
      "\t\t\tclass=\"rounded-lg p-2 text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 hover:text-gray-900 dark:hover:text-white disabled:pointer-events-none disabled:opacity-30\"",
      "\t\t>",
      "\t\t\t<svg",
      "\t\t\t\tclass=\"size-5\"",
      "\t\t\t\tfill=\"none\"",
      "\t\t\t\tviewBox=\"0 0 24 24\"",
      "\t\t\t\tstroke=\"currentColor\"",
      "\t\t\t\tstroke-width=\"1.5\"",
      "\t\t\t\tstroke-linecap=\"round\"",
      "\t\t\t\tstroke-linejoin=\"round\"",
      "\t\t\t\taria-hidden=\"true\"",
      "\t\t\t>",
      "\t\t\t\t<path d=\"M15.75 19.5 8.25 12l7.5-7.5\" />",
      "\t\t\t</svg>",
      "\t\t</button>",
      "\t\t<div class=\"flex gap-2\">",
      "\t\t\t{#each snaps, i (i)}",
      "\t\t\t\t<button",
      "\t\t\t\t\ttype=\"button\"",
      "\t\t\t\t\taria-label=\"Go to slide {i + 1}\"",
      "\t\t\t\t\taria-current={i === selected ? 'true' : undefined}",
      "\t\t\t\t\tonclick={() => emblaApi?.goTo(i)}",

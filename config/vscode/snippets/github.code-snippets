{
  "Github Action - CI": {
    "scope": "github-actions-workflow",
    "prefix": "github::ci.yml",
    "include": "**/.github/workflows/*.yml",
    "isFileTemplate": true,
    "description": "CI workflow: lint, check, test (when present, Playwright report on failure) and build on pushes and PRs to main and dev",
    "body": [
      "name: CI",
      "",
      "on:",
      "  push:",
      "    branches:",
      "      - main",
      "      - dev",
      "  pull_request:",
      "    branches:",
      "      - main",
      "      - dev",
      "",
      "concurrency:",
      "  group: \\${{ github.workflow }}-\\${{ github.ref }}",
      "  cancel-in-progress: true",
      "",
      "jobs:",
      "  verify:",
      "    runs-on: ubuntu-latest",
      "    timeout-minutes: 15",
      "    permissions:",
      "      contents: read",
      "    steps:",
      "      # Checkout",
      "      # https://github.com/actions/checkout",
      "      - uses: actions/checkout@v7",
      "",
      "      # Setup pnpm",
      "      # https://github.com/pnpm/action-setup",
      "      - uses: pnpm/action-setup@v6",
      "",
      "      # Setup Node.js",
      "      # https://github.com/actions/setup-node",
      "      - uses: actions/setup-node@v7",
      "        with:",
      "          node-version-file: .node-version",
      "          cache: pnpm",
      "",
      "      - name: Install dependencies",
      "        run: pnpm install --frozen-lockfile",
      "",
      "      - name: Run linter and formatter",
      "        run: pnpm lint",
      "",
      "      - name: Check",
      "        run: pnpm check",
      "",
      "      # sv's playwright add-on puts e2e into the test script",
      "      - if: hashFiles('playwright.config.*') != ''",
      "        run: pnpm exec playwright install --with-deps chromium",
      "",
      "      # Vitest, Playwright: skipped when there's no test script",
      "      - id: test",
      "        name: Test",
      "        run: pnpm run --if-present test",
      "",
      "      # Upload Artifact",
      "      # https://github.com/actions/upload-artifact",
      "      # Playwright's report and failure traces, when the tests fail",
      "      - if: \\${{ failure() && steps.test.outcome == 'failure' }}",
      "        uses: actions/upload-artifact@v7",
      "        with:",
      "          name: playwright-report",
      "          path: |",
      "            playwright-report",
      "            test-results",
      "          if-no-files-found: ignore",
      "          retention-days: 7",
      "",
      "      - name: Build",
      "        run: pnpm build",
      ""
    ]
  },
  "Github Action - Deploy": {
    "scope": "github-actions-workflow",
    "prefix": "github::deploy.yml",
    "include": "**/.github/workflows/*.yml",
    "isFileTemplate": true,
    "description": "Deploy workflow on push to main: static sites (adapter-static) to Cloudflare Pages, dynamic ones to Workers (D1 migrations first), then purge the zone cache",
    "body": [
      "# TODO: static site (adapter-static): keep \"Deploy to Cloudflare Pages\";",
      "#   dynamic: comment it out and uncomment \"Deploy to Cloudflare Workers\"",
      "# TODO: secrets CLOUDFLARE_API_TOKEN and CLOUDFLARE_ACCOUNT_ID; token:",
      "#   Cloudflare Pages > Edit (static), Workers Scripts and D1 > Edit (dynamic)",
      "# TODO: static: create the Pages project once, then add the custom domain:",
      "#   pnpm dlx wrangler pages project create $WORKSPACE_NAME \\\\",
      "#     --production-branch main",
      "# TODO: dynamic: don't also connect Workers Builds, it would deploy twice",
      "# TODO: secrets CLOUDFLARE_ZONE_ID and CLOUDFLARE_API_PURGE_TOKEN",
      "#   (Zone > Cache Purge); no Cache Rule caching HTML: delete the purge step",
      "",
      "name: Deploy Website",
      "",
      "on:",
      "\tpush:",
      "\t\tbranches:",
      "\t\t\t- main",
      "",
      "# One deploy at a time: a new push waits, a running deploy is never cancelled",
      "concurrency:",
      "\tgroup: \\${{ github.workflow }}",
      "\tcancel-in-progress: false",
      "",
      "jobs:",
      "\tdeploy:",
      "\t\truns-on: ubuntu-latest",
      "\t\ttimeout-minutes: 15",
      "\t\tpermissions:",
      "\t\t\tcontents: read",
      "",
      "\t\tsteps:",
      "\t\t\t# Checkout",
      "\t\t\t# https://github.com/actions/checkout",
      "\t\t\t- name: Repository Checkout",
      "\t\t\t\tuses: actions/checkout@v7",
      "",
      "\t\t\t# Setup pnpm",
      "\t\t\t# https://github.com/pnpm/action-setup",
      "\t\t\t- name: Install pnpm",
      "\t\t\t\tuses: pnpm/action-setup@v6",
      "",
      "\t\t\t# Setup Node.js",
      "\t\t\t# https://github.com/actions/setup-node",
      "\t\t\t- name: Setup Node.js",
      "\t\t\t\tuses: actions/setup-node@v7",
      "\t\t\t\twith:",
      "\t\t\t\t\tnode-version-file: .node-version",
      "\t\t\t\t\tcache: pnpm",
      "",
      "\t\t\t- name: Install dependencies",
      "\t\t\t\trun: pnpm install --frozen-lockfile",
      "",
      "\t\t\t- name: Build",
      "\t\t\t\trun: pnpm run build",
      "",
      "\t\t\t# Cloudflare Pages direct upload (static)",
      "\t\t\t# https://developers.cloudflare.com/pages/get-started/direct-upload/",
      "\t\t\t- name: Deploy to Cloudflare Pages",
      "\t\t\t\tenv:",
      "\t\t\t\t\tCLOUDFLARE_API_TOKEN: \\${{ secrets.CLOUDFLARE_API_TOKEN }}",
      "\t\t\t\t\tCLOUDFLARE_ACCOUNT_ID: \\${{ secrets.CLOUDFLARE_ACCOUNT_ID }}",
      "\t\t\t\t\tPROJECT: \\${{ github.event.repository.name }}",
      "\t\t\t\trun: |",
      "\t\t\t\t\tpnpm dlx wrangler@4.156.0 pages deploy build \\\\",
      "\t\t\t\t\t\t--project-name=\"\\$PROJECT\" --branch=main",
      "",
      "\t\t\t# Cloudflare Workers (dynamic)",
      "\t\t\t# https://developers.cloudflare.com/workers/wrangler/commands/",
      "\t\t\t# Without D1 drop the migrations line;",
      "\t\t\t# with cf::cron or cf::workflow: wrangler deploy worker.ts",
      "\t\t\t# - name: Deploy to Cloudflare Workers",
      "\t\t\t#   env:",
      "\t\t\t#     CLOUDFLARE_API_TOKEN: \\${{ secrets.CLOUDFLARE_API_TOKEN }}",
      "\t\t\t#     CLOUDFLARE_ACCOUNT_ID: \\${{ secrets.CLOUDFLARE_ACCOUNT_ID }}",
      "\t\t\t#   run: |",
      "\t\t\t#     pnpm exec wrangler d1 migrations apply DB --remote",
      "\t\t\t#     pnpm exec wrangler deploy",
      "",
      "\t\t\t# Cloudflare cache purge API",
      "\t\t\t# https://developers.cloudflare.com/api/resources/cache/methods/purge/",
      "\t\t\t# The zone's Cache Rules cache HTML too; the token goes through stdin",
      "\t\t\t- name: Purge Cloudflare Cache",
      "\t\t\t\tenv:",
      "\t\t\t\t\tZONE_ID: \\${{ secrets.CLOUDFLARE_ZONE_ID }}",
      "\t\t\t\t\tTOKEN: \\${{ secrets.CLOUDFLARE_API_PURGE_TOKEN }}",
      "\t\t\t\trun: |",
      "\t\t\t\t\tprintf 'Authorization: Bearer %s\\\\n' \"\\$TOKEN\" |",
      "\t\t\t\t\t\tcurl -sS --fail-with-body -X POST -H @- \\\\",
      "\t\t\t\t\t\t\t-H 'Content-Type: application/json' \\\\",
      "\t\t\t\t\t\t\t--data '{\"purge_everything\":true}' \\\\",
      "\t\t\t\t\t\t\t\"https://api.cloudflare.com/client/v4/zones/\\$ZONE_ID/purge_cache\"",
      ""
    ]
  },

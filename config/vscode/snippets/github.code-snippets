  "Github Action - PR Title": {
    "scope": "github-actions-workflow",
    "prefix": "github::pr-title.yml",
    "include": "**/.github/workflows/*.yml",
    "isFileTemplate": true,
    "description": "Checks that PR titles follow conventional commits: squash merges use them as commit messages, release-please builds the changelog from them",
    "body": [
      "# Conventional commit PR titles: squash merges use the title as the commit",
      "# message, and release-please builds the changelog from those messages",
      "name: PR Title",
      "",
      "on:",
      "\tpull_request:",
      "\t\ttypes:",
      "\t\t\t- opened",
      "\t\t\t- reopened",
      "\t\t\t- edited",
      "\t\t\t- synchronize",
      "",
      "jobs:",
      "\tvalidate:",
      "\t\tname: Validate PR title",
      "\t\truns-on: ubuntu-latest",
      "\t\ttimeout-minutes: 10",
      "\t\tpermissions:",
      "\t\t\tpull-requests: read",
      "\t\tsteps:",
      "\t\t\t# Semantic Pull Request",
      "\t\t\t# https://github.com/amannn/action-semantic-pull-request",
      "\t\t\t- uses: amannn/action-semantic-pull-request@v6",
      "\t\t\t\tenv:",
      "\t\t\t\t\tGITHUB_TOKEN: \\${{ github.token }}",
      ""
    ]

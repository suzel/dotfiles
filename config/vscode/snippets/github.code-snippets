  "Github Action - Dependabot Auto-merge": {
    "scope": "github-actions-workflow",
    "prefix": "github::dependabot-automerge.yml",
    "include": "**/.github/workflows/*.yml",
    "isFileTemplate": true,
    "description": "Auto-merges Dependabot's minor and patch PRs (squash) once the required checks pass",
    "body": [
      "# TODO: allow auto-merge (gh repo edit --enable-auto-merge) and require",
      "#   the CI check on main (branch protection or a ruleset); without a",
      "#   required check PRs merge right away",
      "",
      "name: Dependabot Auto-merge",
      "",
      "on:",
      "\tpull_request:",
      "",
      "jobs:",
      "\tautomerge:",
      "\t\tif: github.event.pull_request.user.login == 'dependabot[bot]'",
      "\t\truns-on: ubuntu-latest",
      "\t\ttimeout-minutes: 10",
      "\t\tpermissions:",
      "\t\t\tcontents: write",
      "\t\t\tpull-requests: write",
      "\t\tsteps:",
      "\t\t\t# Fetch Metadata",
      "\t\t\t# https://github.com/dependabot/fetch-metadata",
      "\t\t\t- id: metadata",
      "\t\t\t\tuses: dependabot/fetch-metadata@v3",
      "",
      "\t\t\t# Majors stay open for a manual review",
      "\t\t\t- name: Enable auto-merge",
      "\t\t\t\tif: steps.metadata.outputs.update-type != 'version-update:semver-major'",
      "\t\t\t\tenv:",
      "\t\t\t\t\tGH_TOKEN: \\${{ github.token }}",
      "\t\t\t\t\tPR_URL: \\${{ github.event.pull_request.html_url }}",
      "\t\t\t\trun: gh pr merge --auto --squash \"\\$PR_URL\"",
      ""
    ]
  },
  "Dependabot for Github Actions": {
    "scope": "yaml",
    "prefix": "github::dependabot.yml",
    "isFileTemplate": true,
    "include": "dependabot.yml",
    "description": "dependabot.yml: grouped weekly npm updates, monthly Actions, Docker base image",
    "body": [
      "# TODO: without a Dockerfile, delete the docker entry",
      "",
      "# Dependabot options",
      "# https://docs.github.com/en/code-security/reference/supply-chain-security/dependabot-options-reference",
      "version: 2",
      "",
      "updates:",
      "  # pnpm",
      "  # https://docs.github.com/en/code-security/reference/supply-chain-security/supported-ecosystems-and-repositories#pnpm",
      "  - package-ecosystem: npm",
      "    directory: /",
      "    schedule:",
      "      interval: weekly",
      "      day: monday",
      "      time: '06:00'",
      "      timezone: Europe/Istanbul",
      "    cooldown:",
      "      default-days: 3",
      "      semver-major-days: 14",
      "      semver-minor-days: 7",
      "      semver-patch-days: 3",
      "      exclude:",
      "        - '@sveltejs/*'",
      "    versioning-strategy: increase",
      "    open-pull-requests-limit: 10",
      "    rebase-strategy: auto",
      "    labels:",
      "      - dependencies",
      "      - npm",
      "    assignees:",
      "      - suzel",
      "    commit-message:",
      "      prefix: chore",
      "      include: scope",
      "    pull-request-branch-name:",
      "      separator: '-'",
      "    ignore:",
      "      - dependency-name: '@types/node'",
      "        update-types:",
      "          - version-update:semver-major",
      "    groups:",
      "      sveltekit:",
      "        patterns:",
      "          - svelte",
      "          - '@sveltejs/*'",
      "          - svelte-check",
      "          - vite",
      "          - vitest",
      "          - '@vitest/*'",
      "      tailwind:",
      "        patterns:",
      "          - tailwindcss",
      "          - '@tailwindcss/*'",
      "      lint-format:",
      "        patterns:",
      "          - eslint",
      "          - eslint-*",
      "          - '@eslint/*'",
      "          - typescript-eslint",
      "          - prettier",
      "          - prettier-plugin-*",
      "          - '@ianvs/prettier-plugin-sort-imports'",
      "          - globals",
      "      types:",
      "        patterns:",
      "          - typescript",
      "          - '@types/*'",
      "      test:",
      "        patterns:",
      "          - '@playwright/test'",
      "          - '@testing-library/*'",
      "          - jsdom",
      "      dev-minor-patch:",
      "        dependency-type: development",
      "        update-types:",
      "          - minor",
      "          - patch",
      "      prod-minor-patch:",
      "        dependency-type: production",
      "        update-types:",
      "          - minor",
      "          - patch",
      "      security:",
      "        applies-to: security-updates",
      "        patterns:",
      "          - '*'",
      "",
      "  # GitHub Actions",
      "  # https://docs.github.com/en/code-security/reference/supply-chain-security/supported-ecosystems-and-repositories#github-actions",
      "  - package-ecosystem: github-actions",
      "    directories:",
      "      - /",
      "      - /.github/actions/*",
      "    schedule:",
      "      interval: monthly",
      "    cooldown:",
      "      default-days: 7",
      "    labels:",
      "      - dependencies",
      "      - github-actions",
      "    commit-message:",
      "      prefix: ci",
      "    groups:",
      "      actions:",
      "        patterns:",
      "          - '*'",
      "",
      "  # Docker",
      "  # https://docs.github.com/en/code-security/reference/supply-chain-security/supported-ecosystems-and-repositories#docker",
      "  - package-ecosystem: docker",
      "    directory: /",
      "    schedule:",
      "      interval: weekly",
      "    labels:",
      "      - dependencies",
      "      - docker",
      "    commit-message:",
      "      prefix: build",
      "    ignore:",
      "      - dependency-name: node",
      "        update-types:",
      "          - version-update:semver-major",
      ""
    ]
  },

      "\t\t\t# Checkout",
      "\t\t\t# https://github.com/actions/checkout",
      "\t\t\t- uses: actions/checkout@v7",
      "",
      "\t\t\t# CodeQL Action",
      "\t\t\t# https://github.com/github/codeql-action",
      "\t\t\t- uses: github/codeql-action/init@v4",
      "\t\t\t\twith:",
      "\t\t\t\t\tlanguages: javascript-typescript,actions",
      "\t\t\t- uses: github/codeql-action/analyze@v4",
      ""
    ]

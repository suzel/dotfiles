  "Github Action - Check": {
    "scope": "github-actions-workflow",
    "include": "**/.github/workflows/*.yml",
    "isFileTemplate": true,
    "description": "Weekly + PR project check via suzel/dotfiles sv-check.yml; report in the job summary",
    "body": [
      "# TODO: needs .node-version and packageManager in package.json (sv-setup writes both)",
      "# TODO: org repo: add a GITLEAKS_LICENSE secret (free at gitleaks.io) and uncomment secrets: inherit",
      "# Results: the run's summary, annotations and Lighthouse artifact, PR comments; weekly status comment on the \"sv-check report\" issue (emailed)",
      "name: Check",
      "",
      "on:",
      "  pull_request:",
      "  schedule:",
      "    - cron: \"0 6 * * 1\" # Mondays 06:00 UTC",
      "  workflow_dispatch:",
      "",
      "concurrency:",
      "  group: \\${{ github.workflow }}-\\${{ github.ref }}",
      "  cancel-in-progress: true",
      "",
      "jobs:",
      "  check:",
      "    permissions:",
      "      contents: read",
      "      issues: write # weekly status comment, GitHub emails it",
      "      pull-requests: write # bundle size and gitleaks comments",
      "    uses: suzel/dotfiles/.github/workflows/sv-check.yml@main",
      "    # secrets: inherit # org repos: passes GITLEAKS_LICENSE",
      "",
    ],
    "prefix": "github::check.yml",
  },
  "Github Action - SvelteKit Check": {
    "scope": "github-actions-workflow",
    "include": "**/.github/workflows/*.yml",
    "isFileTemplate": true,
    "description": "Standalone SvelteKit check workflow: every tool as a step or action, weekly status comment; no dotfiles dependency",
    "body": [
      "# TODO: needs .node-version and packageManager in package.json (sv-setup writes both)",
      "# TODO: org repo: add a GITLEAKS_LICENSE secret (free at gitleaks.io)",
      "# SvelteKit Project Check, standalone copy of suzel/dotfiles sv-check.yml",
      "# (github::check.yml calls that one instead and gets its updates).",
      "# The project's checks and audit tools, one step per tool. Results land",
      "# where GitHub shows them: step logs and annotations, the job summary",
      "# (osv-scanner, knip, gitleaks), PR comments (bundle size, gitleaks) and",
      "# artifacts (Lighthouse). Scheduled runs also comment their status on the",
      "# \"sv-check report\" issue, which GitHub emails to the repo's watchers.",
      "name: Check",
      "",
      "on:",
      "  pull_request:",
      "  schedule:",
      "    - cron: \"0 6 * * 1\" # Mondays 06:00 UTC",
      "  workflow_dispatch:",
      "",
      "concurrency:",
      "  group: \\${{ github.workflow }}-\\${{ github.ref }}",
      "  cancel-in-progress: true",
      "",
      "jobs:",
      "  check:",
      "    runs-on: ubuntu-latest",
      "    timeout-minutes: 30",
      "    permissions:",
      "      contents: read",
      "      issues: write",
      "      pull-requests: write",
      "    env:",
      "      CLIENT: .svelte-kit/output/client",
      "      # not localhost: vite may bind ::1 while Node tools dial 127.0.0.1",
      "      URL: http://127.0.0.1:4173",
      "    # Every step runs (!cancelled()); a failing step without",
      "    # continue-on-error fails the job, the others only warn",
      "    steps:",
      "      # Setup",
      "      - uses: actions/checkout@v7",
      "        with:",
      "          fetch-depth: 0 # gitleaks scans the history",
      "      - uses: pnpm/action-setup@v6 # version from packageManager",
      "      - uses: actions/setup-node@v7",
      "        with:",
      "          node-version-file: .node-version",
      "          cache: pnpm",
      "      - run: pnpm install --frozen-lockfile",
      "      # sv's playwright add-on puts e2e into the test script",
      "      - if: hashFiles('playwright.config.*') != ''",
      "        run: pnpm exec playwright install --with-deps chromium",
      "      - uses: taiki-e/install-action@v2",
      "        with:",
      "          tool: osv-scanner@2.6.0",
      "",
      "      # Quality: the project's own scripts, skipped when missing",
      "      - name: Types (svelte-check)",
      "        if: \\${{ !cancelled() }}",
      "        run: pnpm run --if-present check",
      "      - name: Lint",
      "        if: \\${{ !cancelled() }}",
      "        run: pnpm run --if-present lint",
      "      - name: Tests",
      "        if: \\${{ !cancelled() }}",
      "        run: pnpm run --if-present test",
      "      # https://oxc.rs",
      "      - name: Oxlint",
      "        if: \\${{ !cancelled() }}",
      "        continue-on-error: true",
      "        run: pnpm dlx oxlint@1.85.0 --format github --deny-warnings",
      "      # One log group per component",
      "      # https://github.com/sveltejs/mcp",
      "      - name: Svelte 5 practices (svelte-autofixer)",
      "        if: \\${{ !cancelled() }}",
      "        continue-on-error: true",
      "        run: |",
      "          npm install -g @sveltejs/mcp@0.1.26",
      "          find src -name '*.svelte' -print0 | xargs -0 -P 8 -I{} sh -c \\\\",
      "            'printf \"::group::%s\\\\n%s\\\\n::endgroup::\\\\n\" \"\\$1\" \\\\",
      "              \"\\$(svelte-mcp svelte-autofixer \"\\$1\" 2>&1)\"' _ {}",
      "      # https://knip.dev",
      "      - name: Unused files, exports & deps (knip)",
      "        if: \\${{ !cancelled() }}",
      "        continue-on-error: true",
      "        run: |",
      "          pnpm dlx knip@6.38.0 --reporter markdown | tee -a \"\\$GITHUB_STEP_SUMMARY\"",
      "      # https://github.com/kucherenko/jscpd",
      "      - name: Duplicate code (jscpd)",
      "        if: \\${{ !cancelled() }}",
      "        continue-on-error: true",
      "        run: pnpm dlx jscpd@5.3.2 src --exit-code",
      "",
      "      # Security",
      "      # https://osv.dev",
      "      - name: Vulnerabilities (osv-scanner)",
      "        if: \\${{ !cancelled() }}",
      "        run: |",
      "          osv-scanner scan -L pnpm-lock.yaml --format markdown \\\\",
      "            --verbosity error | tee -a \"\\$GITHUB_STEP_SUMMARY\"",
      "      # https://github.com/gitleaks/gitleaks-action",
      "      - name: Secrets (gitleaks)",
      "        if: \\${{ !cancelled() }}",
      "        uses: gitleaks/gitleaks-action@v3",
      "        env:",
      "          GITHUB_TOKEN: \\${{ github.token }}",
      "          GITLEAKS_VERSION: 8.30.1",
      "          GITLEAKS_LICENSE: \\${{ secrets.GITLEAKS_LICENSE }} # orgs only",
      "      - name: Licenses",
      "        if: \\${{ !cancelled() }}",
      "        run: pnpm licenses list --prod",
      "      - name: Outdated dependencies",
      "        if: \\${{ !cancelled() }}",
      "        continue-on-error: true",
      "        run: pnpm outdated",
      "      - name: Duplicate dependencies",
      "        if: \\${{ !cancelled() }}",
      "        continue-on-error: true",
      "        run: pnpm dedupe --check",
      "",
      "      # Performance",
      "      - id: build",
      "        name: Build",
      "        if: \\${{ !cancelled() }}",
      "        run: pnpm build",
      "      # PR comment with the gzip size change per file",
      "      # https://github.com/preactjs/compressed-size-action",
      "      - name: Bundle size",
      "        if: \\${{ !cancelled() && github.event_name == 'pull_request' }}",
      "        uses: preactjs/compressed-size-action@v2",
      "        with:",
      "          install-script: pnpm install --frozen-lockfile",
      "          build-script: build",
      "          pattern: .svelte-kit/output/client/**/*.{js,css}",
      "      # https://retirejs.github.io/retire.js/",
      "      - name: Vulnerable libraries in bundle (retire)",
      "        if: \\${{ !cancelled() && steps.build.outcome == 'success' }}",
      "        run: pnpm dlx retire@5.7.0 --path \"\\$CLIENT\"",
      "      # Keeps running for the steps below until the job ends",
      "      - name: Start vite preview",
      "        if: \\${{ !cancelled() && steps.build.outcome == 'success' }}",
      "        run: |",
      "          nohup ./node_modules/.bin/vite preview --host 127.0.0.1 --port 4173 \\\\",
      "            --strictPort >/dev/null 2>&1 &",
      "          curl -sf --retry 30 --retry-delay 1 --retry-connrefused \"\\$URL\" >/dev/null",
      "      # Mobile, simulated throttling; HTML report as an artifact",
      "      # https://github.com/treosh/lighthouse-ci-action",
      "      - name: Lighthouse",
      "        if: \\${{ !cancelled() && steps.build.outcome == 'success' }}",
      "        continue-on-error: true",
      "        uses: treosh/lighthouse-ci-action@v12",
      "        with:",
      "          urls: \\${{ env.URL }}",
      "          runs: 1",
      "          uploadArtifacts: true",
      "      # https://github.com/JustinBeckwith/linkinator-action",
      "      - name: Broken links (linkinator)",
      "        if: \\${{ !cancelled() && steps.build.outcome == 'success' }}",
      "        uses: JustinBeckwith/linkinator-action@v2",
      "        with:",
      "          paths: \\${{ env.URL }}",
      "          recurse: true",
      "          linksToSkip: ^(?!http://127\\\\.0\\\\.0\\\\.1)",
      "          verbosity: ERROR",
      "      # Prerendered pages",
      "      # https://html-validate.org",
      "      - name: HTML validation",
      "        if: >-",
      "          \\${{ !cancelled() && steps.build.outcome == 'success'",
      "          && hashFiles('.svelte-kit/output/prerendered/**/*.html') != '' }}",
      "        continue-on-error: true",
      "        run: |",
      "          pnpm dlx html-validate@11.16.0 --preset standard --ext html \\\\",
      "            .svelte-kit/output/prerendered",
      "",
      "      # Scheduled runs: status and run link as a comment; GitHub emails it",
      "      - name: Weekly status comment",
      "        if: \\${{ always() && github.event_name == 'schedule' }}",
      "        env:",
      "          GH_TOKEN: \\${{ github.token }}",
      "          GH_REPO: \\${{ github.repository }}",
      "          TITLE: sv-check report",
      "          BODY: >-",
      "            **\\${{ job.status }}**: \\${{ github.server_url }}/\\${{",
      "            github.repository }}/actions/runs/\\${{ github.run_id }}",
      "        run: |",
      "          n=\\$(gh issue list --search \"\\\\\"\\$TITLE\\\\\" in:title\" \\\\",
      "            --json number --jq '.[0].number // empty')",
      "          [[ -n \\$n ]] || n=\\$(gh issue create --title \"\\$TITLE\" \\\\",
      "            --body \"Weekly Check results.\" | sed 's|.*/||')",
      "          gh issue comment \"\\$n\" --body \"\\$BODY\"",
      "",
    ],
    "prefix": "github::sv-check.yml",
  },
  "Dependabot for Github Actions": {
    "scope": "yaml",
    "isFileTemplate": true,
    "include": "dependabot.yml",
    "description": "dependabot.yml: grouped weekly npm updates, monthly Actions, Docker base image",
    "body": [
      "# .github/dependabot.yml — SvelteKit (pnpm) project",
      "version: 2",
      "",
      "# registries:                       # only with a private npm registry",
      "#   npm-private:",
      "#     type: npm-registry",
      "#     url: https://npm.pkg.github.com",
      "#     token: \\${{ secrets.NPM_TOKEN }}",
      "",
      "updates:",
      "  # ── npm (also updates pnpm-lock.yaml) ──────────────────────────────",
      "  - package-ecosystem: \"npm\"",
      "    directory: \"/\" # monorepo: directories: [\"/\", \"/packages/*\"]",
      "    # exclude-paths: [\"examples/**\"]",
      "    # target-branch: \"develop\"      # non-default branch (security PRs are not affected)",
      "    # registries: [npm-private]",
      "    schedule:",
      "      interval: \"weekly\"",
      "      day: \"monday\"",
      "      time: \"06:00\"",
      "      timezone: \"Europe/Istanbul\"",
      "    cooldown: # wait before taking new releases (not applied to security updates)",
      "      default-days: 3",
      "      semver-major-days: 14",
      "      semver-minor-days: 7",
      "      semver-patch-days: 3",
      "      exclude: [\"@sveltejs/*\"] # take these without waiting",
      "    versioning-strategy: \"increase\" # raise the package.json range; \"widen\" for a library (svelte-package)",
      "    open-pull-requests-limit: 10",
      "    rebase-strategy: \"auto\"",
      "    labels: [\"dependencies\", \"npm\"]",
      "    assignees: [\"<github-username>\"] # for reviewers use .github/CODEOWNERS",
      "    # milestone: 4",
      "    commit-message:",
      "      prefix: \"chore\" # → \"chore(deps): ...\" / \"chore(deps-dev): ...\"",
      "      include: \"scope\"",
      "    pull-request-branch-name:",
      "      separator: \"-\"",
      "    ignore:",
      "      - dependency-name: \"@types/node\" # stays on the Node runtime's major",
      "        update-types: [\"version-update:semver-major\"]",
      "    groups: # a package joins the first group it matches → order matters",
      "      sveltekit: # majors must land together (vite ↔ vite-plugin-svelte)",
      "        patterns:",
      "          - \"svelte\"",
      "          - \"@sveltejs/*\"",
      "          - \"svelte-check\"",
      "          - \"vite\"",
      "          - \"vitest\"",
      "          - \"@vitest/*\"",
      "      tailwind:",
      "        patterns: [\"tailwindcss\", \"@tailwindcss/*\"]",
      "      lint-format: # includes eslint-plugin-svelte, prettier-plugin-*",
      "        patterns:",
      "          - \"eslint\"",
      "          - \"eslint-*\"",
      "          - \"@eslint/*\"",
      "          - \"typescript-eslint\"",
      "          - \"prettier\"",
      "          - \"prettier-plugin-*\"",
      "          - \"globals\"",
      "      types:",
      "        patterns: [\"typescript\", \"@types/*\"]",
      "      test:",
      "        patterns: [\"@playwright/test\", \"@testing-library/*\", \"jsdom\"]",
      "      dev-minor-patch: # remaining dev deps; majors get their own PRs",
      "        dependency-type: \"development\"",
      "        update-types: [\"minor\", \"patch\"]",
      "      prod-minor-patch:",
      "        dependency-type: \"production\"",
      "        update-types: [\"minor\", \"patch\"]",
      "      security: # all security updates in one PR",
      "        applies-to: security-updates",
      "        patterns: [\"*\"]",
      "",
      "  # ── GitHub Actions ───────────────────────────────────────────────",
      "  - package-ecosystem: \"github-actions\"",
      "    directories: [\"/\", \"/.github/actions/*\"] # \"/\" = .github/workflows + root action.yml",
      "    schedule:",
      "      interval: \"monthly\"",
      "    cooldown:",
      "      default-days: 7",
      "    labels: [\"dependencies\", \"github-actions\"]",
      "    commit-message:",
      "      prefix: \"ci\"",
      "    groups:",
      "      actions:",
      "        patterns: [\"*\"]",
      "",
      "  # ── Docker (only with adapter-node and a Dockerfile) ─────────────",
      "  - package-ecosystem: \"docker\"",
      "    directory: \"/\"",
      "    schedule:",
      "      interval: \"weekly\"",
      "    labels: [\"dependencies\", \"docker\"]",
      "    commit-message:",
      "      prefix: \"build\"",
      "    ignore:",
      "      - dependency-name: \"node\" # node:22-alpine → stay on LTS, bump the major by hand",
      "        update-types: [\"version-update:semver-major\"]",
      "",
    ],
    "prefix": "github::dependabot.yml",
  },
  "Renovate for Github Action": {
    "scope": "json",
    "isFileTemplate": true,
    "include": "renovate.json",
    "description": "renovate.json: weekly updates, pinned Action digests, minor/patch automerge",
    "body": [
      "{",
      "  \"\\$schema\": \"https://docs.renovatebot.com/renovate-schema.json\",",
      "  \"extends\": [\"config:recommended\", \"helpers:pinGitHubActionDigests\"],",
      "  \"timezone\": \"Europe/Istanbul\",",
      "  \"schedule\": [\"before 6am on monday\"],",
      "  \"minimumReleaseAge\": \"3 days\",",
      "  \"packageRules\": [",
      "    { \"matchUpdateTypes\": [\"minor\", \"patch\"], \"automerge\": true }",
      "  ]",
      "}",
    ],
    "prefix": "github::renovate.json",
  },
}

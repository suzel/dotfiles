{
	"Remote Auth": {
		"scope": "typescript",
		"prefix": "remote::auth",
		"include": "auth.remote.ts",
		"isFileTemplate": true,
		"description": "signup/login/logout/getUser remote functions with better-auth",
		"body": [
			"import { invalid, redirect } from '@sveltejs/kit';",
			"import { form, getRequestEvent, query } from '\\$app/server';",
			"import { APIError } from 'better-auth/api';",
			"import { z } from 'zod';",
			"import { auth } from '#lib/server/auth.ts';",
			"",
			"// TODO: needs the sveltekitCookies(getRequestEvent) plugin in auth.ts so cookies get set",
			"",
			"export const signup = form(",
			"\tz.object({ name: z.string().min(2), email: z.email(), _password: z.string().min(8) }),",
			"\tasync ({ name, email, _password }) => {",
			"\t\ttry {",
			"\t\t\tawait auth.api.signUpEmail({ body: { name, email, password: _password } });",
			"\t\t} catch (e) {",
			"\t\t\tif (e instanceof APIError) invalid(e.message);",
			"\t\t\tthrow e;",
			"\t\t}",
			"\t\tredirect(303, '${1:/}');",
			"\t}",
			");",
			"",
			"export const login = form(",
			"\tz.object({ email: z.email(), _password: z.string().min(1) }),",
			"\tasync ({ email, _password }) => {",
			"\t\ttry {",
			"\t\t\tawait auth.api.signInEmail({ body: { email, password: _password } });",
			"\t\t} catch (e) {",
			"\t\t\tif (e instanceof APIError) invalid('Invalid email or password');",
			"\t\t\tthrow e;",
			"\t\t}",
			"\t\tredirect(303, '$1');",
			"\t}",
			");",
			"",
			"export const logout = form(async () => {",
			"\tawait auth.api.signOut({ headers: getRequestEvent().request.headers });",
			"\tredirect(303, '${2:/login}');",
			"});",
			"",
			"export const getUser = query(async () => getRequestEvent().locals.user ?? null);",
			""
		]
	},

			"\t\t\t\t<th scope=\"col\">Name</th>",
			"\t\t\t\t<th scope=\"col\">Role</th>",
			"\t\t\t\t<th scope=\"col\"><span class=\"sr-only\">Ban</span></th>",
			"\t\t\t</tr>",
			"\t\t</thead>",
			"\t\t<tbody>",
			"\t\t\t{#each users as user (user.id)}",
			"\t\t\t\t{@const role = setUserRole.for(user.id)}",
			"\t\t\t\t{@const ban = user.banned ? unbanUser.for(user.id) : banUser.for(user.id)}",
			"\t\t\t\t<tr>",
			"\t\t\t\t\t<td>{user.email}</td>",
			"\t\t\t\t\t<td>{user.name}</td>",
			"\t\t\t\t\t<td>",
			"\t\t\t\t\t\t<form {...role}>",
			"\t\t\t\t\t\t\t<input {...role.fields.userId.as('hidden', user.id)} />",
			"\t\t\t\t\t\t\t<select {...role.fields.role.as('select', user.role === 'admin' ? 'admin' : 'user')} aria-label=\"Role\">",
			"\t\t\t\t\t\t\t\t<option value=\"user\">User</option>",
			"\t\t\t\t\t\t\t\t<option value=\"admin\">Admin</option>",
			"\t\t\t\t\t\t\t</select>",
			"\t\t\t\t\t\t\t<button>Save</button>",
			"\t\t\t\t\t\t</form>",
			"\t\t\t\t\t</td>",
			"\t\t\t\t\t<td>",
			"\t\t\t\t\t\t<form {...ban}>",
			"\t\t\t\t\t\t\t<input {...ban.fields.userId.as('hidden', user.id)} />",
			"\t\t\t\t\t\t\t<button>{user.banned ? 'Unban' : 'Ban'}</button>",
			"\t\t\t\t\t\t</form>",
			"\t\t\t\t\t\t{#each ban.fields.allIssues() ?? [] as issue (issue.message)}",
			"\t\t\t\t\t\t\t<p class=\"text-danger-600\">{issue.message}</p>",
			"\t\t\t\t\t\t{/each}",
			"\t\t\t\t\t</td>",
			"\t\t\t\t</tr>",
			"\t\t\t{:else}",
			"\t\t\t\t<tr>",
			"\t\t\t\t\t<td colspan=\"4\">No users found</td>",
			"\t\t\t\t</tr>",
			"\t\t\t{/each}",
			"\t\t</tbody>",
			"\t</table>",
			"\t<Pagination {total} {perPage} />",
			"",
			"\t{#snippet pending()}",
			"\t\t<p>Loading...</p>",
			"\t{/snippet}",
			"</svelte:boundary>"
		]
	}
}

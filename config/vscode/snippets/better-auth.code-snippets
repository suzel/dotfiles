	"Auth Admin Remote": {
		"scope": "typescript",
		"prefix": "auth::admin",
		"include": "admin.remote.ts",
		"isFileTemplate": true,
		"description": "admin.remote.ts: list users, set role, ban/unban (better-auth admin plugin)",
		"body": [
			"import { error, invalid } from '@sveltejs/kit';",
			"import { form, getRequestEvent, query } from '\\$app/server';",
			"import { APIError } from 'better-auth/api';",
			"import { z } from 'zod';",
			"import { auth } from '#lib/server/auth.ts';",
			"",
			"// TODO: better-auth admin() plugin in src/lib/server/auth.ts (import { admin } from 'better-auth/plugins'), then pnpm auth:schema and migrate (adds user.role, user.banned)",
			"// TODO: src/app.d.ts: user?: typeof auth.\\$Infer.Session.user (import type { auth } from '#lib/server/auth.ts') so user.role is typed",
			"// TODO: first admin: admin({ adminUserIds: ['<your user id>'] }) or UPDATE \"user\" SET role = 'admin' WHERE email = '…'",
			"// TODO: this file must not be inside a `server` directory, e.g. src/lib/remote/admin.remote.ts",
			"",
			"/** Request headers of a logged-in admin, or 403 (better-auth checks them again) */",
			"function adminHeaders() {",
			"\tconst { locals, request } = getRequestEvent();",
			"\tif (!locals.user?.role?.split(',').includes('admin')) error(403, 'Forbidden');",
			"\treturn request.headers;",
			"}",
			"",
			"const perPage = ${1:20};",
			"",
			"export const getUsers = query(",
			"\tz.object({ page: z.number().int().min(1), q: z.string() }),",
			"\tasync ({ page, q }) => {",
			"\t\tconst { users, total } = await auth.api.listUsers({",
			"\t\t\tquery: {",
			"\t\t\t\tlimit: perPage,",
			"\t\t\t\toffset: (page - 1) * perPage,",
			"\t\t\t\tsortBy: 'createdAt',",
			"\t\t\t\tsortDirection: 'desc',",
			"\t\t\t\t...(q && { searchValue: q, searchField: 'email', searchOperator: 'contains' })",
			"\t\t\t},",
			"\t\t\theaders: adminHeaders()",
			"\t\t});",
			"\t\treturn { users, total, perPage };",
			"\t}",
			");",
			"",
			"export const setUserRole = form(",
			"\tz.object({ userId: z.string(), role: z.enum(['user', 'admin']) }),",
			"\tasync ({ userId, role }) => {",
			"\t\tawait auth.api.setRole({ body: { userId, role }, headers: adminHeaders() });",
			"\t}",
			");",
			"",
			"export const banUser = form(z.object({ userId: z.string() }), async ({ userId }) => {",
			"\ttry {",
			"\t\tawait auth.api.banUser({ body: { userId }, headers: adminHeaders() });",
			"\t} catch (e) {",
			"\t\tif (e instanceof APIError) invalid(e.message); // e.g. banning yourself",
			"\t\tthrow e;",
			"\t}",
			"});",
			"",
			"export const unbanUser = form(z.object({ userId: z.string() }), async ({ userId }) => {",
			"\tawait auth.api.unbanUser({ body: { userId }, headers: adminHeaders() });",
			"});"
		]
	},

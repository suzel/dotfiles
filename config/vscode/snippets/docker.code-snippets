{
  "Docker Compose for Svelte": {
    "scope": "dockercompose",
    "prefix": "docker::compose.yaml",
    "isFileTemplate": true,
    "include": "compose.yaml",
    "description": "compose.yaml: SvelteKit app on adapter-node with its services",
    "body": [
      "name: sveltekit-app",
      "",
      "services:",
      "  # App — SvelteKit (adapter-node)",
      "  # https://svelte.dev/docs/kit/adapter-node",
      "  app:",
      "    container_name: sveltekit-app",
      "    build:",
      "      context: ..",
      "      dockerfile: docker/Dockerfile",
      "    restart: unless-stopped",
      "    ports:",
      "      - \"3000:3000\"",
      "    environment:",
      "      NODE_ENV: production",
      "      ORIGIN: \\${ORIGIN:-http://localhost:3000}",
      "      BODY_SIZE_LIMIT: \\${BODY_SIZE_LIMIT:-5M}",
      "    env_file:",
      "      - ../.env",
      "    networks:",
      "      - app-network",
      "    healthcheck:",
      "      test:",
      "        [",
      "          \"CMD\",",
      "          \"/nodejs/bin/node\",",
      "          \"-e\",",
      "          \"fetch('http://localhost:3000/').then((r) => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))\",",
      "        ]",
      "      interval: 30s",
      "      timeout: 10s",
      "      retries: 3",
      "      start_period: 40s",
      "",
      "# Networks",
      "networks:",
      "  app-network:",
      "    name: app-network",
      "    driver: bridge",
      "    external: false",
      ""
    ]
  },
  "Docker Compose for Svelte - Dev": {
    "scope": "dockercompose",
    "prefix": "docker::compose.dev.yaml",
    "isFileTemplate": true,
    "include": "compose.dev.yaml",
    "description": "compose.dev.yaml: dev override running vite dev with HMR",
    "body": [
      "services:",
      "  # App",
      "  app:",
      "    build:",
      "      target: dev",
      "    command: pnpm exec vite dev --host 0.0.0.0",
      "    ports:",
      "      - '5173:5173'",
      "      - '24678:24678'",
      "    environment:",
      "      NODE_ENV: development",
      "      ORIGIN: http://localhost:5173",
      "    healthcheck:",
      "      disable: true",
      "    volumes:",
      "      - ../:/app",
      "      - /app/node_modules",
      "      - /app/.svelte-kit",
      ""
    ]
  },
  "Docker Compose for PostgREST": {
    "scope": "dockercompose",
    "prefix": "docker::compose.postgrest.yaml",
    "isFileTemplate": true,
    "include": "compose.yaml",
    "description": "docker/compose.yaml: PostgREST + Postgres + pgweb behind the db profile (COMPOSE_PROFILES=db); init SQL: docker::init.sql",
    "body": [
      "name: ${WORKSPACE_NAME/([A-Z])|([^A-Za-z0-9_-])/${1:/downcase}${2:+-}/g}",
      "",
      "# Services are opt-in via profiles, enable them in .env: COMPOSE_PROFILES=db",
      "# .env example: https://github.com/suzel/postgrest-example/blob/master/.env",
      "",
      "services:",
      "  postgrest:",
      "    profiles: [db]",
      "    image: postgrest/postgrest:v16.4",
      "    ports:",
      "      - \"127.0.0.1:3000:3000\"",
      "    env_file: ../.env",
      "    depends_on:",
      "      postgres:",
      "        condition: service_healthy",
      "",
      "  postgres:",
      "    profiles: [db]",
      "    image: postgres:18-alpine",
      "    ports:",
      "      - \"127.0.0.1:5432:5432\"",
      "    env_file: ../.env",
      "    healthcheck:",
      "      test: [\"CMD-SHELL\", \"pg_isready -U \\$\\${POSTGRES_USER} -d \\$\\${POSTGRES_DB}\"]",
      "      interval: 5s",
      "      retries: 10",
      "    volumes:",
      "      - postgres-api:/var/lib/postgresql",
      "      - ./sql/init.sql:/docker-entrypoint-initdb.d/init.sql:ro",
      "",
      "  pgweb:",
      "    profiles: [db]",
      "    image: sosedoff/pgweb:0.17.0",
      "    restart: unless-stopped",
      "    ports:",
      "      - \"127.0.0.1:8081:8081\"",
      "    environment:",
      "      DATABASE_URL: postgres://\\${POSTGRES_USER}:\\${POSTGRES_PASSWORD}@postgres:5432/\\${POSTGRES_DB}?sslmode=disable",
      "    depends_on:",
      "      postgres:",
      "        condition: service_healthy",
      "",
      "# every service joins the default network, so no per-service `networks:` needed",
      "networks:",
      "  default:",
      "    name: ${WORKSPACE_NAME/([A-Z])|([^A-Za-z0-9_-])/${1:/downcase}${2:+-}/g}",
      "",
      "volumes:",
      "  postgres-api:",
      ""
    ]
  },
  "Docker Compose for Postgres": {
    "scope": "dockercompose",
    "prefix": "docker::compose.postgres.yaml",
    "isFileTemplate": true,
    "include": "compose.yaml",
    "description": "docker/compose.yaml: local Postgres on 127.0.0.1:5432 matching rust-setup's DATABASE_URL (postgres:postgres, db from the folder name)",
    "body": [
      "services:",
      "  db:",
      "    image: postgres:18-alpine",
      "    ports:",
      "      - \"127.0.0.1:5432:5432\"",
      "    environment:",
      "      # Must match DATABASE_URL in .env",
      "      POSTGRES_PASSWORD: postgres",
      "      POSTGRES_DB: ${1:${WORKSPACE_NAME/[^A-Za-z0-9_]/_/g}}",
      "    healthcheck:",
      "      test: pg_isready -h 127.0.0.1 -U postgres",
      "      interval: 2s",
      "      retries: 15",
      "    volumes:",
      "      - db-data:/var/lib/postgresql",
      "",
      "volumes:",
      "  db-data:$0",
      ""
    ]
  },
  "Dockerfile for Svelte": {
    "scope": "dockerfile",
    "prefix": "docker::dockerfile",
    "isFileTemplate": true,
    "include": [ "Dockerfile", "*.Dockerfile" ],
    "description": "Dockerfile: multi-stage SvelteKit build with pnpm via corepack",
    "body": [
      "# syntax=docker/dockerfile:1.7",
      "FROM node:22-bookworm-slim AS base",
      "RUN npm install -g --force corepack@latest && corepack enable",
      "WORKDIR /app",
      "COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./",
      "",
      "",
      "FROM base AS deps",
      "RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store \\",
      "    pnpm install --frozen-lockfile",
      "",
      "",
      "FROM deps AS dev",
      "EXPOSE 5173 24678",
      "CMD [\"pnpm\", \"exec\", \"vite\", \"dev\", \"--host\", \"0.0.0.0\"]",
      "",
      "",
      "FROM deps AS builder",
      "COPY . .",
      "RUN pnpm run build",
      "RUN pnpm prune --prod",
      "",
      "",
      "FROM gcr.io/distroless/nodejs22-debian12:nonroot AS production",
      "WORKDIR /app",
      "COPY --from=builder --chown=nonroot:nonroot /app/build ./build",
      "COPY --from=builder --chown=nonroot:nonroot /app/node_modules ./node_modules",
      "COPY --from=builder --chown=nonroot:nonroot /app/package.json ./",
      "EXPOSE 3000",
      "ENV NODE_ENV=production",
      "ENV HOST=0.0.0.0",
      "ENV PORT=3000",
      "CMD [\"build/index.js\"]",
      ""
    ]
  },
  "Docker for BG": {
    "scope": "dockerfile",
    "prefix": "docker::docker-bg",
    "isFileTemplate": true,
    "include": [ "Dockerfile", "*.Dockerfile" ],
    "description": "Dockerfile: Bun and turbo prune build for the @r8y/bg app",
    "body": [
      "FROM oven/bun AS base",
      "",
      "FROM base AS prune",
      "RUN bun add -g turbo",
      "WORKDIR /app",
      "COPY . .",
      "RUN turbo prune @r8y/bg --docker",
      "",
      "FROM base AS install",
      "WORKDIR /app",
      "COPY --from=prune /app/out/json/ .",
      "RUN bun install --frozen-lockfile",
      "RUN ls -la >&2",
      "",
      "FROM base AS build",
      "WORKDIR /app",
      "COPY --from=install /app/node_modules ./node_modules",
      "COPY --from=prune /app/out/full/ .",
      "RUN bunx baml-cli generate --from ./packages/channel-sync/src/baml_src",
      "RUN bun build apps/bg/src/index.ts --compile --minify --outfile /app/worker",
      "",
      "FROM debian:stable-slim AS runtime",
      "RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*",
      "ENV NOTIFICATIONS_ENABLED=true",
      "COPY --from=build /app/worker /worker",
      "CMD [\"/worker\"]",
      "",
      ""
    ]
  },

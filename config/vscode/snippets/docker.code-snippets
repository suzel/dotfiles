  "Dockerfile for Rust": {
    "scope": "dockerfile",
    "prefix": "docker::dockerfile-rust",
    "isFileTemplate": true,
    "include": [ "Dockerfile", "*.Dockerfile" ],
    "description": "Dockerfile: multi-stage Rust build with cargo-chef into distroless nonroot",
    "body": [
      "# syntax=docker/dockerfile:1",
      "# TODO: add target/ to .dockerignore",
      "FROM rust:1.99-trixie AS chef",
      "RUN cargo install --locked cargo-chef@0.1.78",
      "WORKDIR /app",
      "",
      "",
      "FROM chef AS planner",
      "COPY . .",
      "RUN cargo chef prepare --recipe-path recipe.json",
      "",
      "",
      "FROM chef AS builder",
      "COPY --from=planner /app/recipe.json recipe.json",
      "# Dependencies only: this layer is reused until Cargo.toml or Cargo.lock change",
      "RUN --mount=type=cache,target=/usr/local/cargo/registry \\",
      "    --mount=type=cache,target=/usr/local/cargo/git \\",
      "    cargo chef cook --release --locked --recipe-path recipe.json",
      "COPY . .",
      "RUN --mount=type=cache,target=/usr/local/cargo/registry \\",
      "    --mount=type=cache,target=/usr/local/cargo/git \\",
      "    cargo build --release --locked --bin ${1:${WORKSPACE_NAME/([A-Z])|([^A-Za-z0-9_-])/${1:/downcase}${2:+-}/g}}",
      "",
      "",
      "FROM gcr.io/distroless/cc-debian13:nonroot AS runtime",
      "COPY --from=builder /app/target/release/$1 /usr/local/bin/$1",
      "ENTRYPOINT [\"/usr/local/bin/$1\"]$0",
      ""
    ]
  },

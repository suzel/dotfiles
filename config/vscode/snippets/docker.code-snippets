  "Docker Setup": {
    "scope": "json",
    "prefix": [ "docker::setup", "setup" ],
    "include": "**/package.json",
    "description": "Docker scripts in package.json \"scripts\" (docker::compose.yaml, docker::compose.dev.yaml in docker/); needs pnpm add -D @sveltejs/adapter-node + adapter in svelte.config.js",
    "body": [
      "\"docker:dev\": \"docker compose -f docker/compose.yaml -f docker/compose.dev.yaml up --build\",",
      "\"docker:up\": \"docker compose -f docker/compose.yaml up -d --build\",",
      "\"docker:down\": \"docker compose -f docker/compose.yaml down\",",
      "\"docker:logs\": \"docker compose -f docker/compose.yaml logs -f app\"$0"
    ]
  },
  "PostgREST init.sql": {
    "scope": "sql",
    "prefix": "docker::init.sql",
    "isFileTemplate": true,
    "include": "init.sql",
    "description": "docker/sql/init.sql: api schema, web_anon role and a todos table for PostgREST (docker::compose.postgrest.yaml)",
    "body": [
      "-- Schema",
      "",
      "create schema api;",
      "create role web_anon nologin;",
      "",
      "grant usage on schema api to web_anon;",
      "",
      "create table api.todos (",
      "  id   serial primary key,",
      "  done boolean not null default false,",
      "  task text    not null,",
      "  due  timestamptz",
      ");",
      "",
      "grant select on api.todos to web_anon;",
      "",
      "-- Data",
      "",
      "insert into api.todos (task) values",
      "  ('finish tutorial 0'), ('pat self on back');",
      ""
    ]
  }

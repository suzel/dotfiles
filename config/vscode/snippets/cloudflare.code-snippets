{
	"CF Wrangler": {
		"scope": "jsonc",
		"prefix": "cf::wrangler",
		"include": "wrangler.jsonc",
		"isFileTemplate": true,
		"description": "wrangler.jsonc for adapter-cloudflare with KV, D1, R2 and cron bindings",
		"body": [
			"{",
			"\t// TODO: `pnpm dlx sv add sveltekit-adapter=\"adapter:cloudflare\"` sets up wrangler, its scripts and the types; after every binding change: pnpm gen (wrangler types, the build checks it)",
			"\t// TODO: local dev emulates every binding below (vite dev); deploy: pnpm build && pnpm wrangler deploy (with cf::cron: wrangler deploy worker.ts)",
			"\t\"\\$schema\": \"node_modules/wrangler/config-schema.json\",",
			"\t\"name\": \"${1:my-app}\",",
			"\t// the adapter writes its worker to main on every build: keep it here, never point it at your own file",
			"\t\"main\": \".svelte-kit/cloudflare/_worker.js\",",
			"\t\"compatibility_date\": \"${2:$CURRENT_YEAR-$CURRENT_MONTH-$CURRENT_DATE}\",",
			"\t\"compatibility_flags\": [\"nodejs_als\"],",
			"\t\"assets\": { \"binding\": \"ASSETS\", \"directory\": \".svelte-kit/cloudflare\" },",
			"\t// cf::kv: wrangler kv namespace create CACHE",
			"\t\"kv_namespaces\": [{ \"binding\": \"CACHE\", \"id\": \"<id>\" }],",
			"\t// cf::d1: wrangler d1 create $1",
			"\t\"d1_databases\": [{ \"binding\": \"DB\", \"database_name\": \"$1\", \"database_id\": \"<id>\", \"migrations_dir\": \"drizzle\" }],",
			"\t// file::r2: wrangler r2 bucket create $1",
			"\t\"r2_buckets\": [{ \"binding\": \"BUCKET\", \"bucket_name\": \"$1\" }],",
			"\t// cf::cron: runs only through worker.ts (wrangler dev worker.ts, wrangler deploy worker.ts)",
			"\t\"triggers\": { \"crons\": [\"0 3 * * *\"] }",
			"}$0"
		]
	},
	"CF KV": {
		"scope": "typescript",
		"prefix": [
			"cf::kv",
			"kv"
		],
		"include": "**/lib/server/**",
		"exclude": "**/lib/server/db/schema/**",
		"description": "cached(): read-through cache in Workers KV with a TTL",
		"body": [
			"// TODO: needs a KV binding (cf::wrangler: kv_namespaces CACHE); import { env } from 'cloudflare:workers';",
			"/** The cached value, or load() once and keep it for ttl seconds (at least 60); KV is eventually consistent: other locations see it within ~60 s */",
			"export async function cached<T>(key: string, ttl: number, load: () => Promise<T>): Promise<T> {",
			"\tconst hit = await env.${1:CACHE}.get<T>(key, 'json');",
			"\tif (hit !== null) return hit;",
			"\tconst value = await load();",
			"\tawait env.$1.put(key, JSON.stringify(value), { expirationTtl: Math.max(60, ttl) });",
			"\treturn value;",
			"}$0"
		]
	},
	"CF D1": {
		"scope": "typescript",
		"prefix": "cf::d1",
		"include": "**/lib/server/db/index.ts",
		"isFileTemplate": true,
		"description": "src/lib/server/db/index.ts for Cloudflare D1 (drizzle d1 driver)",
		"body": [
			"import { building } from '\\$app/env';",
			"import { env } from 'cloudflare:workers';",
			"import { drizzle } from 'drizzle-orm/d1';",
			"import * as schema from './schema';",
			"",
			"// TODO: file: src/lib/server/db/index.ts; D1 binding ${1:DB} in wrangler.jsonc (cf::wrangler), then `wrangler types`",
			"// TODO: D1 is SQLite: tables use sqliteTable from 'drizzle-orm/sqlite-core' (drizzle::table and col::* are Postgres); drizzle.config.ts: dialect: 'sqlite'",
			"// TODO: migrations: pnpm drizzle-kit generate, then wrangler d1 migrations apply <database_name> --local (and --remote for production)",
			"",
			"// the build runs this module to analyse the routes, without Cloudflare's env: no client then",
			"export const db = building ? (undefined as never) : drizzle(env.$1, { schema });",
			""
		]
	},
	"CF Cron": {
		"scope": "typescript",
		"prefix": "cf::cron",
		"include": "worker.ts",
		"isFileTemplate": true,
		"description": "worker.ts: wraps the SvelteKit worker and sends Cron Triggers to /api/cron",
		"body": [
			"// @ts-ignore: SvelteKit's build output, typed only after a build",
			"import sveltekit from './.svelte-kit/cloudflare/_worker.js';",
			"",
			"// TODO: file: worker.ts in the project root; wrangler.jsonc: \"triggers\": { \"crons\": [\"${1:0 3 * * *}\"] }, \"main\" stays on the adapter's worker (the build overwrites whatever main points to)",
			"// TODO: run this file instead of main: package.json \"preview\": \"wrangler dev worker.ts --port 4173\", \"deploy\": \"wrangler deploy worker.ts\" (Workers Builds: same deploy command)",
			"// TODO: secret: CRON_SECRET in .dev.vars (local) and `wrangler secret put CRON_SECRET`; the job: cf::cron-job (src/routes/api/cron/+server.ts)",
			"// TODO: test locally: pnpm build && pnpm wrangler dev worker.ts --test-scheduled, then curl \"http://localhost:8787/__scheduled?cron=$1\"",
			"// SvelteKit's worker only has fetch: this wraps it and sends each cron run to a SvelteKit route, where \\$app/server, the db and env work as usual",
			"",
			"export default {",
			"\tfetch: sveltekit.fetch,",
			"\tasync scheduled(controller, env, ctx) {",
			"\t\tconst request = new Request('https://cron.internal/api/cron', {",
			"\t\t\tmethod: 'POST',",
			"\t\t\t// JSON: SvelteKit's CSRF check blocks POSTs without a content-type from no origin",
			"\t\t\theaders: { authorization: `Bearer \\${env.CRON_SECRET}`, 'content-type': 'application/json' },",
			"\t\t\tbody: JSON.stringify({ cron: controller.cron })",
			"\t\t});",
			"\t\tctx.waitUntil(sveltekit.fetch(request, env, ctx));",
			"\t}",
			"} satisfies ExportedHandler<Env>;",
			""
		]
	},
	"CF Cron Job": {
		"scope": "typescript",
		"prefix": "cf::cron-job",
		"include": "**/api/cron/+server.ts",
		"isFileTemplate": true,
		"description": "POST /api/cron endpoint run by cf::cron, protected by CRON_SECRET",
		"body": [
			"import { error } from '@sveltejs/kit';",
			"import { CRON_SECRET } from '\\$app/env/private';",
			"import type { RequestHandler } from './\\$types';",
			"",
			"// TODO: file: src/routes/api/cron/+server.ts; called by cf::cron (worker.ts); src/env.ts: CRON_SECRET: { schema: (value) => value, description: 'openssl rand -hex 32' } (optional: builds run without secrets; unset = every call is a 401)",
			"",
			"export const POST: RequestHandler = async ({ request }) => {",
			"\tif (!CRON_SECRET || request.headers.get('authorization') !== `Bearer \\${CRON_SECRET}`) error(401, 'Unauthorized');",
			"\tconst { cron } = (await request.json()) as { cron: string };",
			"",
			"\t${1:// the job, e.g. delete expired rows}$0",
			"\tconsole.info('[cron]', cron, 'done');",
			"\treturn new Response(null, { status: 204 });",
			"};",
			""
		]
	}
}

	"SEO Head": {
		"scope": "svelte",
		"prefix": "seo::head",
		"include": "Seo.svelte",
		"isFileTemplate": true,
		"description": "SEO component (src/lib/components/Seo.svelte): title, description, canonical, Open Graph and JSON-LD from page data",
		"body": [
			"<script module lang=\"ts\">",
			"\t/** What a page can set in its load: return { seo: { title: post.title } } */",
			"\texport type Seo = {",
			"\t\ttitle?: string;",
			"\t\tdescription?: string;",
			"\t\t/** path in static/ or a full URL, 1200×630 */",
			"\t\timage?: string;",
			"\t\tnoindex?: boolean;",
			"\t\t/** schema.org objects for this page, e.g. { '@type': 'Article', headline: post.title } */",
			"\t\tjsonld?: Record<string, unknown> | Record<string, unknown>[];",
			"\t};",
			"</script>",
			"",
			"<script lang=\"ts\">",
			"\timport { page } from '\\$app/state';",
			"",
			"\t// TODO: src/routes/+layout.svelte: <Seo /> once (import Seo from '#lib/components/Seo.svelte')",
			"\t// TODO: src/app.d.ts: namespace App { interface PageData { seo?: import('#lib/components/Seo.svelte').Seo } } so page loads are type-checked",
			"\t// TODO: default share image in static/og.png (1200×630)",
			"\t// ponytail: JSON-LD is untyped; pnpm add -D schema-dts and use its Thing type if you want the fields checked",
			"",
			"\tconst site = { name: '${1:Site}', description: '${2:A site built with SvelteKit.}', image: '/og.png' };",
			"",
			"\tconst seo: Seo = \\$derived(page.data.seo ?? {});",
			"\tconst title = \\$derived(",
			"\t\tpage.error ? `\\${page.status} | \\${site.name}` : seo.title ? `\\${seo.title} | \\${site.name}` : site.name",
			"\t);",
			"\tconst description = \\$derived(seo.description ?? site.description);",
			"\tconst image = \\$derived(new URL(seo.image ?? site.image, page.url.origin).href);",
			"\tconst canonical = \\$derived(page.url.origin + page.url.pathname);",
			"\tconst org = \\$derived(`\\${page.url.origin}/#org`);",
			"\tconst jsonld = \\$derived(",
			"\t\tJSON.stringify({",
			"\t\t\t'@context': 'https://schema.org',",
			"\t\t\t'@graph': [",
			"\t\t\t\t{ '@type': 'Organization', '@id': org, name: site.name, url: page.url.origin },",
			"\t\t\t\t{ '@type': 'WebSite', name: site.name, url: page.url.origin, publisher: { '@id': org } },",
			"\t\t\t\t...[seo.jsonld ?? []].flat()",
			"\t\t\t]",
			"\t\t}).replaceAll('<', '\\\\\\\\u003c') // a closing script tag inside a value can't end the tag early",
			"\t);",
			"</script>",
			"",
			"<svelte:head>",
			"\t<title>{title}</title>",
			"\t<meta name=\"description\" content={description} />",
			"\t<link rel=\"canonical\" href={canonical} />",
			"\t{#if page.error || seo.noindex}",
			"\t\t<meta name=\"robots\" content=\"noindex\" />",
			"\t{/if}",
			"\t<meta property=\"og:type\" content=\"website\" />",
			"\t<meta property=\"og:site_name\" content={site.name} />",
			"\t<meta property=\"og:title\" content={title} />",
			"\t<meta property=\"og:description\" content={description} />",
			"\t<meta property=\"og:url\" content={canonical} />",
			"\t<meta property=\"og:image\" content={image} />",
			"\t<meta name=\"twitter:card\" content=\"summary_large_image\" />",
			"\t<!-- eslint-disable-next-line svelte/no-at-html-tags -->",
			"\t{@html `<script type=\"application/ld+json\">\\${jsonld}<\\u002fscript>`}",
			"</svelte:head>",
			""
		]
	},

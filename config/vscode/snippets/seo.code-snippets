			"<script lang=\"ts\">",
			"\timport { dev } from '\\$app/env';",
			"\timport { PUBLIC_GA_ID } from '\\$app/env/public';",
			"",
			"\t// TODO: src/env.ts: PUBLIC_GA_ID: { public: true, static: true, schema: (value) => value } (optional: no tracking while unset); value in .env",
			"\t// TODO: src/routes/+layout.svelte: <Analytics /> once (import Analytics from '#lib/components/Analytics.svelte')",
			"\t// TODO: with csp::config: 'script-src' needs https://www.googletagmanager.com, 'connect-src' needs https://*.google-analytics.com",
			"\t// ponytail: no cookie consent banner; add one before tracking visitors from the EU",
			"",
			"\tconst enabled = !dev && Boolean(PUBLIC_GA_ID);",
			"",
			"\t\\$effect(() => {",
			"\t\tif (!enabled) return;",
			"\t\tconst w: Window & { dataLayer?: unknown[] } = window;",
			"\t\tconst dataLayer = (w.dataLayer ??= []);",
			"\t\tconst gtag: (...args: unknown[]) => void = function () {",
			"\t\t\t// gtag.js reads the arguments object itself, an array would not work",
			"\t\t\tdataLayer.push(arguments);",
			"\t\t};",
			"\t\tgtag('js', new Date());",
			"\t\tgtag('config', PUBLIC_GA_ID);",
			"\t});",
			"</script>",
			"",
			"<svelte:head>",
			"\t{#if enabled}",
			"\t\t<script async src=\"https://www.googletagmanager.com/gtag/js?id={PUBLIC_GA_ID}\"></script>",
			"\t{/if}",
			"</svelte:head>",

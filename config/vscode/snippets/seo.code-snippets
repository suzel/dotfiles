	"SEO OG Image": {
		"scope": "typescript",
		"prefix": "seo::og-image",
		"include": "**/og.png/+server.ts",
		"isFileTemplate": true,
		"description": "og.png endpoint: a 1200×630 share image with the page title (satori + resvg)",
		"body": [
			"import { Resvg } from '@resvg/resvg-js';",
			"import satori from 'satori';",
			"import { read } from '\\$app/server';",
			"import font from '@fontsource/inter/files/inter-latin-700-normal.woff';",
			"import type { RequestHandler } from './\\$types';",
			"",
			"// TODO: file: src/routes/og.png/+server.ts; pnpm add satori @resvg/resvg-js @fontsource/inter (satori needs woff/ttf, not woff2)",
			"// TODO: seo::head: return { seo: { title, image: `/og.png?title=\\${encodeURIComponent(title)}` } } from the page's load",
			"// ponytail: @resvg/resvg-js is native (Node); on Cloudflare use @resvg/resvg-wasm",
			"",
			"const fontData = await read(font).arrayBuffer();",
			"",
			"export const GET: RequestHandler = async ({ url }) => {",
			"\tconst title = url.searchParams.get('title')?.slice(0, 120) || '${1:Site}';",
			"",
			"\t// satori takes React-like nodes; flexbox only, every div with more than one child needs display: flex",
			"\tconst svg = await satori(",
			"\t\t{",
			"\t\t\ttype: 'div',",
			"\t\t\tkey: null,",
			"\t\t\tprops: {",
			"\t\t\t\tstyle: {",
			"\t\t\t\t\twidth: '100%',",
			"\t\t\t\t\theight: '100%',",

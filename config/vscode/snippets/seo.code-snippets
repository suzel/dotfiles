	"SEO Sitemap": {
		"scope": "typescript",
		"prefix": "seo::sitemap",
		"include": "**/sitemap.xml/+server.ts",
		"isFileTemplate": true,
		"description": "sitemap.xml endpoint listing every page without parameters ($app/manifest routes)",
		"body": [
			"import { routes } from '\\$app/manifest';",
			"import type { RequestHandler } from './\\$types';",
			"",
			"// TODO: file: src/routes/sitemap.xml/+server.ts (a route group like (meta) is fine)",
			"// TODO: pages with parameters ([slug]) are skipped: add their paths from the database, e.g. posts.map((p) => `/blog/\\${p.slug}`)",
			"// TODO: adapter-static: add `export const prerender = true;` and sveltekit({ paths: { origin: 'https://example.com' } }) in vite.config.ts (url.origin while prerendering)",
			"",
			"// pages without parameters; route groups like (app) are not part of the URL",
			"const paths = routes",
			"\t.filter((route) => route.page && !route.id.includes('['))",
			"\t.map((route) => route.id.replace(/\\/\\([^)]+\\)/g, '') || '/')",
			"\t.filter((path) => !/^\\/(${1:admin|account|login})(\\/|\\$)/.test(path));",
			"",
			"export const GET: RequestHandler = ({ url }) => {",
			"\tconst xml = [",
			"\t\t'<?xml version=\"1.0\" encoding=\"UTF-8\"?>',",
			"\t\t'<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\">',",
			"\t\t...paths.map((path) => `  <url><loc>\\${url.origin}\\${path}</loc></url>`),",
			"\t\t'</urlset>'",
			"\t].join('\\n');",
			"",
			"\treturn new Response(xml, {",
			"\t\theaders: { 'content-type': 'application/xml; charset=utf-8', 'cache-control': 'public, max-age=3600' }",
			"\t});",
			"};",
			""
		]
	},
	"SEO RSS": {
		"scope": "typescript",
		"prefix": "seo::rss",
		"include": "**/rss.xml/+server.ts",
		"isFileTemplate": true,
		"description": "rss.xml feed of the latest rows of a drizzle table",
		"body": [
			"import { desc } from 'drizzle-orm';",
			"import { db } from '#lib/server/db/index.ts';",
			"import { ${1:post} } from '#lib/server/db/schema/${1}.ts';",
			"import type { RequestHandler } from './\\$types';",
			"",
			"// TODO: file: src/routes/rss.xml/+server.ts; ${1} needs title, slug, ${2:excerpt} and createdAt columns",
			"// TODO: announce it in the root layout's <svelte:head>: <link rel=\"alternate\" type=\"application/rss+xml\" title=\"${3:Blog}\" href=\"/rss.xml\" />",
			"",
			"// titles and text can contain & < > which would break the XML",
			"const escape = (text: string) =>",
			"\ttext.replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;');",
			"",
			"export const GET: RequestHandler = async ({ url }) => {",
			"\tconst rows = await db.select().from($1).orderBy(desc($1.createdAt)).limit(20);",
			"",
			"\tconst items = rows.map((row) => {",
			"\t\tconst link = `\\${url.origin}/${4:blog}/\\${row.slug}`;",
			"\t\treturn [",
			"\t\t\t'<item>',",
			"\t\t\t`<title>\\${escape(row.title)}</title>`,",
			"\t\t\t`<link>\\${link}</link>`,",
			"\t\t\t`<guid>\\${link}</guid>`,",
			"\t\t\t`<pubDate>\\${row.createdAt.toUTCString()}</pubDate>`,",
			"\t\t\t`<description>\\${escape(row.$2)}</description>`,",
			"\t\t\t'</item>'",
			"\t\t].join('');",
			"\t});",
			"",
			"\tconst xml = [",
			"\t\t'<?xml version=\"1.0\" encoding=\"UTF-8\"?>',",
			"\t\t'<rss version=\"2.0\" xmlns:atom=\"http://www.w3.org/2005/Atom\"><channel>',",
			"\t\t'<title>$3</title>',",
			"\t\t'<description>${5:Latest posts}</description>',",
			"\t\t`<link>\\${url.origin}/</link>`,",
			"\t\t`<atom:link href=\"\\${url.origin}/rss.xml\" rel=\"self\" type=\"application/rss+xml\" />`,",
			"\t\t...items,",
			"\t\t'</channel></rss>'",
			"\t].join('\\n');",
			"",
			"\treturn new Response(xml, {",
			"\t\theaders: { 'content-type': 'application/rss+xml; charset=utf-8', 'cache-control': 'public, max-age=3600' }",
			"\t});",
			"};",
			""
		]
	},

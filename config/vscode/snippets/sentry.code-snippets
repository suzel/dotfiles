{
  "Sentry Client": {
    "scope": "typescript",
    "prefix": "sentry::client",
    "include": "hooks.client.ts",
    "isFileTemplate": true,
    "description": "src/hooks.client.ts: Sentry in the browser (errors, tracing, session replay)",
    "body": [
      "import * as Sentry from '@sentry/sveltekit';",
      "import { PUBLIC_SENTRY_DSN } from '\\$app/env/public';",
      "",
      "// TODO: pnpm add @sentry/sveltekit (dependencies); the rest of the setup: sentry::server (Cloudflare: sentry::cloudflare), sentry::hooks, sentry::vite",
      "// TODO: src/env.ts: PUBLIC_SENTRY_DSN: { public: true, static: true, schema: (value) => value } (optional: no DSN = Sentry off); value: Sentry → Project Settings → Client Keys (DSN)",
      "// TODO: with csp::config: 'connect-src' needs https://*.ingest.sentry.io (EU: https://*.ingest.de.sentry.io), Replay needs 'worker-src': ['self', 'blob:']",
      "",
      "Sentry.init({",
      "\tdsn: PUBLIC_SENTRY_DSN,",
      "",
      "\t// 1.0 captures 100% of transactions for tracing; lower it in production",
      "\ttracesSampleRate: ${1:1.0},",
      "",
      "\tintegrations: [Sentry.replayIntegration()],",
      "",
      "\t// Replay for 10% of all sessions (0.1), plus 100% of sessions with an error",
      "\treplaysSessionSampleRate: ${2:0.1},",
      "\treplaysOnErrorSampleRate: 1.0",
      "});",
      "",
      "export const handleError = Sentry.handleErrorWithSentry();$0",
    ],
  },
  "Sentry Server": {
    "scope": "typescript",
    "prefix": "sentry::server",
    "include": "instrumentation.server.ts",
    "isFileTemplate": true,
    "description": "src/instrumentation.server.ts: Sentry on the server, Node adapters",
    "body": [
      "import * as Sentry from '@sentry/sveltekit';",
      "import { PUBLIC_SENTRY_DSN } from '\\$app/env/public';",
      "",
      "// TODO: Node adapters (adapter-node, adapter-vercel); adapter-cloudflare: no instrumentation file, use sentry::cloudflare in hooks.server.ts",
      "// TODO: replaces kit::instrumentation: the Sentry SDK sets up OpenTelemetry itself",
      "// TODO: spans for load, form actions and remote functions: vite.config.ts → sveltekit({ tracing: { server: true } })",
      "// TODO: by default user info, request headers, cookies, bodies and query params are sent (password-like keys become [Filtered]); send less with dataCollection, e.g. { userInfo: false }",
      "",
      "Sentry.init({",
      "\tdsn: PUBLIC_SENTRY_DSN,",
      "",
      "\t// 1.0 captures 100% of transactions for tracing; lower it in production",
      "\ttracesSampleRate: ${1:1.0}",
      "});$0",
    ],
  },
  "Sentry Hooks": {
    "scope": "typescript",
    "prefix": ["sentry::hooks", "hooks"],
    "include": "hooks.server.ts",
    "description": "handleError hook with Sentry: errorId is the Sentry event id, details never reach the client",
    "body": [
      "// TODO: imports: * as Sentry from '@sentry/sveltekit'; type { HandleServerError } from '@sveltejs/kit/hooks'",
      "// TODO: Sentry.sentryHandle() goes first: export const handle = sequence(Sentry.sentryHandle(), handleBetterAuth) (Cloudflare: sentry::cloudflare)",
      "// TODO: replaces kit::handle-error; src/app.d.ts: namespace App { interface Error { errorId?: string } } (optional, so error(404, 'Not found') keeps working)",
      "// Sentry captures unknown errors and 5xx before this runs, so errorId is the Sentry event id: search it in Sentry",
      "export const handleError: HandleServerError = Sentry.handleErrorWithSentry(({ kind, error, event }) => {",
      "\t// app (error(...)), framework (404, 405...) and validation errors are safe to show as they are",
      "\tif (kind !== 'unknown') return;",
      "",
      "\tconst errorId = Sentry.lastEventId() ?? crypto.randomUUID();",
      "\tconsole.error(`[\\${errorId}]`, event.request.method, event.url.pathname, error);",
      "\t// status and message stay 500 / 'Internal Error': internal details never reach the client",
      "\treturn { errorId };",
      "});$0",
    ],
  },
  "Sentry Cloudflare": {
    "scope": "typescript",
    "prefix": ["sentry::cloudflare", "cloudflare"],
    "include": "hooks.server.ts",
    "description": "handle hook: Sentry on adapter-cloudflare (initCloudflareSentryHandle + sentryHandle)",
    "body": [
      "// TODO: imports: * as Sentry from '@sentry/sveltekit'; { sequence } from '@sveltejs/kit/hooks'; { PUBLIC_SENTRY_DSN } from '\\$app/env/public'",
      "// TODO: export const handle = sequence(handleSentry, handleBetterAuth); no instrumentation.server.ts (sentry::server) on Cloudflare",
      "// TODO: wrangler.jsonc (cf::wrangler): \"compatibility_flags\": [\"nodejs_compat\"] instead of nodejs_als, compatibility_date 2024-09-23 or later; release detection: \"version_metadata\": { \"binding\": \"CF_VERSION_METADATA\" }",
      "const handleSentry = sequence(",
      "\tSentry.initCloudflareSentryHandle({",
      "\t\tdsn: PUBLIC_SENTRY_DSN,",
      "",
      "\t\t// 1.0 captures 100% of transactions for tracing; lower it in production",
      "\t\ttracesSampleRate: ${1:1.0}",
      "\t}),",
      "\tSentry.sentryHandle()",
      ");$0",
    ],
  },
  "Sentry Vite Plugin": {
    "scope": "typescript",
    "prefix": ["sentry::vite", "vite"],
    "include": "vite.config.ts",
    "description": "sentrySvelteKit() in vite.config.ts plugins: source map upload only with SENTRY_AUTH_TOKEN, no telemetry",
    "body": [
      "// TODO: import { sentrySvelteKit } from '@sentry/sveltekit/vite'; goes in plugins before sveltekit()",
      "// TODO: SENTRY_AUTH_TOKEN (Sentry → Settings → Auth Tokens) as a CI secret or in the shell: Vite doesn't load .env into process.env in this file",
      "// uploads source maps for readable stack traces; without a token none are made (Sentry would otherwise leave them public in build/client)",
      "sentrySvelteKit({",
      "\torg: '${1:org-slug}',",
      "\tproject: '${2:project-slug}',",
      "\tauthToken: process.env.SENTRY_AUTH_TOKEN,",
      "\tautoUploadSourceMaps: Boolean(process.env.SENTRY_AUTH_TOKEN),",
      "\ttelemetry: false",
      "}),$0",
    ],
  },
}

{
	"Postgres Grants": {
		"scope": "sql",
		"prefix": "pg::grants",
		"description": "app_user role for RLS with table and sequence grants, now and for later tables; run once per database",
		"body": [
			"-- app_user: withUser (drizzle::rls) switches to it, so RLS policies apply",
			"do \\$\\$",
			"begin",
			"\tcreate role app_user nologin;",
			"exception when duplicate_object then",
			"\t-- roles are cluster-wide: another database may have created it",
			"\tnull;",
			"end",
			"\\$\\$;",
			"",
			"-- lets the app's login role run `set role app_user`",
			"grant app_user to current_user;",
			"",
			"grant usage on schema public to app_user;",
			"grant select, insert, update, delete on all tables in schema public to app_user;",
			"grant usage on all sequences in schema public to app_user;",
			"",
			"-- tables and sequences this role creates later get the same grants",
			"alter default privileges in schema public grant select, insert, update, delete on tables to app_user;",
			"alter default privileges in schema public grant usage on sequences to app_user;",
			"$0"
		]
	},
	"Postgres Policy Owned": {
		"scope": "sql",
		"prefix": "pg::policy-owned",
		"description": "Enables RLS on a table with an owner-only policy; role app_user (withUser) or authenticated (Supabase)",
		"body": [
			"-- table owners and superusers skip these policies",
			"-- (select …) runs once per query instead of once per row",
			"alter table ${1:notes} enable row level security;",
			"",
			"create policy ${1}_owner on $1 for all to ${2|app_user,authenticated|}",
			"\tusing (${3:user_id} = ${2/(app_user)|(authenticated)/${1:+(select current_setting('app.user_id', true))}${2:+(select auth.uid())}/})",
			"\twith check ($3 = ${2/(app_user)|(authenticated)/${1:+(select current_setting('app.user_id', true))}${2:+(select auth.uid())}/});",
			"$0"
		]
	},
	"Postgres RLS Test": {
		"scope": "sql",
		"prefix": "pg::rls-test",
		"description": "Queries a table as one app_user user inside a rolled-back transaction, to check its policies",
		"body": [
			"-- the select shows only what the policies let this user see; rollback undoes everything",
			"begin;",
			"select set_config('app.user_id', '${1:user-id}', true);",
			"set local role app_user;",
			"select * from ${2:notes};$0",
			"rollback;",
			""
		]
	}
}

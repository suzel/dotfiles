      "import { z } from 'zod';",
      "import { badRequest, pageQuery, readJson, requireApiUser } from '#lib/server/api.ts';",
      "import { db } from '#lib/server/db/index.ts';",
      "import { ${1:note}, ${1}InsertSchema } from '#lib/server/db/schema/${1}.ts';",
      "import type { RequestHandler } from './\\$types';",

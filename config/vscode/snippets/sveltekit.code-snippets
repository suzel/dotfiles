      "",
      "// ?sort=&order=: only the columns listed here can be sorted",
      "const listQuery = pageQuery.extend({",
      "\tsort: z.enum(['createdAt', '${2:name}']).default('createdAt'),",
      "\torder: z.enum(['asc', 'desc']).default('desc')",
      "});",
      "",
      "export const GET: RequestHandler = async ({ url }) => {",
      "\tconst user = requireApiUser();",
      "\tconst query = listQuery.safeParse(Object.fromEntries(url.searchParams));",
      "\tif (!query.success) return badRequest(query.error);",
      "\tconst { limit, offset, q, sort, order } = query.data;",
      "",
      "\tconst where = and(eq($1.userId, user.id), q ? ilike($1.$2, `%\\${q}%`) : undefined);",
      "\t// id breaks ties, so rows with equal values keep their page",
      "\tconst sortBy = order === 'asc' ? asc($1[sort]) : desc($1[sort]);",
      "\tconst [items, total] = await Promise.all([",
      "\t\tdb.select().from($1).where(where).orderBy(sortBy, asc($1.id)).limit(limit).offset(offset),",
      "\t\tdb.\\$count($1, where)",

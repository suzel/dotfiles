      "\t<title>${1/(.*)/${1:/capitalize}/}s</title>",
      "</svelte:head>",
      "",
      "<svelte:boundary>",
      "\t<ul>",
      "\t\t{#each await get${1/(.*)/${1:/pascalcase}/}s() as $1 ($1.id)}",
      "\t\t\t<li>",
      "\t\t\t\t{$1.${2:name}}",
      "\t\t\t\t<button onclick={() => delete${1/(.*)/${1:/pascalcase}/}($1.id)}>Delete</button>",
      "\t\t\t</li>",
      "\t\t{/each}",
      "\t</ul>",
      "",
      "\t{#snippet pending()}",
      "\t\t<p>Loading...</p>",
      "\t{/snippet}",
      "",
      "\t{#snippet failed(_error, reset)}",
      "\t\t<p>Something went wrong.</p>",
      "\t\t<button onclick={reset}>Retry</button>",
      "\t{/snippet}",
      "</svelte:boundary>",
      "",
    ],
  },

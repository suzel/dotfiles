  "Kit Require Login": {
    "scope": "typescript",
    "prefix": "kit::require-login",
    "include": "**/lib/server/**",
    "exclude": "**/lib/server/db/**",
    "isFileTemplate": true,
    "description": "requireLogin() helper for load functions and actions",
    "body": [
      "import { redirect } from '@sveltejs/kit';",
      "import { getRequestEvent } from '\\$app/server';",
      "",
      "// TODO: not for remote queries (event.url throws there): use remote::guard",
      "// TODO: on the login page, only follow redirectTo if it starts with '/' and not '//'",
      "",
      "export function requireLogin() {",
      "\tconst { locals, url } = getRequestEvent();",
      "\tif (!locals.user) {",
      "\t\tredirect(303, `${1:/login}?\\${new URLSearchParams({ redirectTo: url.pathname + url.search })}`);",
      "\t}",
      "\treturn locals.user;",
      "}",
      "",
    ],
  },

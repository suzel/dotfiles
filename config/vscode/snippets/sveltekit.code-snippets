  "API Idempotency": {
    "scope": "typescript",
    "prefix": ["api::idempotency", "idempotency"],
    "include": "**/lib/server/**",
    "exclude": "**/lib/server/db/schema/**",
    "description": "idempotent(): a retried POST with the same Idempotency-Key gets the first reply",
    "body": [
      "// ponytail: in memory, one server; with several instances keep the replies in Redis or a table",
      "const replies = new Map<string, { expires: number; reply: Promise<{ status: number; body: string }> }>();",
      "",
      "/** A POST retried with the same Idempotency-Key header (per user, 24 h) gets the first reply instead of running twice */",
      "export async function idempotent(handler: () => Promise<Response>) {",
      "\tconst { request, locals } = getRequestEvent();",
      "\tconst key = request.headers.get('idempotency-key');",
      "\tif (!key) return handler();",
      "",
      "\tconst id = `\\${locals.user?.id ?? ''}:\\${key}`;",
      "\tconst now = Date.now();",
      "\tfor (const [k, v] of replies) if (v.expires < now) replies.delete(k);",
      "",
      "\tlet entry = replies.get(id);",
      "\tif (!entry) {",
      "\t\t// stored before awaiting: a retry that arrives while the first request runs waits for the same reply",
      "\t\tconst reply = handler().then(async (r) => ({ status: r.status, body: await r.text() }));",
      "\t\tentry = { expires: now + 86_400_000, reply };",
      "\t\treplies.set(id, entry);",
      "\t\t// thrown errors (error(401), crashes) are not kept: the client may retry",
      "\t\treply.catch(() => replies.delete(id));",
      "\t}",
      "\tconst { status, body } = await entry.reply;",
      "\treturn new Response(body, { status, headers: { 'content-type': 'application/json' } });",
      "}$0",
    ],
  },

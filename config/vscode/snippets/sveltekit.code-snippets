    "body": [
      "// TODO: export const handle = sequence(handleRateLimit, handleBetterAuth, ...)",
      "// TODO: behind a proxy set adapter-node's ADDRESS_HEADER, otherwise every client shares one IP",
      "// in-memory: works on a single server; with several instances use Redis, on Cloudflare cf::rate-limit",
      "const hits = new Map<string, { count: number; reset: number }>();",
      "",
      "const handleRateLimit: Handle = ({ event, resolve }) => {",
      "\tconst { method } = event.request;",
      "\tif (method === 'GET' || method === 'HEAD') return resolve(event);",
      "",
      "\tconst key = event.getClientAddress();",
      "\tconst now = Date.now();",
      "\tif (hits.size > 10_000) for (const [k, v] of hits) if (v.reset < now) hits.delete(k);",
      "",
      "\tconst hit = hits.get(key);",
      "\tif (!hit || hit.reset < now) {",
      "\t\thits.set(key, { count: 1, reset: now + ${1:60_000} });",
      "\t} else if (++hit.count > ${2:30}) {",
      "\t\tconst retryAfter = String(Math.ceil((hit.reset - now) / 1000));",
      "\t\treturn Response.json(",
      "\t\t\t{ message: 'Too many requests' },",
      "\t\t\t{ status: 429, headers: { 'retry-after': retryAfter } }",
      "\t\t);",
      "\t}",
      "\treturn resolve(event);",
      "};$0",
    ],

			"\t['year', 31_536_000],",
			"\t['month', 2_592_000],",
			"\t['week', 604_800],",
			"\t['day', 86_400],",
			"\t['hour', 3_600],",
			"\t['minute', 60]",
			"] as const;",
			"/** timeAgo(date) → \"3 days ago\", \"in 2 hours\", \"now\"; changes with time: render it in the browser or it can differ from the server's text */",
			"export function timeAgo(date: Date | string | number, now = Date.now()) {",
			"\tconst seconds = (new Date(date).getTime() - now) / 1000;",
			"\tfor (const [unit, size] of units) {",
			"\t\tif (Math.abs(seconds) >= size) return relativeFormat.format(Math.round(seconds / size), unit);",
			"\t}",
			"\treturn relativeFormat.format(0, 'second');",
			"}$0"
		]
	},
	"Util Money": {
		"scope": "typescript",
		"prefix": [
			"util::money",
			"money"
		],
		"include": "**/lib/**",
		"exclude": [
			"**/lib/server/db/**"
		],
		"description": "formatMoney(): integer cents to a currency string with Intl",
		"body": [
			"// TR: 'tr-TR' + 'TRY' → \"₺1.234,50\"; the same locale formats numbers and metric units: \"1.234,5\", \"%25\" (sign first), \"5 km\", \"21°C\", \"2,5 kg\" ({ style: 'unit', unit: 'kilometer' })",
			"const moneyFormat = new Intl.NumberFormat('${1:en-US}', { style: 'currency', currency: '${2:USD}' });",
			"// minor units per currency: 2 for USD/EUR/TRY, 0 for JPY",
			"const minorUnits = 10 ** (moneyFormat.resolvedOptions().maximumFractionDigits ?? 2);",
			"/** Amounts are stored as integers in the smallest unit (cents) to avoid float rounding: formatMoney(1999) → \"\\$19.99\" */",
			"export const formatMoney = (cents: number) => moneyFormat.format(cents / minorUnits);$0"
		]
	},
	"Util Debounce": {
		"scope": "typescript",
		"prefix": [
			"util::debounce",
			"debounce"
		],
		"include": "**/lib/**",
		"exclude": [
			"**/lib/server/db/**"
		],
		"description": "debounce(): run a function once calls stop (search as you type)",
		"body": [
			"/** Runs fn once the calls stop for ms milliseconds, e.g. search as you type: oninput={debounce((e) => …, ${1:300})} */",
			"export function debounce<A extends unknown[]>(fn: (...args: A) => void, ms = $1) {",
			"\tlet timer: ReturnType<typeof setTimeout> | undefined;",
			"\treturn (...args: A) => {",
			"\t\tclearTimeout(timer);",
			"\t\ttimer = setTimeout(() => fn(...args), ms);",
			"\t};",
			"}$0"
		]
	},
	"HTTP API Requests": {
		"scope": "http",
		"prefix": "api::http",
		"include": "*.http",
		"isFileTemplate": true,
		"description": "REST Client file for a DB API (api::db-list/item): better-auth login, list, create, get, update, delete",
		"body": [
			"# TODO: REST Client (humao.rest-client): click \"Send Request\" above a request; run \"login\" first, the others reuse its token, \"get/update/delete\" use the id from \"create\"",
			"# TODO: .env (REST Client finds it walking up from this file): API_TEST_EMAIL, API_TEST_PASSWORD of an existing user",
			"# TODO: Bearer needs better-auth's bearer() plugin (see api::helpers); endpoints come from api::db-list and api::db-item",
			"",
			"@baseUrl = ${1:http://localhost:5173}",
			"@token = {{login.response.headers.set-auth-token}}",
			"@id = {{create.response.body.\\$.id}}",
			"",
			"### Login → set-auth-token header",
			"# @name login",
			"POST {{baseUrl}}/api/auth/sign-in/email",
			"Content-Type: application/json",
			"",
			"{",
			"\t\"email\": \"{{\\$dotenv API_TEST_EMAIL}}\",",
			"\t\"password\": \"{{\\$dotenv API_TEST_PASSWORD}}\"",
			"}",
			"",
			"### List: ?limit=&offset=&q=&sort=&order=",
			"GET {{baseUrl}}/api/${2:tag}s?limit=20&order=desc",
			"",
			"### Create → 201",
			"# @name create",
			"POST {{baseUrl}}/api/$2s",
			"Authorization: Bearer {{token}}",
			"Content-Type: application/json",
			"",
			"{",
			"\t\"${3:name}\": \"${4:value}\"",
			"}",
			"",
			"### Get one",
			"GET {{baseUrl}}/api/$2s/{{id}}",
			"",
			"### Update",
			"PATCH {{baseUrl}}/api/$2s/{{id}}",
			"Authorization: Bearer {{token}}",
			"Content-Type: application/json",
			"",
			"{",
			"\t\"$3\": \"${5:new value}\"",
			"}",
			"",
			"### Delete → 204. Keep content-type even without a body: SvelteKit's CSRF check answers 403 otherwise (build only)",
			"DELETE {{baseUrl}}/api/$2s/{{id}}",
			"Authorization: Bearer {{token}}",
			"Content-Type: application/json",
			"$0"
		]
	},
	"HTTP Supabase Requests": {
		"scope": "http",
		"prefix": "api::http-supabase",
		"include": "*.http",
		"isFileTemplate": true,
		"description": "REST Client file for Supabase: sign up, login, PostgREST list/filter/create/update/delete with the user token",
		"body": [
			"# TODO: REST Client (humao.rest-client): click \"Send Request\" above a request; run \"login\" before the requests that use {{token}}, \"update/delete\" use the id from \"create\"",
			"# TODO: .env (REST Client finds it walking up from this file): PUBLIC_SUPABASE_URL, PUBLIC_SUPABASE_PUBLISHABLE_KEY, API_TEST_EMAIL, API_TEST_PASSWORD",
			"# TODO: requests with {{token}} run as that user, so RLS policies apply; the anonymous list shows what logged-out visitors see",
			"",
			"@url = {{\\$dotenv PUBLIC_SUPABASE_URL}}",
			"@key = {{\\$dotenv PUBLIC_SUPABASE_PUBLISHABLE_KEY}}",
			"@token = {{login.response.body.\\$.access_token}}",
			"@id = {{create.response.body.\\$[0].id}}",
			"",
			"### Sign up (with email confirmation on, confirm the mail before logging in)",
			"POST {{url}}/auth/v1/signup",
			"apikey: {{key}}",
			"Content-Type: application/json",
			"",
			"{",
			"\t\"email\": \"{{\\$dotenv API_TEST_EMAIL}}\",",
			"\t\"password\": \"{{\\$dotenv API_TEST_PASSWORD}}\",",
			"\t\"data\": { \"${2:full_name}\": \"${3:Test User}\" }",
			"}",
			"",
			"### Login → access_token",
			"# @name login",
			"POST {{url}}/auth/v1/token?grant_type=password",
			"apikey: {{key}}",
			"Content-Type: application/json",
			"",
			"{",
			"\t\"email\": \"{{\\$dotenv API_TEST_EMAIL}}\",",
			"\t\"password\": \"{{\\$dotenv API_TEST_PASSWORD}}\"",
			"}",
			"",
			"### List, logged out",
			"GET {{url}}/rest/v1/${1:products}?select=*",
			"apikey: {{key}}",
			"Authorization: Bearer {{key}}",
			"",
			"### Filter + sort + limit: ?column=eq.value&order=column.desc&limit=n",
			"GET {{url}}/rest/v1/$1?select=*&${4:category}=eq.${5:value}&order=id.desc&limit=10",
			"apikey: {{key}}",
			"Authorization: Bearer {{token}}",
			"",
			"### Create → the new row (return=representation)",
			"# @name create",
			"POST {{url}}/rest/v1/$1",
			"apikey: {{key}}",
			"Authorization: Bearer {{token}}",
			"Content-Type: application/json",
			"Prefer: return=representation",
			"",
			"{",
			"\t\"${6:name}\": \"${7:value}\"",
			"}",
			"",
			"### Update",
			"PATCH {{url}}/rest/v1/$1?id=eq.{{id}}",
			"apikey: {{key}}",
			"Authorization: Bearer {{token}}",
			"Content-Type: application/json",
			"Prefer: return=representation",
			"",
			"{",
			"\t\"$6\": \"${8:new value}\"",
			"}",
			"",
			"### Delete",
			"DELETE {{url}}/rest/v1/$1?id=eq.{{id}}",
			"apikey: {{key}}",
			"Authorization: Bearer {{token}}",
			"$0"
		]
	}

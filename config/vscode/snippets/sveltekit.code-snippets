{
  "Remote List": {
    "scope": "svelte",
    "prefix": "remote::list",
    "exclude": "**/new/**",
    "include": "+page.svelte",
    "isFileTemplate": true,
    "description": "List rows from a drizzle::remote file, with delete buttons",
    "body": [
      "<script lang=\"ts\">",
      "\timport { delete${1/(.*)/${1:/pascalcase}/}, get${1/(.*)/${1:/pascalcase}/}s } from '#lib/remote/${1:tag}.remote.ts';",
      "</script>",
      "",

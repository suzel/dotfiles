  "Kit Load Fetch": {
    "scope": "typescript",
    "prefix": "kit::load-fetch",
    "include": ["+page.ts", "+layout.ts"],
    "isFileTemplate": true,
    "description": "+page.ts / +layout.ts universal load that fetches with load's fetch (own +server.ts or a public API)",
    "body": [
      "import { error } from '@sveltejs/kit';",
      "import type { ${TM_FILENAME_BASE/^\\+(page)?.*/${1:?Page:Layout}/}Load } from './\\$types';",
      "",
      "// TODO: runs in the browser too: no secrets here (secret key → api::service in a +page.server.ts)",
      "",
      "type ${1:Item} = { id: number; name: string };",
      "",
      "export const load: ${TM_FILENAME_BASE/^\\+(page)?.*/${1:?Page:Layout}/}Load = async ({ fetch, params }) => {",
      "\t// load's fetch: relative URLs and cookies work during SSR, the response is reused on hydration",
      "\tconst res = await fetch(`${2:/api/items/\\${params.id\\}}`);",
      "\tif (!res.ok) error(res.status, 'Could not load ${1/(.*)/${1:/camelcase}/}');",
      "\tconst ${1/(.*)/${1:/camelcase}/}: $1 = await res.json();",
      "\treturn { ${1/(.*)/${1:/camelcase}/} };",
      "};",
      "",
    ],
  },

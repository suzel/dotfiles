      "// https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Intl",
      "// a fixed locale and time zone: server and browser print the same text (otherwise hydration mismatch, wrong day near midnight)",
      "// TR: 'tr-TR' + 'Europe/Istanbul' (UTC+3, no DST) → \"8 Eki 2026\", \"3 gün önce\", \"dün\"; 24-hour clock, weeks start on Monday",
      "// TR text: 'i'.toUpperCase() is \"I\", use toLocaleUpperCase('tr-TR') → \"İ\"; sort with new Intl.Collator('tr-TR').compare (ç ğ ı ö ş ü)",
      "const dateFormat = new Intl.DateTimeFormat('${1:en-US}', { dateStyle: '${2|medium,long,short,full|}', timeZone: '${3:UTC}' });",
      "/** formatDate(row.createdAt) → \"Oct 8, 2026\" */",
      "export const formatDate = (date: Date | string | number) => dateFormat.format(new Date(date));",
      "",
      "const relativeFormat = new Intl.RelativeTimeFormat('$1', { numeric: 'auto' });",
      "const units = [",
      "\t['year', 31_536_000],",
      "\t['month', 2_592_000],",
      "\t['week', 604_800],",
      "\t['day', 86_400],",
      "\t['hour', 3_600],",
      "\t['minute', 60]",
      "] as const;",
      "/** timeAgo(date) → \"3 days ago\", \"in 2 hours\", \"now\"; changes with time: render it in the browser or it can differ from the server's text */",
      "export function timeAgo(date: Date | string | number, now = Date.now()) {",
      "\tconst seconds = (new Date(date).getTime() - now) / 1000;",
      "\tfor (const [unit, size] of units) {",
      "\t\tif (Math.abs(seconds) >= size) return relativeFormat.format(Math.round(seconds / size), unit);",

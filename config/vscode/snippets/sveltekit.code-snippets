			"// other origins call ${1:/api/} with a token (Authorization: Bearer); cookies are not sent cross-origin",
			"const handleCors: Handle = async ({ event, resolve }) => {",
			"\tif (!event.url.pathname.startsWith('$1')) return resolve(event);",

	"Kit Service Worker": {
		"scope": "typescript",
		"prefix": "kit::sw",
		"include": [
			"service-worker.ts",
			"**/service-worker/**"
		],
		"isFileTemplate": true,
		"description": "src/service-worker/index.ts: caches build files and static/, network first with offline fallback",
		"body": [
			"import { self } from '\\$app/service-worker';",
			"import { version } from '\\$app/env';",
			"import { assets, immutable } from '\\$app/manifest';",
			"",
			"// TODO: file: src/service-worker/index.ts; SvelteKit registers it, only in the production build (pnpm build && pnpm preview)",
			"// TODO: src/service-worker/tsconfig.json: { \"extends\": \"\\$app/tsconfig/service-worker\" }",
			"// TODO: root tsconfig.json: \"exclude\": [\"src/service-worker\"]",
			"",
			"// one cache per deployment",
			"const CACHE = `cache-\\${version}`;",
			"",
			"// the Vite output and everything in static/; manifest paths are relative to the base path, the worker's scope",
			"const ASSETS = [...immutable, ...assets].map((file) => new URL(file.path, self.registration.scope).pathname);",
			"",
			"self.addEventListener('install', (event) => {",
			"\tasync function addFilesToCache() {",
			"\t\tconst cache = await caches.open(CACHE);",
			"\t\tawait cache.addAll(ASSETS);",
			"\t}",
			"",
			"\tevent.waitUntil(addFilesToCache());",
			"});",
			"",
			"self.addEventListener('activate', (event) => {",
			"\t// remove the caches of previous deployments",
			"\tasync function deleteOldCaches() {",
			"\t\tfor (const key of await caches.keys()) {",
			"\t\t\tif (key !== CACHE) await caches.delete(key);",
			"\t\t}",
			"\t}",
			"",
			"\tevent.waitUntil(deleteOldCaches());",
			"});",
			"",
			"self.addEventListener('fetch', (event) => {",
			"\tif (event.request.method !== 'GET') return;",
			"",
			"\tasync function respond() {",
			"\t\tconst url = new URL(event.request.url);",
			"\t\tconst cache = await caches.open(CACHE);",
			"",
			"\t\t// build files and static/ can always come from the cache",
			"\t\tif (ASSETS.includes(url.pathname)) {",
			"\t\t\tconst response = await cache.match(url.pathname);",
			"\t\t\tif (response) return response;",
			"\t\t}",
			"",
			"\t\t// everything else: network first, the cached copy when offline",
			"\t\ttry {",
			"\t\t\tconst response = await fetch(event.request);",
			"\t\t\tif (response.status === 200 && !response.headers.get('cache-control')?.includes('no-store')) {",
			"\t\t\t\tvoid cache.put(event.request, response.clone());",
			"\t\t\t}",
			"\t\t\treturn response;",
			"\t\t} catch (error) {",
			"\t\t\tconst response = await cache.match(event.request);",
			"\t\t\tif (response) return response;",
			"\t\t\tthrow error;",
			"\t\t}",
			"\t}",
			"",
			"\tevent.respondWith(respond());",
			"});",
			""
		]
	},

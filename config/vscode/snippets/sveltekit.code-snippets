    "description": "handle hook: CORS for /api/* from allowed origins, preflight included",
    "body": [
      "// TODO: export const handle = sequence(handleCors, ...); first, so 401/429 responses also carry the headers",
      "// TODO: src/env.ts: CORS_ORIGINS: { schema: (value) => value?.split(',').map((s) => s.trim()).filter(Boolean) ?? [] }",
      "// TODO: import { CORS_ORIGINS } from '\\$app/env/private';",
      "// TODO: browser apps calling /api/auth/* need the same origins in better-auth's trustedOrigins",
      "// TODO: same origins in vite.config.ts: sveltekit({ csrf: { trustedOrigins: [...] } }), otherwise their DELETEs and form/multipart POSTs are a 403 (JSON POSTs pass)",
      "// other origins call ${1:/api/} with a token (Authorization: Bearer); cookies are not sent cross-origin",
      "const handleCors: Handle = async ({ event, resolve }) => {",
      "\tif (!event.url.pathname.startsWith('$1')) return resolve(event);",
      "",
      "\tconst origin = event.request.headers.get('origin');",
      "\tconst allowOrigin = origin && CORS_ORIGINS.includes(origin) ? origin : null;",
      "",
      "\tif (event.request.method === 'OPTIONS') {",
      "\t\tconst headers = new Headers({ vary: 'origin' });",
      "\t\tif (allowOrigin) {",
      "\t\t\theaders.set('access-control-allow-origin', allowOrigin);",
      "\t\t\theaders.set('access-control-allow-methods', 'GET, POST, PUT, PATCH, DELETE');",
      "\t\t\theaders.set('access-control-allow-headers', 'authorization, content-type');",
      "\t\t\theaders.set('access-control-max-age', '86400');",
      "\t\t}",
      "\t\treturn new Response(null, { status: 204, headers });",
      "\t}",
      "",
      "\tconst response = await resolve(event);",
      "\t// resolve() can return immutable headers (e.g. Response.redirect), so copy them",
      "\tconst headers = new Headers(response.headers);",
      "\theaders.append('vary', 'origin');",
      "\tif (allowOrigin) headers.set('access-control-allow-origin', allowOrigin);",
      "\treturn new Response(response.body, {",
      "\t\tstatus: response.status,",
      "\t\tstatusText: response.statusText,",
      "\t\theaders",

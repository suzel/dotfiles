			"import { desc, lt } from 'drizzle-orm';",
			"import { z } from 'zod';",
			"import { badRequest } from '#lib/server/api.ts';",
			"import { db } from '#lib/server/db/index.ts';",
			"import { ${1:table} } from '#lib/server/db/schema/${1}.ts';",
			"import type { RequestHandler } from './\\$types';",
			"",
			"// TODO: file: src/routes/api/(db)/${1}s/+server.ts; needs `api::helpers` and `drizzle::table`; POST: copy from api::db-list",
			"// TODO: client: GET ?limit=20, then ?after=<next> until next is null",
			"",
			"// ?after=<id>: rows older than that id, newest first (uses the primary key index, no OFFSET scan)",
			"const cursorQuery = z.object({",
			"\tlimit: z.coerce.number().int().min(1).max(100).default(20),",
			"\tafter: z.coerce.number().int().min(1).optional()",
			"});",
			"",
			"export const GET: RequestHandler = async ({ url }) => {",
			"\tconst query = cursorQuery.safeParse(Object.fromEntries(url.searchParams));",
			"\tif (!query.success) return badRequest(query.error);",
			"\tconst { limit, after } = query.data;",
			"",
			"\t// one extra row tells whether there is a next page",
			"\tconst rows = await db",
			"\t\t.select()",
			"\t\t.from($1)",
			"\t\t.where(after ? lt($1.id, after) : undefined)",
			"\t\t.orderBy(desc($1.id))",
			"\t\t.limit(limit + 1);",
			"\tconst items = rows.slice(0, limit);",

{
	"Env file for svelte": {
		"scope": "dotenv",
		"isFileTemplate": true,
		"include": ".env*",
		"description": ".env.example: commented env vars for a SvelteKit project",
		"body": [
			"# Docker Compose",
			"# COMPOSE_FILE=docker/compose.yaml:docker/compose.dev.yaml",
			"",
			"# Runtime",
			"# NODE_ENV=production",
			"# ORIGIN=https://www.sveltekit-project.com",
			"# PORT=3000",
			"# HOST=0.0.0.0",
			"# PROTOCOL_HEADER=x-forwarded-proto",
			"# HOST_HEADER=x-forwarded-host",
			"# ADDRESS_HEADER=x-forwarded-for",
			"# XFF_DEPTH=1",
			"# BODY_SIZE_LIMIT=5M",
			"# IDLE_TIMEOUT=0",
			"# SOCKET_PATH=",
			"# SHUTDOWN_TIMEOUT=30",
			"",
			"# Security",
			"# RATE_LIMIT_MAX=100",
			"# RATE_LIMIT_WINDOW=60",
			"",
			"# Public",
			"# PUBLIC_SITE_NAME=\"SvelteKit Project\"",
			"# PUBLIC_SITE_URL=https://www.sveltekit-project.com",
			"# PUBLIC_SENTRY_DSN=",
			"# PUBLIC_POSTHOG_KEY=",
			"# PUBLIC_GA_ID=",
			"",
			"# API",
			"# API_URL=",
			"# API_TOKEN=",
			"# API_TIMEOUT=",
			"",
			"# Observability (Sentry)",
			"# SENTRY_DSN=",
			"# SENTRY_ENVIRONMENT=development",
			"# LOG_LEVEL=info",
			"",
			"# Object Storage (S3 / R2)",
			"# S3_ENDPOINT=",
			"# S3_REGION=auto",
			"# S3_BUCKET=",
			"# S3_ACCESS_KEY_ID=",
			"# S3_SECRET_ACCESS_KEY=",
			"# S3_PUBLIC_URL=",
			""
		],
		"prefix": "env::.env.example"
	},
	"Editor Config": {
		"scope": "editorconfig",
		"isFileTemplate": true,
		"include": ".editorconfig",
		"description": ".editorconfig: shared editor settings",
		"body": [
			"# EditorConfig helps developers define and maintain consistent",
			"# coding styles between different editors and IDEs",
			"# http://editorconfig.org",
			"",
			"# root = true",
			"",
			"[*]",
			"# Change these settings to your own preference",
			"# indent_style = space",
			"# indent_size = 2",
			"",
			"# We recommend you to keep these unchanged",
			"# charset = utf-8",
			"# end_of_line = lf",
			"# insert_final_newline = true",
			"# trim_trailing_whitespace = true",
			"",
			"# [*.md]",
			"# trim_trailing_whitespace = false"
		],
		"prefix": "file::editorconfig"
	},
	"Gitignore for Svelte": {
		"scope": "ignore",
		"isFileTemplate": true,
		"include": ".gitignore",
		"description": ".gitignore for a SvelteKit project on macOS",
		"body": [
			"# Mac",
			"._*",
			".AppleDouble",
			".DS_Store",
			".LSOverride",
			".Spotlight-V100",
			".Trashes",
			"",
			"# VSCode",
			".vscode/*",
			"!.vscode/settings.json",
			"!.vscode/tasks.json",
			"!.vscode/launch.json",
			"!.vscode/extensions.json",
			"!.vscode/*.code-snippets",
			"",
			"# Node.js",
			"node_modules",
			"",
			"# ESLint",
			".eslintcache",
			"",
			"# Environment",
			".env",
			".env.*",
			"!.env.example",
			"!.env.test",
			"",
			"# Vite",
			"vite.config.ts.timestamp-*",
			"",
			"# SvelteKit",
			".svelte-kit",
			".output",
			"build",
			"",
			"# Cloudflare",
			".cloudflare",
			".wrangler",
			""
		],
		"prefix": "git::.gitignore"
	}
}

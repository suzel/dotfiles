{
  // Breadcrumbs
  "breadcrumbs.enabled": false,

  // Claude Code
  "claudeCode.allowDangerouslySkipPermissions": true,
  "claudeCode.initialPermissionMode": "bypassPermissions",
  "claudeCode.preferredLocation": "panel",
  "chat.agentsControl.enabled": "compact",
  // "chat.disableAIFeatures": false,
  "chat.unifiedAgentsBar.enabled": true,
  "chat.titleBar.openInAgentsWindow.enabled": false,

  // Editor
  "editor.bracketPairColorization.enabled": false,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "explicit",
    "source.sortImports": "always",
  },
  "editor.quickSuggestions": {
    "other": "on",
    "strings": "on",
    "comments": "off",
  },
  "editor.quickSuggestionsDelay": 0,
  "editor.snippetSuggestions": "top",
  "editor.tabCompletion": "onlySnippets",
  "editor.wordBasedSuggestions": "off",
  "editor.foldingStrategy": "indentation",
  "editor.cursorBlinking": "phase",
  "editor.cursorWidth": 1,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.fontFamily": "'Ioskeley Mono', monospace",
  "editor.fontWeight": "400",
  "editor.fontSize": 14.5,
  "editor.lineHeight": 1.55,
  // "editor.lineHeight": 1.7,
  "editor.fontLigatures": "'calt', 'zero'",
  "editor.formatOnPaste": true,
  "editor.formatOnSave": true,
  "editor.guides.indentation": false,
  "editor.inlineSuggest.suppressSuggestions": true,
  "editor.letterSpacing": 0.3,
  "editor.matchBrackets": "never",
  "editor.minimap.enabled": false,
  "editor.mouseWheelZoom": true,
  "editor.renderLineHighlight": "none",
  "editor.scrollbar.horizontal": "hidden",
  "editor.scrollbar.vertical": "hidden",
  "editor.semanticHighlighting.enabled": false,
  "editor.smoothScrolling": true,
  "editor.suggestSelection": "first",
  "editor.suggest.selectionMode": "always",
  "editor.unicodeHighlight.allowedLocales": {
    "tr": true,
  },

  // Explorer
  "explorer.compactFolders": false,
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.expandSingleFolderWorkspaces": false,
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    ".gitignore": "*ignore",
    ".env": ".env*",
    "*.ts": "${capture}.js",
    "tsconfig.json": "tsconfig.*.json",
    "package.json": ".node-*, pnpm*, .*.json, *.json, *.jsonc, *rc, *.config.js, *.config.ts, *config.json",
    "README.md": "LICENSE, CONTRIBUTING*, SECURITY*, CODE_OF_CONDUCT*, CHANGELOG*",
    "+page.svelte": "+page.ts, +page.server.ts",
    "+layout.svelte": "+layout.ts, +layout.server.ts",
  },

  // Exclude files
  "files.exclude": {
    "**/.DS_Store": true,
    "**/.git": true,
    "**/node_modules": true,
    "**/package-lock.json": true,
    "pnpm-lock.yaml": true,
    "**/*.js.map": true,
    ".eslintcache": true,
    ".svelte-kit": true,
    "build": true,
    ".output": true,
    ".cloudflare": true,
    ".wrangler": true,
    "src/cf-worker.d.ts": true,
  },
  "files.associations": {
    "*.css": "tailwindcss",
    ".env*": "dotenv",
  },

  // Language Overrides
  "[shellscript]": {
    "editor.defaultFormatter": "mkhl.shfmt",
    "editor.formatOnSave": true,
  },
  "[html, javascript, typescript, json, jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[markdown]": {
    "diffEditor.ignoreTrimWhitespace": false,
    "editor.defaultFormatter": "DavidAnson.vscode-markdownlint",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.markdownlint": "explicit",
    },
    "editor.quickSuggestions": {
      "comments": "off",
      "other": "off",
      "strings": "off",
    },
    "editor.unicodeHighlight.ambiguousCharacters": true,
    "editor.unicodeHighlight.invisibleCharacters": false,
    "editor.wordWrap": "on",
  },
  "[svelte]": {
    "editor.defaultFormatter": "svelte.svelte-vscode",
  },
  "[go]": {
    "editor.defaultFormatter": "golang.go",
  },
  "[toml]": {
    "editor.defaultFormatter": "tamasfe.even-better-toml",
  },

  // ESLint
  "eslint.validate": ["javascript", "typescript", "svelte"],

  // TailwindCSS
  "tailwindCSS.experimental.classRegex": [["clsx\\(([^)]*)\\)", "'([^']*)'"]],

  // JavaScript & TypeScript
  "js/ts.tsdk.path": "./node_modules/typescript/lib",
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "js/ts.preferences.preferTypeOnlyAutoImports": true,
  "js/ts.preferences.importModuleSpecifier": "non-relative",
  "js/ts.preferences.includePackageJsonAutoImports": "on",
  "js/ts.inlayHints.parameterNames.enabled": "none",
  "js/ts.suggest.autoImports": true,
  "js/ts.experimental.useTsgo": false,

  // Svelte
  "svelte.enable-ts-plugin": true,
  "svelte.plugin.svelte.runesLegacyModeCodeLens.enable": false,

  // Git
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "git.ignoreMissingGitWarning": true,

  // Markdown
  "markdown.preview.fontFamily": "'Figtree'",
  "markdown.preview.fontSize": 15,

  // Security
  "security.promptForLocalFileProtocolHandling": false,

  // Snippet Studio
  "snippetstudio.shell.snippets": [],
  "snippetstudio.statusBar.showItem": false,

  // Tasks
  "task.allowAutomaticTasks": "on",

  // Terminal
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.fontFamily": "'Ioskeley Mono Term'",
  "terminal.integrated.fontLigatures.enabled": true,
  "terminal.integrated.suggest.suggestOnTriggerCharacters": true,
  "terminal.integrated.shellIntegration.showCommandGuide": true,
  "terminal.integrated.shellIntegration.history": 100,
  "terminal.integrated.stickyScroll.enabled": true,
  "terminal.integrated.profiles.osx": {
    "zsh": {
      "path": "/bin/zsh",
      "args": ["-l"],
    },
  },
  "terminal.integrated.env.osx": {
    "ZDOTDIR": "${env:HOME}/.config/zsh",
  },
  "workbench.colorCustomizations": {
    "tab.activeBorderTop": "#00000000",
    "tab.activeBorder": "#00000000",
    "tab.border": "#00000000",
    "editorGroupHeader.tabsBorder": "#00000000",
    "focusBorder": "#00000000",
    "notebook.focusedCellBorder": "#00000000",
  },
  "workbench.editor.editorActionsLocation": "titleBar",
  "workbench.editor.empty.hint": "hidden",
  "workbench.editor.labelFormat": "short",
  "workbench.editor.preferHistoryBasedLanguageDetection": true,
  "workbench.editor.revealIfOpen": true,
  "workbench.settings.editor": "json",
  "workbench.startupEditor": "none",
  "workbench.tree.enableStickyScroll": false,
  "workbench.browser.showInTitleBar": true,
  "workbench.browser.openLocalhostLinks": true,
  "workbench.experimental.modernUI": true,
  "workbench.experimental.modernUIUppercaseViewHeaders": true,
  "workbench.activityBar.compact": true,
  "workbench.iconTheme": "symbols",
  "workbench.preferredDarkColorTheme": "Cursor Dark Midnight",
  "workbench.activityBar.location": "top",

  // Window Settings
  "window.density.layout": "compact",
  "window.autoDetectColorScheme": true,

  // Others
  "telemetry.telemetryLevel": "off",
  "update.showReleaseNotes": false,
}

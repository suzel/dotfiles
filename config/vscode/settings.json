{
  // Auto Snippets
  // prettier-ignore
  "auto-snippets.snippets": [
    // SvelteKit
    { "pattern": "**/+{page,layout,error}.svelte", "commands": ["workbench.action.populateFileFromSnippet"] },
    { "regex": "/lib/components/.*(?<!/Seo|/Analytics)\\.svelte$", "commands": ["workbench.action.populateFileFromSnippet"] },
    { "pattern": "**/+{page,layout}{,.server}.ts", "commands": ["workbench.action.populateFileFromSnippet"] },
    { "pattern": "**/!(robots.txt|sitemap.xml|rss.xml|og.png)/+server.ts", "commands": ["workbench.action.populateFileFromSnippet"] },
    { "pattern": "**/*.remote.ts", "commands": ["workbench.action.populateFileFromSnippet"] },
    { "pattern": "**/*.svelte.ts", "commands": ["workbench.action.populateFileFromSnippet"] },
    { "regex": "/lib/server/(?!db/).*(?<!\\.test|\\.spec|\\.e2e|\\.svelte)\\.ts$", "commands": ["workbench.action.populateFileFromSnippet"] },
    { "pattern": "**/{hooks.client,instrumentation.server}.ts", "commands": ["workbench.action.populateFileFromSnippet"] },
    { "pattern": "**/service-worker.ts", "snippet": "Kit Service Worker" },
    { "pattern": "**/*.{spec,test,e2e}.ts", "commands": ["workbench.action.populateFileFromSnippet"] },
    { "pattern": "**/*.http", "commands": ["workbench.action.populateFileFromSnippet"] },

    // Drizzle
    { "pattern": "**/db/schema/common.ts", "commands": ["workbench.action.populateFileFromSnippet"] },
    { "regex": "/db/schema/.*(?<!/common)\\.ts$", "commands": ["workbench.action.populateFileFromSnippet"] },
    { "pattern": "**/db/seed.ts", "commands": ["workbench.action.populateFileFromSnippet"] },
    { "pattern": "**/db/rls.ts", "snippet": "Drizzle RLS" },

    // SEO
    { "pattern": "**/robots.txt/+server.ts", "snippet": "SEO Robots" },
    { "pattern": "**/sitemap.xml/+server.ts", "snippet": "SEO Sitemap" },
    { "pattern": "**/rss.xml/+server.ts", "snippet": "SEO RSS" },
    { "pattern": "**/og.png/+server.ts", "snippet": "SEO OG Image" },
    { "pattern": "**/static/manifest.json", "snippet": "Manifest File" },
    { "pattern": "**/static/humans.txt", "snippet": "Humans.txt" },
    { "pattern": "**/static/llms.txt", "snippet": "Llms.txt" },
    { "pattern": "**/static/browserconfig.xml", "snippet": "Browser Config File" },
    { "pattern": "**/Seo.svelte", "snippet": "SEO Head" },
    { "pattern": "**/Analytics.svelte", "snippet": "SEO Analytics" },

    // GitHub
    { "pattern": "**/.github/workflows/ci.yml", "snippet": "Github Action - CI" },
    { "pattern": "**/.github/workflows/deploy.yml", "snippet": "Github Action - Deploy" },
    { "pattern": "**/.github/workflows/check.yml", "snippet": "Github Action - Check" },
    { "pattern": "**/.github/workflows/sv-check.yml", "snippet": "Github Action - SvelteKit Check" },
    { "pattern": "**/.github/dependabot.yml", "snippet": "Dependabot for Github Actions" },
    { "pattern": "**/renovate.json", "snippet": "Renovate for Github Action" },

    // Docker
    { "pattern": "**/{Dockerfile,*.Dockerfile}", "commands": ["workbench.action.populateFileFromSnippet"] },
    { "pattern": "**/compose.yaml", "commands": ["workbench.action.populateFileFromSnippet"] },
    { "pattern": "**/compose.dev.yaml", "snippet": "Docker Compose for Svelte - Dev" },
    { "pattern": "**/{.dockerignore,*.dockerignore}", "snippet": "Docker ignore for Svelte" },
    { "pattern": "**/docker/sql/init.sql", "snippet": "PostgREST init.sql" }
  ],
  // Alternative to the list above: one rule, matching moves to each snippet's include/exclude
  // "auto-snippets.snippets": [
  //   // Every new empty file: VS Code offers the templates whose include/exclude match
  //   { "regex": ".", "commands": ["workbench.action.populateFileFromSnippet"] }
  // ],

  // Breadcrumbs
  "breadcrumbs.enabled": false,

  // Chat
  "chat.agentsControl.enabled": "compact",
  "chat.disableAIFeatures": true,
  "chat.titleBar.openInAgentsWindow.enabled": false,

  // Claude Code
  "claudeCode.allowDangerouslySkipPermissions": true,
  "claudeCode.initialPermissionMode": "bypassPermissions",
  "claudeCode.preferredLocation": "panel",

  // Code Spell Checker
  "cSpell.diagnosticLevel": "Hint",

  // Diff Editor
  "diffEditor.experimental.showMoves": true,

  // Editor
  "editor.acceptSuggestionOnCommitCharacter": false,
  "editor.bracketPairColorization.enabled": false,
  "editor.codeActionsOnSave": {
    "source.addMissingImports": "explicit",
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "explicit",
    "source.sortImports": "always"
  },
  "editor.copyWithSyntaxHighlighting": false,
  "editor.cursorBlinking": "phase",
  "editor.cursorWidth": 1,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.emptySelectionClipboard": false,
  "editor.find.seedSearchStringFromSelection": "selection",
  "editor.foldingStrategy": "indentation",
  "editor.fontFamily": "'Ioskeley Mono', monospace",
  "editor.fontLigatures": "'calt', 'zero'",
  "editor.fontSize": 14.5,
  "editor.fontWeight": "400",
  "editor.formatOnPaste": true,
  "editor.formatOnSave": true,
  "editor.gotoLocation.multipleDeclarations": "goto",
  "editor.gotoLocation.multipleDefinitions": "goto",
  "editor.gotoLocation.multipleImplementations": "goto",
  "editor.gotoLocation.multipleReferences": "goto",
  "editor.gotoLocation.multipleTypeDefinitions": "goto",
  "editor.guides.indentation": false,
  "editor.inlineSuggest.suppressSuggestions": true,
  "editor.letterSpacing": 0.3,
  "editor.lineHeight": 1.55,
  "editor.matchBrackets": "never",
  "editor.minimap.enabled": false,
  "editor.mouseWheelZoom": true,
  "editor.pasteAs.preferences": ["text.updateImports"],
  "editor.quickSuggestions": {
    "other": "on",
    "strings": "on",
    "comments": "off"
  },
  "editor.quickSuggestionsDelay": 0,
  "editor.renderLineHighlight": "none",
  "editor.scrollbar.horizontal": "hidden",
  "editor.scrollbar.vertical": "hidden",
  "editor.semanticHighlighting.enabled": false,
  "editor.smoothScrolling": true,
  "editor.snippetSuggestions": "top",
  "editor.suggest.preview": true,
  "editor.suggest.selectionMode": "always",
  "editor.suggest.snippetsPreventQuickSuggestions": false,
  "editor.suggestSelection": "first",
  "editor.tabCompletion": "onlySnippets",
  "editor.tabSize": 2,
  "editor.unicodeHighlight.allowedLocales": {
    "tr": true
  },
  "editor.wordBasedSuggestions": "off",

  // ESLint
  // Hide issues that are auto-fixed on save
  "eslint.rules.customizations": [
    { "rule": "*", "fixable": true, "severity": "off" }
  ],
  "eslint.validate": ["javascript", "typescript", "svelte"],

  // Explorer
  "explorer.compactFolders": false,
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.confirmPasteNative": false,
  "explorer.expandSingleFolderWorkspaces": false,
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    ".gitignore": "*ignore",
    ".env": ".env*",
    "*.ts": "${capture}.js",
    "tsconfig.json": "tsconfig.*.json",
    "package.json": ".node-*, pnpm*, .*.json, *.json, *.jsonc, *rc, *.config.js, *.config.ts, *config.json",
    "README.md": "LICENSE, CONTRIBUTING*, SECURITY*, CODE_OF_CONDUCT*, CHANGELOG*",
    "+page.svelte": "+page.ts, +page.server.ts",
    "+layout.svelte": "+layout.ts, +layout.server.ts"
  },

  // Files
  "files.associations": {
    "*.css": "tailwindcss",
    ".env*": "dotenv",
    "*.dockerignore": "ignore"
  },
  "files.exclude": {
    "**/.DS_Store": true,
    "**/.git": true,
    "**/node_modules": true,
    "**/package-lock.json": true,
    "pnpm-lock.yaml": true,
    "**/*.js.map": true,
    ".eslintcache": true,
    ".svelte-kit": true,
    "build": true,
    ".output": true,
    ".cloudflare": true,
    ".wrangler": true,
    "src/cf-worker.d.ts": true
  },
  "files.insertFinalNewline": true,
  "files.simpleDialog.enable": true,
  "files.trimFinalNewlines": true,
  "files.trimTrailingWhitespace": true,

  // Git
  "git.autofetch": true,
  "git.closeDiffOnOperation": true,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "git.ignoreMissingGitWarning": true,

  // GitHub Pull Requests
  "githubPullRequests.defaultMergeMethod": "squash",
  "githubPullRequests.pullPullRequestBranchBeforeCheckout": "pull",
  "githubPullRequests.pushBranch": "always",

  // JavaScript & TypeScript
  "js/ts.experimental.useTsgo": false,
  "js/ts.inlayHints.parameterNames.enabled": "none",
  "js/ts.preferGoToSourceDefinition": true,
  "js/ts.preferences.autoImportFileExcludePatterns": [
    "**/node_modules/@types/node/console.d.ts",
    "**/node_modules/zod/**",
    "**/node_modules/better-auth/dist/index.d.*ts"
  ],
  "js/ts.preferences.autoImportSpecifierExcludeRegexes": [
    "^drizzle-orm/(mysql|singlestore|gel)-core"
  ],
  "js/ts.preferences.importModuleSpecifier": "non-relative",
  "js/ts.preferences.includePackageJsonAutoImports": "on",
  "js/ts.preferences.preferTypeOnlyAutoImports": true,
  "js/ts.suggest.autoImports": true,
  "js/ts.tsdk.path": "./node_modules/typescript/lib",
  "js/ts.updateImportsOnFileMove.enabled": "always",

  // Launch
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "SvelteKit: Server (vite dev)",
        "type": "node-terminal",
        "request": "launch",
        "command": "pnpm exec vite dev --logLevel info",
        "cwd": "${workspaceFolder}",
        "serverReadyAction": {
          "pattern": "Local:\\s+(https?://\\S+)",
          "uriFormat": "%s",
          "action": "debugWithChrome",
          "webRoot": "${workspaceFolder}"
        }
      },
      {
        "name": "SvelteKit: SSR Debug (Node)",
        "type": "node",
        "request": "launch",
        "runtimeExecutable": "pnpm",
        "runtimeArgs": ["exec", "vite", "dev", "--logLevel", "info"],
        "cwd": "${workspaceFolder}",
        "console": "integratedTerminal",
        "autoAttachChildProcesses": true,
        "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
        "sourceMaps": true,
        "resolveSourceMapLocations": [
          "${workspaceFolder}/**",
          "!**/node_modules/**"
        ],
        "serverReadyAction": {
          "pattern": "Local:\\s+(https?://\\S+)",
          "uriFormat": "%s",
          "action": "debugWithChrome",
          "webRoot": "${workspaceFolder}"
        }
      },
      {
        "name": "SvelteKit: Browser Only (Chrome attach)",
        "type": "chrome",
        "request": "launch",
        "url": "http://localhost:5173",
        "webRoot": "${workspaceFolder}",
        "sourceMaps": true,
        "sourceMapPathOverrides": {
          "/@fs/*": "*"
        }
      }
    ]
  },

  // Markdown
  "markdown.preview.fontFamily": "'Figtree'",
  "markdown.preview.fontSize": 15,

  // Rust Analyzer
  // Own target dir: no build lock waits or rebuilds with terminal cargo
  "rust-analyzer.cargo.targetDir": true,
  // Lint with clippy on save instead of plain cargo check
  "rust-analyzer.check.command": "clippy",

  // Security
  "security.promptForLocalFileProtocolHandling": false,

  // Snippet Studio
  "snippetstudio.shell.snippets": [],
  "snippetstudio.statusBar.showItem": false,

  // Svelte
  "svelte.enable-ts-plugin": true,
  "svelte.plugin.svelte.defaultScriptLanguage": "ts",
  "svelte.plugin.svelte.runesLegacyModeCodeLens.enable": false,

  // TailwindCSS
  "tailwindCSS.experimental.classRegex": [["clsx\\(([^)]*)\\)", "'([^']*)'"]],

  // Tasks
  "task.allowAutomaticTasks": "on",
  "task.problemMatchers.neverPrompt": { "npm": true },

  // Terminal
  "terminal.external.osxExec": "Ghostty.app",
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.fontFamily": "'Ioskeley Mono Term', 'Symbols Nerd Font Mono'",
  "terminal.integrated.fontLigatures.enabled": true,
  "terminal.integrated.profiles.osx": {
    "zsh": {
      "path": "/opt/homebrew/bin/zsh",
      "args": ["-l"]
    }
  },
  "terminal.integrated.shellIntegration.history": 100,
  "terminal.integrated.shellIntegration.showCommandGuide": true,
  "terminal.integrated.stickyScroll.enabled": true,
  "terminal.integrated.suggest.suggestOnTriggerCharacters": true,

  // Window
  "window.autoDetectColorScheme": true,
  "window.density.layout": "compact",

  // Workbench
  "workbench.activityBar.compact": true,
  "workbench.activityBar.location": "top",
  "workbench.browser.openLocalhostLinks": true,
  "workbench.browser.showInTitleBar": true,
  "workbench.colorCustomizations": {
    "tab.activeBorderTop": "#00000000",
    "tab.activeBorder": "#00000000",
    "tab.border": "#00000000",
    "editorGroupHeader.tabsBorder": "#00000000",
    "focusBorder": "#00000000",
    "notebook.focusedCellBorder": "#00000000"
  },
  "workbench.editor.customLabels.patterns": {
    "**/routes/**/+page.svelte": "${dirname(1)}/${dirname}",
    "**/routes/**/+page.server.ts": "${dirname(1)}/${dirname} [server]",
    "**/routes/**/+layout.svelte": "${dirname(1)}/${dirname} [layout]",
    "**/routes/**/+layout.server.ts": "${dirname(1)}/${dirname} [layout server]",
    "**/routes/**/+server.ts": "${dirname(1)}/${dirname} [api]"
  },
  "workbench.editor.editorActionsLocation": "titleBar",
  "workbench.editor.empty.hint": "hidden",
  "workbench.editor.enablePreview": false,
  "workbench.editor.labelFormat": "short",
  "workbench.editor.preferHistoryBasedLanguageDetection": true,
  "workbench.editor.revealIfOpen": true,
  "workbench.enableExperiments": false,
  "workbench.experimental.modernUI": true,
  "workbench.experimental.modernUIUppercaseViewHeaders": true,
  "workbench.fontAliasing": "auto",
  "workbench.iconTheme": "symbols",
  "workbench.preferredDarkColorTheme": "Cursor Dark Midnight",
  "workbench.settings.editor": "json",
  "workbench.settings.enableNaturalLanguageSearch": false,
  "workbench.startupEditor": "none",
  "workbench.tips.enabled": false,
  "workbench.tree.enableStickyScroll": false,

  // Language Overrides
  "[shellscript]": {
    "editor.defaultFormatter": "mkhl.shfmt",
    "editor.formatOnSave": true
  },
  "[html, javascript, typescript, json, jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[markdown]": {
    "diffEditor.ignoreTrimWhitespace": false,
    "files.trimTrailingWhitespace": false,
    "editor.defaultFormatter": "DavidAnson.vscode-markdownlint",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.markdownlint": "explicit"
    },
    "editor.quickSuggestions": {
      "comments": "off",
      "other": "off",
      "strings": "off"
    },
    "editor.unicodeHighlight.ambiguousCharacters": true,
    "editor.unicodeHighlight.invisibleCharacters": false,
    "editor.wordWrap": "on"
  },
  "[plaintext]": {
    "workbench.editor.languageDetection": false
  },
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer"
  },
  "[svelte]": {
    "editor.defaultFormatter": "svelte.svelte-vscode"
  },
  "[go]": {
    "editor.defaultFormatter": "golang.go"
  },
  "[toml]": {
    "editor.defaultFormatter": "tamasfe.even-better-toml"
  },

  // Others
  "extensions.ignoreRecommendations": true,
  "telemetry.telemetryLevel": "off",
  "update.showReleaseNotes": false,
  "terminal.integrated.fontSize": 19
}

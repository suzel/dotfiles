{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "tasks": [
    {
      "label": "SvelteKit: build",
      "type": "shell",
      "icon": {
        "color": "terminal.ansiRed",
        "id": "build"
      },
      "command": "pnpm",
      "args": ["build"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "panel": "dedicated",
        "reveal": "silent",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "SvelteKit: dev",
      "type": "shell",
      "icon": {
        "color": "terminal.ansiRed",
        "id": "play"
      },
      "command": "pnpm",
      "args": ["dev"],
      "isBackground": true,
      "presentation": { "panel": "dedicated", "reveal": "silent" },
      "problemMatcher": {
        "owner": "vite",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(.+?):(\\d+):(\\d+):\\s+(error|warning)\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*VITE.*",
          "endsPattern": "(Local|Network):.*"
        }
      }
    },
    {
      "label": "SvelteKit: check",
      "type": "shell",
      "icon": {
        "color": "terminal.ansiRed",
        "id": "check-all"
      },
      "command": "pnpm",
      "args": ["check"],
      "group": { "kind": "test", "isDefault": true },
      "presentation": {
        "panel": "dedicated",
        "reveal": "silent",
        "clear": true
      },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "SvelteKit: lint",
      "type": "shell",
      "icon": {
        "color": "terminal.ansiRed",
        "id": "checklist"
      },
      "command": "pnpm",
      "args": ["lint"],
      "presentation": {
        "panel": "dedicated",
        "reveal": "silent",
        "clear": true
      },
      "problemMatcher": ["$eslint-stylish"]
    },
    {
      "label": "SvelteKit: favicons",
      "type": "shell",
      "icon": {
        "color": "terminal.ansiRed",
        "id": "symbol-color"
      },
      "command": "pnpm",
      "args": [
        "dlx",
        "@vite-pwa/assets-generator@2",
        "--preset",
        "minimal-2023",
        "static/img/favicons/favicon.svg"
      ],
      "presentation": { "panel": "shared", "reveal": "silent" },
      "problemMatcher": []
    },
    {
      "label": "Cloudflare: D1 create",
      "type": "shell",
      "icon": {
        "color": "terminal.ansiYellow",
        "id": "database"
      },
      "command": "npx -y wrangler d1 create ${input:cfName} --binding ${input:cfBinding} --update-config && npx -y wrangler types",
      "presentation": { "panel": "shared", "focus": true },
      "problemMatcher": []
    },
    {
      "label": "Cloudflare: R2 bucket create",
      "type": "shell",
      "icon": {
        "color": "terminal.ansiYellow",
        "id": "archive"
      },
      "command": "npx -y wrangler r2 bucket create ${input:cfName} --binding ${input:cfBinding} --update-config && npx -y wrangler types",
      "presentation": { "panel": "shared", "focus": true },
      "problemMatcher": []
    },
    {
      "label": "Cloudflare: KV namespace create",
      "type": "shell",
      "icon": {
        "color": "terminal.ansiYellow",
        "id": "key"
      },
      "command": "npx -y wrangler kv namespace create ${input:cfName} --binding ${input:cfBinding} --update-config && npx -y wrangler types",
      "presentation": { "panel": "shared", "focus": true },
      "problemMatcher": []
    },
    {
      "label": "Cloudflare: types",
      "type": "shell",
      "icon": {
        "color": "terminal.ansiYellow",
        "id": "symbol-interface"
      },
      "command": "npx -y wrangler types",
      "presentation": { "panel": "shared", "reveal": "silent" },
      "problemMatcher": []
    },
    {
      "label": "Cloudflare: D1 migrate",
      "type": "shell",
      "icon": {
        "color": "terminal.ansiYellow",
        "id": "versions"
      },
      "command": "npx -y wrangler d1 migrations apply ${input:cfDb} ${input:cfTarget}",
      "presentation": { "panel": "shared", "focus": true },
      "problemMatcher": []
    },
    {
      "label": "Cloudflare: D1 backup",
      "type": "shell",
      "icon": {
        "color": "terminal.ansiYellow",
        "id": "cloud-download"
      },
      "command": "mkdir -p backups && npx -y wrangler d1 export ${input:cfDb} --remote --output backups/${input:cfDb}-$(date +%F-%H%M).sql",
      "presentation": { "panel": "shared", "focus": true },
      "problemMatcher": []
    },
    {
      "label": "Cloudflare: tail",
      "type": "shell",
      "icon": {
        "color": "terminal.ansiYellow",
        "id": "output"
      },
      "command": "npx -y wrangler tail --format pretty",
      "presentation": { "panel": "dedicated", "reveal": "always" },
      "problemMatcher": []
    },
    {
      "label": "GitHub: open",
      "type": "shell",
      "icon": {
        "color": "terminal.ansiWhite",
        "id": "github"
      },
      "command": "gh browse",
      "presentation": { "reveal": "never" },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "cfName",
      "type": "promptString",
      "description": "Resource name (e.g. my-app-db, my-app-uploads)"
    },
    {
      "id": "cfBinding",
      "type": "promptString",
      "description": "Binding name in wrangler config (e.g. DB, BUCKET, KV)"
    },
    {
      "id": "cfDb",
      "type": "promptString",
      "description": "D1 database name or binding",
      "default": "DB"
    },
    {
      "id": "cfTarget",
      "type": "pickString",
      "description": "Apply migrations to",
      "options": ["--local", "--remote"],
      "default": "--local"
    }
  ]
}

{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "tasks": [
    {
      "label": "SvelteKit: build",
      "type": "shell",
      "icon": {
        "color": "terminal.ansiRed",
        "id": "build"
      },
      "command": "pnpm",
      "args": [
        "build"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "panel": "dedicated",
        "reveal": "silent",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "SvelteKit: dev",
      "type": "shell",
      "icon": {
        "color": "terminal.ansiRed",
        "id": "play"
      },
      "command": "pnpm",
      "args": [
        "dev"
      ],
      "isBackground": true,
      "presentation": {
        "panel": "dedicated",
        "reveal": "silent"
      },
      "problemMatcher": {
        "owner": "vite",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(.+?):(\\d+):(\\d+):\\s+(error|warning)\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*VITE.*",
          "endsPattern": "(Local|Network):.*"
        }
      }
    },
    {
      "label": "SvelteKit: check",
      "type": "shell",
      "icon": {
        "color": "terminal.ansiRed",
        "id": "check-all"
      },
      "command": "pnpm",
      "args": [
        "check"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "panel": "dedicated",
        "reveal": "silent",
        "clear": true
      },
      "problemMatcher": [
        "$tsc"
      ]
    },
    {
      "label": "SvelteKit: lint",
      "type": "shell",
      "icon": {
        "color": "terminal.ansiRed",
        "id": "checklist"
      },
      "command": "pnpm",
      "args": [
        "lint"
      ],
      "presentation": {
        "panel": "dedicated",
        "reveal": "silent",
        "clear": true
      },
      "problemMatcher": [
        "$eslint-stylish"
      ]
    },
    {
      "label": "SvelteKit: favicons",
      "type": "shell",
      "icon": {
        "color": "terminal.ansiRed",
        "id": "symbol-color"
      },
      "command": "pnpm",
      "args": [
        "dlx",
        "@vite-pwa/assets-generator@2",
        "--preset",
        "minimal-2023",
        "static/img/favicons/favicon.svg"
      ],
      "presentation": {
        "panel": "shared",
        "reveal": "silent"
      },
      "problemMatcher": []
    },
    {
      "label": "Cloudflare: D1 create",
      "type": "shell",
      "icon": {
        "color": "terminal.ansiYellow",
        "id": "database"
      },
      "command": "npx -y wrangler d1 create ${input:cfName} --binding ${input:cfBinding} --update-config && npx -y wrangler types",
      "presentation": {
        "panel": "shared",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "Cloudflare: R2 bucket create",
      "type": "shell",
      "icon": {
        "color": "terminal.ansiYellow",
        "id": "archive"
      },
      "command": "npx -y wrangler r2 bucket create ${input:cfName} --binding ${input:cfBinding} --update-config && npx -y wrangler types",
      "presentation": {
        "panel": "shared",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "Cloudflare: KV namespace create",
      "type": "shell",
      "icon": {
        "color": "terminal.ansiYellow",
        "id": "key"
      },
      "command": "npx -y wrangler kv namespace create ${input:cfName} --binding ${input:cfBinding} --update-config && npx -y wrangler types",
      "presentation": {
        "panel": "shared",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "Cloudflare: types",
      "type": "shell",
      "icon": {
        "color": "terminal.ansiYellow",
        "id": "symbol-interface"
      },
      "command": "npx -y wrangler types",
      "presentation": {
        "panel": "shared",
        "reveal": "silent"
      },
      "problemMatcher": []
    },
    {
      "label": "Cloudflare: D1 migrate",
      "type": "shell",
      "icon": {
        "color": "terminal.ansiYellow",
        "id": "versions"
      },
      "command": "npx -y wrangler d1 migrations apply ${input:cfDb} ${input:cfTarget}",
      "presentation": {
        "panel": "shared",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "Cloudflare: D1 backup",
      "type": "shell",
      "icon": {
        "color": "terminal.ansiYellow",
        "id": "cloud-download"
      },
      "command": "mkdir -p backups && npx -y wrangler d1 export ${input:cfDb} --remote --output backups/${input:cfDb}-$(date +%F-%H%M).sql",
      "presentation": {
        "panel": "shared",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "Cloudflare: D1 execute selection",
      "detail": "Runs the SQL selected in the editor",
      // process, not shell: the selection goes in as one argument, so quotes and $() stay literal
      "type": "process",
      "icon": {
        "color": "terminal.ansiYellow",
        "id": "play-circle"
      },
      "command": "npx",
      "args": [
        "-y",
        "wrangler",
        "d1",
        "execute",
        "${input:cfDb}",
        "${input:cfTarget}",
        "--command",
        "${selectedText}"
      ],
      "presentation": {
        "panel": "shared",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "Cloudflare: tail",
      "type": "shell",
      "icon": {
        "color": "terminal.ansiYellow",
        "id": "output"
      },
      "command": "npx -y wrangler tail --format pretty",
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      },
      "problemMatcher": []
    },
    {
      "label": "Drizzle: generate",
      "type": "shell",
      "icon": {
        "color": "terminal.ansiGreen",
        "id": "diff-added"
      },
      "command": "pnpm db:generate --name ${input:drizzleName}",
      "presentation": {
        "panel": "shared",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "Drizzle: migrate",
      "type": "shell",
      "icon": {
        "color": "terminal.ansiGreen",
        "id": "arrow-circle-up"
      },
      "command": "pnpm db:migrate",
      "presentation": {
        "panel": "shared",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "Drizzle: generate + migrate",
      "icon": {
        "color": "terminal.ansiGreen",
        "id": "run-all"
      },
      "dependsOn": [
        "Drizzle: generate",
        "Drizzle: migrate"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Drizzle: push",
      "detail": "Prototyping only: skips migrations, so the history drifts from the schema",
      "type": "shell",
      "icon": {
        "color": "terminal.ansiGreen",
        "id": "repo-push"
      },
      "command": "pnpm db:push",
      "presentation": {
        "panel": "shared",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "Drizzle: studio",
      "detail": "D1 (d1-http driver): opens the remote production database, not the local one",
      "type": "shell",
      "icon": {
        "color": "terminal.ansiGreen",
        "id": "table"
      },
      "command": "pnpm db:studio",
      "isBackground": true,
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      },
      "problemMatcher": []
    },
    {
      "label": "Drizzle: seed",
      "type": "shell",
      "icon": {
        "color": "terminal.ansiGreen",
        "id": "beaker"
      },
      "command": "pnpm db:seed --count ${input:seedRows} ${input:seedMode}",
      "presentation": {
        "panel": "shared",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "Drizzle: check",
      "type": "shell",
      "icon": {
        "color": "terminal.ansiGreen",
        "id": "verified"
      },
      "command": "pnpm drizzle-kit check",
      "presentation": {
        "panel": "shared",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "Drizzle: table snippet (example)",
      "detail": "Inserts the Drizzle Table snippet into the active editor; echo only lets the input run",
      "type": "shell",
      "icon": {
        "color": "terminal.ansiGreen",
        "id": "symbol-snippet"
      },
      "command": "echo ${input:drizzleTableSnippet}",
      "presentation": {
        "reveal": "never"
      },
      "problemMatcher": []
    },
    {
      "label": "GitHub: open",
      "type": "shell",
      "icon": {
        "color": "terminal.ansiWhite",
        "id": "github"
      },
      "command": "gh browse",
      "presentation": {
        "reveal": "never"
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "cfName",
      "type": "promptString",
      "description": "Resource name (e.g. my-app-db, my-app-uploads)"
    },
    {
      "id": "cfBinding",
      "type": "promptString",
      "description": "Binding name in wrangler config (e.g. DB, BUCKET, KV)"
    },
    {
      "id": "cfDb",
      "type": "promptString",
      "description": "D1 database name or binding",
      "default": "DB"
    },
    {
      "id": "cfTarget",
      "type": "pickString",
      "description": "Apply migrations to",
      "options": [
        "--local",
        "--remote"
      ],
      "default": "--local"
    },
    {
      "id": "drizzleName",
      "type": "promptString",
      "description": "Migration name (e.g. add_tags)"
    },
    {
      "id": "seedRows",
      "type": "promptString",
      "description": "Rows per table",
      "default": "10"
    },
    {
      "id": "seedMode",
      "type": "pickString",
      "description": "Tables to seed",
      "options": [
        {
          "label": "Empty tables only",
          "value": ""
        },
        {
          "label": "Every table (--reset deletes all rows first)",
          "value": "--reset"
        }
      ],
      "default": ""
    },
    {
      "id": "drizzleTableSnippet",
      "type": "command",
      "command": "editor.action.insertSnippet",
      "args": {
        "langId": "typescript",
        "name": "Drizzle Table"
      }
    }
  ]
}

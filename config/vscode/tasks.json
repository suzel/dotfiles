    {
      "label": "Terminal: run selection",
      "detail": "Runs selection",
      "type": "process",
      "icon": {
        "color": "terminal.ansiBlue",
        "id": "terminal"
      },
      "command": "zsh",
      "args": [
        "-eic",
        "TRAPEXIT() { local s=$?; ((s)) && read -k \"?Exit $s, press any key\" }; eval $1",
        "zsh",
        "${selectedText}"
      ],
      "runOptions": {
        "instanceLimit": 99
      },
      "presentation": {
        "echo": false,
        "panel": "new",
        "close": true
      },
      "problemMatcher": [ ]
    }
  ]

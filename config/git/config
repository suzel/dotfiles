[user]
	useConfigOnly = true

[includeIf "gitdir:~/Projects/"]
	path = ~/.config/git/config.local

[core]
	autocrlf = input
	editor = code --wait
	fsmonitor = true
	untrackedCache = true

[apply]
	whitespace = fix

[push]
	autoSetupRemote = true

[pull]
	rebase = true

[fetch]
	prune = true
	pruneTags = true

[rebase]
	autoSquash = true
	autostash = true
	updateRefs = true

[rerere]
	enabled = true
	autoupdate = true

[init]
	defaultBranch = main

# Fetch stays on https (no login needed), push uses the SSH key
[url "git@github.com:"]
	pushInsteadOf = https://github.com/

[alias]
	a = add --all
	ai = add -i
	c = commit
	ca = commit -a
	cm = commit -m
	d = diff
	dc = diff --cached
	dl = difftool
	dlc = difftool --cached
	f = fetch
	fo = fetch origin
	fu = fetch upstream
	g = grep -p
	l = log --oneline
	lg = log --oneline --graph
	ls = ls-files
	m = merge
	o = checkout
	ob = checkout -b
	ps = push
	psf = push --force-with-lease --force-if-includes
	psu = push -u
	pso = push origin
	pl = pull
	plo = pull origin
	rb = rebase
	re = reset
	r = remote
	ra = remote add
	rr = remote rm
	rv = remote -v
	rs = remote show
	s = status
	sb = status -s -b
	w = show
	wr = show -p --no-color
	# Utility aliases
	amend = commit --amend
	unstage = reset HEAD --
	undo = reset --soft HEAD^
	stash-all = stash push --include-untracked
	up = "!git switch $(git symbolic-ref refs/remotes/origin/HEAD --short | sed 's|origin/||') && git pull"

[merge]
	conflictstyle = zdiff3
	tool = vscode

[mergetool]
	keepBackup = false

[mergetool "vscode"]
	cmd = code --wait --merge $REMOTE $LOCAL $BASE $MERGED

[diff]
	algorithm = histogram
	colorMoved = plain
	colorMovedWS = allow-indentation-change
	mnemonicPrefix = true
	tool = vscode

[difftool]
	prompt = false

[difftool "vscode"]
	cmd = code --wait --diff $LOCAL $REMOTE

[commit]
	verbose = true

[tag]
	sort = version:refname

[branch]
	sort = -committerdate

[log]
	date = iso

[help]
	autocorrect = prompt

[transfer]
	fsckobjects = true

[status]
	showUntrackedFiles = all

[advice]
	detachedHead = false

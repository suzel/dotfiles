# Serve a directory on a given port (Python 3)
servedir() {
  local port="${1:-8000}"
  python3 -m http.server "$port"
}

# Scrape images with wget
scrapeimages() {
  wget -nd -H -p -A jpg,jpeg,png,gif -e robots=off "$1"
}

# Find and kill processes by name
pskill() {
  pkill -f "$1"
}

# Extract archives intelligently
extract() {
  case $1 in
    *.tar.gz|*.tgz) tar -xzf "$1";;
    *.tar.bz2|*.tbz2) tar -xjf "$1";;
    *.tar.xz) tar -xJf "$1";;
    *.zip) unzip "$1";;
    *.rar) unrar x "$1";;
    *.7z) 7z x "$1";;
    *) echo "Unknown archive format";;
  esac
}

# Clone the template locally (optional branch, default: dev) and run setup.zsh
new-svelte() {
  local name="$1"
  local branch="${2:-dev}"
  [[ -z "$name" ]] && { echo "Usage: new-svelte <project-name> [branch]"; return 1; }

  gh repo clone suzel/sveltekit-project "$name" -- --depth=1 --branch "$branch" -q || return 1
  rm -rf "$name/.git"
  cd "$name" || return 1
  ./setup.zsh && rm -f setup.zsh
}

# Font
font-family = Ioskeley Mono Term
font-size = 14
font-feature = zero

# Theme
theme = light:Cursor Light,dark:Cursor Dark Midnight
background-blur = 10
background-opacity = 0.95

# Cursor
cursor-style-blink = true

# Window
window-save-state = always
window-padding-x = 16
window-padding-y = 16
window-width = 100
window-height = 40
window-padding-balance = true
window-theme = system

# Titlebar
macos-titlebar-proxy-icon = hidden

# App icon
macos-icon = custom
macos-custom-icon = ~/.config/ghostty/ayu-dark.png

# Shell integration
shell-integration-features = no-cursor,sudo,title,ssh-env,ssh-terminfo

# Mouse
mouse-hide-while-typing = true

# Option key
macos-option-as-alt = left

# Splits
keybind = ctrl+shift+z=toggle_split_zoom
keybind = ctrl+shift+equal=equalize_splits

# Behavior
confirm-close-surface = false

# Low latency
window-vsync = false

# Updates
auto-update = download

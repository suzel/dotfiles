# Shell integration (shell is auto-detected)
shell-integration-features = no-cursor,sudo,title,ssh-env,ssh-terminfo

# Font (Nerd Font icons come from Ghostty's built-in Symbols Nerd Font)
font-family = Ioskeley Mono Term
font-size = 14
font-feature = zero

# Theme
theme = light:GitHub Light Default,dark:GitHub Dark Default
background-blur = 10
background-opacity = 0.95

# Cursor preferences
cursor-style = block
cursor-style-blink = true

# Window size and padding
window-save-state = always
window-padding-x = 16
window-padding-y = 16
window-width = 100
window-height = 40
window-padding-balance = true
window-theme = system

# Minimal macOS titlebar for cleaner appearance
macos-titlebar-style = transparent
macos-titlebar-proxy-icon = hidden

working-directory = home
confirm-close-surface = false

# Mouse
mouse-hide-while-typing = true
# Bytes per surface (100 MB), not lines
scrollback-limit = 100000000

# Split management
keybind = ctrl+shift+z=toggle_split_zoom
keybind = ctrl+shift+equal=equalize_splits

# Left Option as Alt (Claude Code / shell shortcuts), right Option keeps special chars
macos-option-as-alt = left

# Custom icon
macos-icon = custom
macos-custom-icon = ~/.config/ghostty/ayu-dark.png

# Shell integration
shell-integration-features = no-cursor,sudo,title,ssh-env,ssh-terminfo

# Font
font-family = Ioskeley Mono Term
font-size = 14
font-feature = zero

# Theme
theme = light:GitHub Light Default,dark:GitHub Dark Default
background-blur = 10
background-opacity = 0.95

# Low latency
window-vsync = false

# Cursor
cursor-style = block
cursor-style-blink = true

# Window
window-save-state = always
window-padding-x = 16
window-padding-y = 16
window-width = 100
window-height = 40
window-padding-balance = true
window-theme = system

# Titlebar
macos-titlebar-style = transparent
macos-titlebar-proxy-icon = hidden

# Behavior
working-directory = home
confirm-close-surface = false

# Mouse
mouse-hide-while-typing = true

# Splits
keybind = ctrl+shift+z=toggle_split_zoom
keybind = ctrl+shift+equal=equalize_splits

# Option key
macos-option-as-alt = left

# App icon
macos-icon = custom
macos-custom-icon = ~/.config/ghostty/ayu-dark.png

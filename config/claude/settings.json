{
  "env": {
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "true",
    "CLAUDE_CODE_DISABLE_GIT_INSTRUCTIONS": "true",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "true",
    "CLAUDE_CODE_ENABLE_TASKS": "true",
    "CLAUDE_CODE_NO_FLICKER": "true",
    "DISABLE_COMPACT": "false",
    "DISABLE_INSTALLATION_CHECKS": "true",
    "ENABLE_LSP_TOOL": "true",
    "ENABLE_TOOL_SEARCH": "true",
    "FORCE_AUTOUPDATE_PLUGINS": "true",
    "MAX_MCP_OUTPUT_TOKENS": "19999",
    "USE_BUILTIN_RIPGREP": "0"
  },
  "alwaysThinkingEnabled": true,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "autoCompactEnabled": false,
  "autoDreamEnabled": false,
  "autoMemoryEnabled": false,
  "disableBundledSkills": true,
  "disableClaudeAiConnectors": true,
  "enabledPlugins": {
    "cc-plugin-plugin-authoring@builtin": false,
    "gopls-lsp@claude-plugins-official": true,
    "svelte@svelte": false,
    "typescript-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "svelte": {
      "source": {
        "source": "github",
        "repo": "sveltejs/ai-tools"
      }
    }
  },
  "hooks": {
    "PreToolUse": []
  },
  "model": "opus",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "xhigh"
    },
    "claude-opus-5-5": {
      "effortLevel": "high"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "outputStyle": "default",
  "permissions": {
    "allow": [
      "Bash(mkdir:*)",
      "Bash(go:*)",
      "Bash(ls:*)",
      "Bash(git:*)",
      "Bash(mv:*)",
      "Bash(echo:*)",
      "Bash(sed:*)",
      "Bash(source:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(pkill:*)",
      "Bash(touch:*)",
      "Bash(deadcode:*)",
      "Bash(sqlite3:*)",
      "Bash(curl:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(chmod:*)",
      "Bash(lsof:*)",
      "Bash(make:*)",
      "Bash(PORT=:*)",
      "Bash(find:*)",
      "Bash(docker:*)",
      "Bash(poetry:*)",
      "Bash(python:*)",
      "Bash(python3:*)"
    ],
    "defaultMode": "auto"
  },
  "preferredNotifChannel": "auto",
  "prefersReducedMotion": true,
  "showThinkingSummaries": true,
  "showTurnDuration": true,
  "skillListingBudgetFraction": 0.05,
  "skillListingMaxDescChars": 400,
  "skipDangerousModePermissionPrompt": true,
  "spinnerTipsEnabled": false,
  "terminalProgressBarEnabled": true,
  "theme": "dark-ansi",
  "viewMode": "default"
}
